e kompletně vybaven pro vaše pohodlné bydlení. Kromě svého oblečení a osobních věcí si do vašeho nového bydlení nepotřebujete stěhovat nic dalšího. \n\nVeškeré poplatky jsou zahrnuty v ceně.","detail_done":true,"disp":"atypical","district":1,"first_seen":"2026-10-27","floor":4,"floors_total":null,"furnished":"yes","garage":null,"heating":null,"history":[["2026-10-27",108064]],"id":"bezrealitky-840634","images":["https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/840k/840634/flatiohugsdqn2tivu6dznj81.jpg","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/840k/840634/flatiobt6jnhncb3eq9lljins.jpg","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/840k/840634/flatiogb668ftgoplq3kfquu5.jpg","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/840k/840634/flatio6gq6il1jlrma7osgp3i.jpg","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/840k/840634/flatio3clt71kjq5v8dmx2owr.jpg","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/840k/840634/flatio6md5i1be44817rqfjz5.jpg","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/840k/840634/flatio9icuaqg04feicmlzydb.jpg","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/840k/840634/flatio5nrem4lka87ubuacll4.jpg","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/840k/840634/flatiodih4fleern0c6dsm7x2.jpg","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/840k/840634/flatiobl70qfbv4uq81bvbuzj.jpg","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/840k/840634/flatioa88rn88o6in6fg4douy.jpg","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/840k/840634/flatiod890on0j1poa73manm4.jpg","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/840k/840634/flatio1cmll4emknak0ib0agh.jpg","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/840k/840634/flatioge2mj0gsstt6fi