.cz/d_18/c_img_qG_A/nCR9NVflLCNT9cYsXH9lpxZ/a808.png?fl=res,1024,768,1"],"last_seen":"2026-10-27","lat":50.085298,"lift":null,"loggia":null,"lon":14.4276322,"offer":"rent","ownership":null,"parking":null,"penb":null,"pets":null,"price":36500,"price_czk":36500,"price_m2":730,"private":null,"quarter":"Nové Město","quarter_median_m2":513,"source":"sreality","source_id":"2377781324","street":"Nekázanka","terrace":null,"title":"Pronájem bytu 2+kk 50 m²","url":"https://www.sreality.cz/detail/pronajem/byt/2+kk/praha-nove-mesto-nekazanka/2377781324"},"sreality-2793078860":{"address":"Jankovcova, Praha 7, Holešovice","also_on":[],"area":53,"available_from":"2026-10-21","balcony":null,"cellar":true,"charges":null,"condition":"very_good","construction":"brick","currency":"CZK","deposit":null,"description":"Hledáte pronájem bytu v žádaných Holešovicích? Nabízíme Vám v exkluzivním zastoupení vybavený byt 1+1 o velikosti 53 m² s prostornou moderní kuchyní, velkou vestavěnou šatní skříní a sklepem v ceně nájmu.\r\nKuchyň s vlastním oknem je vybavena moderní linkou s indukční deskou, troubou, digestoří, lednicí s mrazákem a vestavěnou pračkou. V prostorné kuchyni najdete jídelní stůl s židlemi a malou spíž.\r\nObytný pokoj slouží k odpočinku i spaní. Je zařízen koženou sedačkou, konferenčními stolky, skříňkou pod TV a postelí bez matrace. Velká vestavěná šatní skříň s posuvnými dveřmi poskytuje úložný prostor, aniž byste museli pořizovat další skříně. V pokoji a části chodby jsou instalovány zvukově izolační předstěny pro omezení přenosu zvuku od sousedů. Čistá plocha místností po odečtení zvukově izolačních předstěn a příček je přibližně 45 m².\r\nV předsíni je designový dřevěný botník s věšákovým panelem. Koupelna má vanu, toaleta je samostatná. Další úložné místo nabízí sklep s držákem na kolo.\r\nVytápění zajišťuje vlastní plynové topení, ohřev vody elektrický bojler.\r\nV bytě jsou kvalitní dřevné podlahy a okna.\r\n\r\nNájemné činí 21 900 Kč měsíčně a zálohy na služby 1 700 Kč měsíčně. Celkem tedy 23 600 Kč měsíčně plus spotřeba elektřiny a plynu, které si nájemce převede na sebe. Zálohy zahrnují vodu, výtah, úklid a osvětlení společných prostor a odvoz odpadu. Vyúčtování probíhá jednou ročně. Při podpisu smlouvy se hradí vratná kauce ve výši dvou měsíčních nájmů, tedy 43 800 Kč, první měsíční nájemné a provize realitní kanceláře ve výši jednoho měsíčního nájemného.\r\nSmlouva se uzavírá na jeden rok s možností přednostního prodloužení. Byt je nekuřácký, pronajímatel preferuje nájemce bez domácích zvířat.\r\n\r\nHolešovice nabízejí pestrý výběr kaváren, restaurací a kulturních míst. V pěší vzdálenosti jsou DOX i divadlo La Fabrika, naproti domu se nachází kancelářský areál Classic 7. Tramvajová zastávka Maniny je přibližně tři minuty chůze, stanice metra C Nádraží Holešovice a10–15 minut.\r\n\r\nPronajímatel si vyhrazuje právo výběru nájemce. Tento inzerát není návrhem na uzavření smlouvy.\r\nKontaktujte nás a domluvte si prohlídku.","detail_done":true,"disp":"1+1","district":7,"first_seen":"2026-10-27","floor":2,"floors_total":7,"furnished":"yes","garage":null,"heating":null,"history":[["2026-10-27",21990]],"id":"sreality-2793078860","images":["https://d18-a.sdn.cz/d_18/c_img_qG_D/nCXhmtHPUB13CvBSmUIL1rKM/b78e.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nCXhmtHPUB13CvBQl7IL1rKs/1b78.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nCXhmtHPUB13CvBRkrIL1rLO/669e.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkBQkMFUfIL1rLq/cec1.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdk3RI9UTIL1rMK/8bb9.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkbxLFUPIL1rMl/ec9b.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nCXhmtHPUCaRYmBKBnIL1rNC/73ab.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nCXhmtHPUB6IMDDdUyIL1rNh/286d.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nCXhmtHPUD8nezBUvxIL1rOA/569c.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nCXhmtHPUCaRYmBKBQIL1rOk/b1e3.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkBQkMFUkIL1rPQ/b498.jpeg?fl=res,1024,768,1"],"last_seen":"2026-10-27","lat":50.106683,"lift":true,"loggia":null,"lon":14.454946,"offer":"rent","ownership":"personal","parking":null,"penb":"G","pets":null,"price":21990,"price_czk":21990,"price_m2":415,"private":false,"quarter":"Holešovice","quarter_median_m2":523,"source":"sreality","source_id":"2793078860","street":"Jankovcova","terrace":null,"title":"Pronájem bytu 1+1 53 m²","url":"https://www.sreality.cz/detail/pronajem/byt/1+1/praha-holesovice-jankovcova/2793078860"},"sreality-2996506700":{"address":"Jeremiášova, Praha 5, Stodůlky","also_on":[],"area":104,"available_from":null,"balcony":null,"cellar":null,"charges":null,"condition":null,"construction":null,"currency":"CZK","deposit":null,"description":null,"detail_done":false,"disp":"4+kk","district":5,"first_seen":"2026-10-27","floor":null,"floors_total":null,"furnished":null,"garage":null,"heating":null,"history":[["2026-10-27",39000]],"id":"sreality-2996506700","images":["https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdk3RI9BxYIL5YuW/948d.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nCXhmtHPUB854tBa34IL5Yu6/4aeb.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nCXhmtHPUB854tBa4KIL5Yvd/00ee.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nCXhmtHPUCaRYmBNKQIL5Yv3/0815.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nCXhmtHPUCaRYmBNKQIL5YwU/94bf.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkBcInfD6SIL5Ywz/e3ff.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nCXhmtHPUB6IMDDqkSIL5YxP/d991.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkC4TclCaNIL5Yxm/2e2b.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkDyuEmHiEIL5YyF/fb7b.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nCXhmtHPUCHypVBONAIL5Yyj/9ff4.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkB87eWDfKIL5YzB/5ffd.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkCfcGaDjiIL5Yzf/2fe8.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdk3whELXTIL5Yz7/5dbf.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkCJCefDlHIL5Y0h/96b6.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nCXhmtHPUBL8BsDiZfIL5Y06/597b.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkC4TclCW1IL5Y1b/569d.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkCJCefDlTIL5Y1x/a40a.jpeg?fl=res,1024,768,1"],"last_seen":"2026-10-27","lat":50.0440422604139,"lift":null,"loggia":null,"lon":14.3371866953272,"offer":"rent","ownership":null,"parking":null,"penb":null,"pets":null,"price":39000,"price_czk":39000,"price_m2":375,"private":null,"quarter":"Stodůlky","quarter_median_m2":438,"source":"sreality","source_id":"2996506700","street":"Jeremiášova","terrace":null,"title":"Pronájem bytu 4+kk 104 m²","url":"https://www.sreality.cz/detail/pronajem/byt/4+kk/praha-stodulky-jeremiasova/2996506700"},"sreality-3041656908":{"address":"Korunní, Praha 10, Vinohrady","also_on":[],"area":89,"available_from":"2026-10-05","balcony":true,"cellar":null,"charges":null,"condition":"very_good","construction":"brick","currency":"CZK","deposit":null,"description":"Nabízíme k dlouhodobému pronájmu výjimečně prostorný a nadstandardně vybavený byt o dispozici 2+kk o užitné ploše 89 m², který zaujme především velkorysým obytným prostorem, množstvím přirozeného světla a vysokým standardem vybavení. K hlavním přednostem nemovitosti patří nadstandartní vybavení, dostatek úložného prostoru, tři samostatné balkony s výhledem do zeleně o celkové ploše 13m², z čehož jeden slouží jako zasklená zimní zahrada, zabudovaná klimatizace, moderní kuchyň se spotřebiči prémiové značky Miele a podzemní garážové stání, které je součástí pronájmu. \r\n\r\nDominantou bytu je prostorný a mimořádně světlý obývací pokoj, který díky velkým proskleným plochám a orientaci na jihozápad nabízí příjemné množství denního světla zejména v odpoledních a večerních hodinách. Obytná část poskytuje dostatek prostoru jak pro komfortní odpočinkovou zónu, tak pro jídelní část a plynule navazuje na moderně řešenou kuchyň. Kuchyňská linka v elegantním nadčasovém provedení nabízí velkorysou pracovní plochu, dostatek úložných prostor a kvalitní vestavné spotřebiče značky Miele. Celkové řešení kuchyně podtrhuje vysoký standard bytu a zároveň zachovává maximální praktičnost pro každodenní používání.\r\n\r\nDispozici bytu tvoří prostorný obývací pokoj s otevřenou kuchyní a jídelní částí s přímým vstupem na dva balony, ložnice se vstupem na balkon, dvě samostatné toalety, koupelna a vstupní chodba. \r\n\r\nInteriér působí moderním a reprezentativním dojmem. Kombinace kvalitních materiálů, dřevěných podlah, velkých prosklených ploch, promyšleného osvětlení a nadstandardního vybavení vytváří příjemnou atmosféru a zároveň poskytuje vysokou úroveň každodenního komfortu. Díky ploše 89 m² nabízí byt na dispozici 2+kk skutečně mimořádný prostor a vzdušnost.\r\n\r\nNemovitost představuje ideální volbu pro jednotlivce nebo pár, kteří hledají prostorné, světlé a nadstandardně vybavené bydlení s velkým množstvím venkovního prostoru, moderními technologiemi a důrazem na komfort.\r\n\r\nJedná se o příjemné městské bydlení v klidné a vyhledávané části Vinohrad s výbornou dostupností do centra Prahy. Stanice metra Flora je vzdálena jen několik minut chůze, tramvajové zastávky se nacházejí přímo před domem. V bezprostředním okolí je kompletní občanská vybavenost, množství restaurací, kaváren, obchodů a služeb. Korunní dvůr nabízí moderní městské bydlení a soukromí v bezprostřední blízkosti centra Prahy. Součástí je upravený vnitroblok s vodní plochou, zelení a zatravněnými plochami s lavičkami, který vytváří příjemné prostředí pro klidné bydlení a především střežený areál s nonstop recepcí.","detail_done":true,"disp":"2+kk","district":2,"first_seen":"2026-10-27","floor":3,"floors_total":6,"furnished":"yes","garage":true,"heating":null,"history":[["2026-10-27",43000]],"id":"sreality-3041656908","images":["https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkC4TclNpOIMWk6k/c868.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nQO0xPd86Tw5RPG4pIMWk7G/9588.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nQO0xPd86TBctrNDBuIMWk7c/8d71.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkC4TclN2VIMWk72/1121.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nQO0xPd86TBgJSgD3qIMWk8Y/7863.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nQO0xPd86Tw5RPGGXIMWk8x/95ae.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nQO0xPd86Tw5RPGGXIMWlAA/30f7.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nQO0xPd86TkUyxDEZIMWlAz/f91a.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkbxLFR8CIMWlBT/6df0.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdk3whEnaVIMWlBr/f085.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkC4TclN2VIMWlCE/ad3a.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkCJCefN5SIMWlCh/473e.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdk3RI9MyeIMWlC9/d590.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkbxLFR70IMWlDa/51c8.jpeg?fl=res,1024,768,1"],"last_seen":"2026-10-27","lat":50.0753916094191,"lift":true,"loggia":null,"lon":14.4494152670957,"offer":"rent","ownership":"personal","parking":true,"penb":"C","pets":null,"price":43000,"price_czk":43000,"price_m2":483,"private":false,"quarter":"Vinohrady","quarter_median_m2":549,"source":"sreality","source_id":"3041656908","street":"Korunní","terrace":null,"title":"Pronájem bytu 2+kk 89 m²","url":"https://www.sreality.cz/detail/pronajem/byt/2+kk/praha-