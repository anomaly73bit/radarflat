/c_img_qG_D/nCXhmtHPUB854tQHNIJ8vXK/fa5b.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90"],"last_seen":"2026-10-27","lat":50.14137746775435,"lift":null,"loggia":null,"lon":14.508101696714517,"offer":"rent","ownership":null,"parking":null,"penb":null,"pets":null,"price":23000,"price_czk":23000,"price_m2":500,"private":null,"quarter":"Letňany","quarter_median_m2":424,"source":"sreality","source_id":"3365404748","street":"Krausova","terrace":null,"title":"Pronájem bytu 2+kk 46 m²","url":"https://www.sreality.cz/detail/pronajem/byt/2+kk/praha-letnany-krausova/3365404748"},"sreality-3911782476":{"address":"Kozácká, Praha 10, Vršovice","also_on":[{"price_czk":19000,"source":"realitymix","url":"https://realitymix.cz/detail/praha/praha-pronajem-zarizeneho-bytu-1-kk-30m2-po-rekonstrukci-sklep-ul-kozacka-u-parku-grebovka-8715681.html"}],"area":30,"available_from":"2026-11-01","balcony":null,"cellar":true,"charges":null,"condition":"very_good","construction":"mixed","currency":"CZK","deposit":null,"description":"Nabízíme k pronájmu krásný plně zařízený byt 1+kk po rekonstrukci o celkové rozloze 30 m² se sklepem a komorou. Byt se nachází ve zvýšeném přízemí cihlového domu s výtahem v ulici Kozácká na Praze 10 - Vršovice. Kuchyně je plně zařízena sklokeramickou varnou deskou, troubou, a lednicí s mrazničkou. V koupelně je sprchový kout a toaleta. Vedle bytu se nachází komora s pračkou a novým kondenzačním kotlem, který zajišťuje vytápění bytu. K bytu také náleží zděný sklep.\r\n\r\nDům se nachází v atraktivní, ale klidné lokalitě s vynikající občanskou vybaveností a dopravní dostupností nedaleko náměstí Míru, v těsné blízkosti Havlíčkových sadů - park Grébovka. V okolí se nachází oblíbená ulice Krymská plná barů, bister, restaurací, obchodů a kaváren. V blízkosti domu je tramvajová zastávka \"Krymská\", odkud se dostanete do 3 minut na metro \"A\" Náměstí Míru.\r\n\r\nPro další informace či prohlídku této nemovitosti nás neváhejte kontaktovat. Byt je dostupný od 1.11. k pronájmu.","detail_done":true,"disp":"1+kk","district":10,"first_seen":"2026-10-27","floor":0,"floors_total":5,"furnished":null,"garage":null,"heating":null,"history":[["2026-10-27",19000]],"id":"sreality-3911782476","images":["https://d18-a.sdn.cz/d_18/c_img_qG_A/kcKfrMAkFB3JsThO2IAAnZn/5c6d.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_A/kcKfrMAkFDvG5qOZfIAAnaL/877e.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_A/nCR9NVflLrfprJgrIAAnar/aaf9.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_A/kcKfrMAkFB3JsThO2IAAnbN/3ace.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_A/kcKfrMAkFCpZ9wNEWIAAnbr/e185.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_A/kcKfrMAkFCDh88G58IAAncO/0f71.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_A/nCR9NVflLCsdQ6LovIAAnc6/5ecf.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_A/kcKfrMAkFCHDToMg5IAAnda/408d.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_A/kcKfrMAkFMsuhOKeIAAndy/9326.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_A/kcKfrMAkFB3JsThDQIAAneP/5ede.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_A/kcKfrMAkFB3JsThO2IAAneu/76aa.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_A/nCR9NVflLnoRVNByIAAnfQ/d94e.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_A/kcKfrMAkFDbqUhwTCIAAnft/2dd0.jpeg?fl=res,1920,1080,1|wrm,/watermark/