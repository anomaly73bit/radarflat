částí vybavení), WC je samostatné. Na chodbě je umístěna šatní skříň a botník. Prostorná zasklená lodžie je přístupná z kuchyně. V bytě jsou PVC podlahy a dlažba, plastová okna se žaluziemi a bezpečnostní vstupní dveře. Vytápění je ústřední dálkové. Jedná se o příjemnou lokalitu s množstvím zeleně a výbornou dopravní dostupností. Metro, tramvajové i autobusové zastávky jsou v docházkové vzdálenosti. V okolí je kompletní občanská vybavenost – obchody, restaurace, lékárna a OC Arkády Pankrác. Měsíční poplatky 8.000 Kč vč. zálohy na elektřinu jsou uvedeny pro 3 osoby. V případě zájmu lze přenechat internet (600 Kč/měs.) a TV kanály (700 Kč/měs.). Kauce 48.000 Kč. K nastěhování od 1.11.2026.","detail_done":true,"disp":"3+1","district":4,"first_seen":"2026-10-27","floor":2,"floors_total":8,"furnished":null,"garage":null,"heating":null,"history":[["2026-10-27",24000]],"id":"realitymix-8702077","images":["https://st.realitymix.cz/i/66677944/8038072/nab_502599299_detail.jpg","https://st.realitymix.cz/i/6178326/8245301/nab_458639805_detail.jpg","https://st.realitymix.cz/i/66679173/8719375/nab_501390361_detail.jpg","https://st.realitymix.cz/i/66677139/8733333/nab_502566585_detail.jpg"],"last_seen":"2026-10-27","lat":50.048031666667,"lift":null,"loggia":true,"lon":14.438702777778,"offer":"rent","ownership":"personal","parking":null,"penb":"C","pets":null,"price":24000,"price_czk":24000,"price_m2":393,"private":false,"quarter":"Krč","quarter_median_m2":413,"source":"realitymix","source_id":"8702077","street":"Milevská","terrace":null,"title":"Pronájem bytu, 3+1, 61 m²","url":"https://realitymix.cz/detail/praha/exkluzivne-pronajem-bytu-3-1-l-61-m2-metro-milevska-praha-4-krc-8702077.html"},"realitymix-8725377":{"address":"Olgy Havlové, Praha 3","also_on":[],"area":103,"available_from":null,"balcony":null,"cellar":null,"charges":null,"condition":null,"construction":null,"currency":"CZK","deposit":null,"description":null,"detail_done":false,"disp":"2+kk","district":3,"first_seen":"