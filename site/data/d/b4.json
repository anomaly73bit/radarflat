a žádané oblasti.\n\nEnergetická náročnost budovy je ve třídě F, a proto je důležité předem uvážit očekávané náklady na energie. Datum nastěhování je plánováno od 1. října 2026.\n\nPokud Vás byt zaujal, neváhejte nám napsat nebo zavolat a rádi Vám vše ukážeme osobně.","detail_done":true,"disp":"3+kk","district":6,"first_seen":"2026-10-27","floor":81,"floors_total":null,"furnished":null,"garage":null,"heating":null,"history":[["2026-10-27",34000]],"id":"sreality-3388747852","images":["https://d18-a.sdn.cz/d_18/c_img_qF_B/k0OqwCKREBG8FDPhHtYVvI/a7c0.png?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qF_B/k0OqwCKREBG8FDPhHtYVtV/9c7d.png?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qF_B/nOdL4BtPEyD4lWfWyHtYVuG/772e.png?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qF_B/k0OqwCKREB0TcCICHtYVtU/31c0.png?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qF_B/nOdL4BtPEyDrQHrBATHtYVuu/a940.png?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qF_B/nOdL4BtPEyvOo9XAHtYWRX/b68b.png?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qF_B/nOdL4BtPEyC2Er4CTrHtYVui/4645.png?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qF_B/nOdL4BtPEyvOo9BCLHtYVvL/2ecc.png?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qF_B/k0OqwCKRDgcHsIewHtYVuU/b783.png?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qF_B/k0OqwCKRDgcHsIdbHtYVuG/dcd5.png?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qF_B/nOdL4BtPEyCi6LRDRNHtYVuG/3e5d.png?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https:/