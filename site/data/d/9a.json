8,1","https://d18-a.sdn.cz/d_18/c_img_p8_B/nPVpfd5QLLbHLY4zFwPb51/8528.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_p8_B/nPVpfd5QLLDhCZl3lFwPb6J/de26.jpeg?fl=res,1024,768,1"],"last_seen":"2026-10-27","lat":50.0550170378808,"lift":null,"loggia":null,"lon":14.4049801802088,"offer":"rent","ownership":null,"parking":null,"penb":null,"pets":null,"price":45000,"price_czk":45000,"price_m2":395,"private":null,"quarter":"Smíchov","quarter_median_m2":500,"source":"sreality","source_id":"2025481036","street":"Křížová","terrace":null,"title":"Pronájem bytu 2+kk 114 m²","url":"https://www.sreality.cz/detail/pronajem/byt/2+kk/praha-smichov-krizova/2025481036"},"sreality-2357928012":{"address":"Novomlýnská, Praha 1, Nové Město","also_on":[],"area":57,"available_from":"2026-10-01","balcony":null,"cellar":true,"charges":null,"condition":"renovated","construction":"brick","currency":"CZK","deposit":null,"description":"Zprostředkujeme Vám pronájem prostorné a částečně vybavené bytové jednotky 2+kk, o užitné ploše 57,3 m2, nacházející se ve 4.patře šestipatrového cihlového domu s výtahem, v samotném centru Prahy 1 – Nové Město, v ulici Novomlýnská. Jedná se lukrativní a velmi klidnou lokalitu nedaleko nábřeží Ludvíka Svobody a parku Lannova, který je hned v sousedství. Bytová jednotka prošla kompletní rekonstrukci. \r\n\r\nVstupem do bytu se ocitnete v předsíni (6,4 m2) s vestavěnou skříní, z které se vstupuje do všech obytných místnosti bytu. Hned naproti vstupu do bytu se nachází světlý a hlavně prostorný obývací pokoj (25,3 m2), který je propojen s kuchyňským koutem, kde je umístěna kuchyňská linka ve tvaru ,,L“, s vestavěnými spotřebiči (plynová varná deska, elektrická trouba, myčka nádobí, digestoř a lednice s mrazákem). \r\n\r\nVedle obývacího pokoje je umístěna ložnice (19,4 m2), ve které jsou umístěny tři prostorné šatní skříně s dostatkem úložného prostoru. Po pravé straně od vstupu do bytu se nachází koupelna (3,37 m2) se sprchovým koutem, prostorem na pračku, umývadlem s osvětlením a sestavou skříněk. Naproti koupelně je umístěna toaleta (0,76 m2). V předsíni, ve vestavěné skříní se nachází kondenzační plynový kotel zajišťující nejenom vytápění, ale i ohřev vody, což přináší komfort a efektivní kontrolu nad provozními náklady.  \r\n\r\nNa podlaze obývacího pokoje a ložnice je položena plovoucí laminátová podlaha, v předsíni, koupelně a toaletě je položena keramická dlažba. K bytové jednotce náleží sklep o ploše 2 m2 v podkroví domu. V bytě je možnost zavedení optického internetu a případně i internetové televize. Z obývacího pokoje a ložnice je nádherný výhled do blízkého okolí s Novomlýnskou vodárenskou věží a kostelem sv. Klimenta.  \r\n\r\nDům postupně prošel také rekonstrukci, byla provedena rekonstrukce fasády, výměna vstupních dveří včetně poštovních schránek a instalace výtahu dle normy EU. Dům je velmi klidný a udržovaný, obývaný převážně dlouhodobými vlastníky bytů, což vytváří příjemné a reprezentativní bydlení.   \r\n\r\nLokalita Prahy 1 – Nové Město, nabízí výjimečné spojení historického centra s kompletní občanskou vybaveností a dopravní dostupnosti. Jenom 3 min. pěšky se nachází zastávka tramvaje a autobusu Dlouhá třída s dostupností do 2 min. do stanice metra ,,B“ Náměstí Republiky. Náměstí Republiky s historickými skvosty jako je Obecní dům, dům U Hybernů, OD Kotva, Stará celnice, nebo nákupní centrum Palladium, jsou od domu vzdálený jenom 10 min. pěšky. Občanská vybavenost je rovněž na vynikající úrovni, v bezprostřední blízkosti, nebo v docházkové vzdálenosti, se nachází Mateřská a Základní škola, lékárna, kavárny, restaurace, obchůdky, pošta, banky, divadlo, parky, nebo nákupní centrum. \r\n\r\nV případě, že hledáte pronájem v klidné lokalitě a přitom v samotném centru Prahy, tak Vám nabídku pronájmu této bytové jednotky po rekonstrukci, vřele doporučuji. Nájem činí 28.500,- Kč/měsíčně + poplatky 1.420,- Kč + zálohové platby na elektřinu, plyn a internet, které si můžete po dohodě s majitelem převést na sebe.","detail_done":true,"disp":"2+kk","district":1,"first_seen":"2026-10-27","floor":4,"floors_total":8,"furnished":null,"garage":null,"heating":null,"history":[["2026-10-27",28500]],"id":"sreality-2357928012","images":["https://d18-a.sdn.cz/d_18/c_img_qF_C/k0OqwCKRD1EvuB3PHyewen/410a.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_C/k0OqwCKRB7OXgWCHyewfY/c128.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_C/nOdL4BtPEyDrQHrCKFHyewgD/60c8.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_C/nOdL4BtPEyCly89WIHyewgo/f818.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_C/k0OqwCKRZSJdV7HyewhP/48c5.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_C/k0OqwCKRB7OXgWGHyewh8/eb40.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_C/nOdL4BtPEyBFnmYWHHyewit/32dc.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_C/nOdL4BtPEyBFnmYV9Hyewjg/9479.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_C/nOdL4BtPEyC2Er4tbHyewlu/6336.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_C/k0OqwCKRDgcHsqRHyewmY/325b.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_C/k0OqwCKREBG8FiJHyewnD/f658.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_C/nOdL4BtPEyBFnmYWBHyewnz/36e1.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_C/nOdL4BtPEyBuWMSW7Hyewoa/054b.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_C/k0OqwCKRIhAnBq6HyewpL/d8ed.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_C/k0OqwCKREBG8FiJHyewpv/b0a2.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_C/nOdL4BtPEyBHthwBgJHyewqe/b808.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_C/nOdL4BtPEyBFnmYWAHyewrK/642c.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_C/k0OqwCKRB7OXgWCHyewrv/6285.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_C/k0OqwCKRDgcHsWqHyewsc/f2df.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_C/k0OqwCKREB0TcV3HyewtI/194d.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_C/nOdL4BtPEyC2Er4W7Hyewtt/4cba.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_C/nOdL4BtPEyBFnmYWKHyewuZ/7b16.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_C/nOdL4BtPEyBFnmYWKHyewu8/279b.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_C/k0OqwCKREB0TcWCHyewvf/31c7.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_C/nOdL4BtPEyBiPBFV8HyewwI/6449.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_C/nOdL4BtPEyBHthwBpVHyewwp/03aa.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_C/nOdL4BtPEyC2Er4lwHyewxR/fabe.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_C/nOdL4BtPEyBFnmYWDHyewyE/782d.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_C/nOdL4BtPEyCi6LRB39Hyewy6/b5e3.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_C/nOdL4BtPEyCi6LRB4THyewzu/afd7.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_C/nOdL4BtPEyBFnmYWHHyew0l/dd65.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_C/nOdL4BtPEyCly89WNHyew1a/f7aa.jpeg?fl=res,1024,768,1"],"last_seen":"2026-10-27","lat":50.092301,"lift":true,"loggia":null,"lon":14.429283,"offer":"rent","ownership":"personal","parking":null,"penb":"E","pets":null,"price":28500,"price_czk":28500,"price_m2":500,"private":false,"quarter":"Nové Město","quarter_median_m2":513,"source":"sreality","source_id":"2357928012","street":"Novomlýnská","terrace":null,"title":"Pronájem bytu 2+kk 57 m²","url":"https://www.sreality.cz/detail/pronajem/byt/2+kk/praha-nove-mesto-novomlynska/2357928012"},"sreality-3037212748":{"address":"Soukenická, Praha 1, Nové Město","also_on":[],"area":65,"available_from":"2026-09-02","balcony":true,"cellar":null,"charges":null,"condition":"very_good","construction":"brick","currency":"CZK","deposit":null,"description":"<p>Nabízíme k pronájmu zařízený designový byt 2+kk o velikosti 65 m² s balkonem o výměře 1,7 m² ve 4. NP bytového domu s výtahem. Nemovitost se nachází v samém srdci Prahy 1 – na Starém Městě, v lokalitě s kompletní občanskou vybaveností a výbornou dopravní dostupností.</p><p><br></p><p>Moderní interiér bytu tvoří vstupní chodba, vzdušný obývací pokoj s jídelním koutem, kuchyňský kout, ložnice, koupelna, samostatná toaleta a balkon. K dispozici je možnost pronájmu parkovacího místa ve vnitrobloku.</p><p><br></p><p>Kuchyňský kout je vybaven sklokeramickou varnou deskou, troubou, lednicí s mrazákem a myčkou nádobí. Koupelna nabízí vanu a toaletu. K dispozici je také pračka.</p><p><br></p><p>Bydlení v samém srdci Prahy nedaleko Václavského náměstí nabízí velké množství obchodů, restaurací a možností kulturního vyžití v bezprostřední blízkosti. V pěší dostupnosti se nachází OC Palladium, Havelské tržiště, nemocnice, lékárny, supermarkety, obchody, restaurace, kavárny a dětská hřiště. Lokalita nabízí hustou síť linek MHD (autobusy, tramvaje, vlakové nádraží a 3 stanice metra). V místě se nacházejí mateřské, základní a střední školy, vysoké školy a nedaleko také Park Lane International School. Pro volnočasové aktivity můžete využít fitness, bike park, tenisové kurty, divadla nebo se vydat do Letenských sadů, Parku Lannova, Desfourské zahrady či na Náplavku. Autem dojedete na dálnici za 8 minut a na letiště Václava Havla za 24 minut.</p><p><br></p><p><br></p><p>Poptávající klient je srozuměn s úhradou provize ve výši 1 měsíčního nájmu plus DPH.</p><p><br></p><p>Pokud si nemovitost nemůžete prohlédnout osobně, nabízíme Vám také videoprohlídku z pohodlí Vašeho domova v reálném čase přes Messenger, WhatsApp a další komunikační platformy.</p>","detail_done":true,"disp":"2+kk","district":1,"first_seen":"2026-10-27","floor":3,"floors_total":5,"furnished":"yes","garage":null,"heating":null,"history":[["2026-10-27",38000]],"id":"sreality-3037212748","images":["https://d18-a.sdn.cz/d_18/c_img_qG_D/nCXhmtHPUD8nezBVk9IL34V3/6118.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nCXhmtHPUCHypVBN0MIL34Wj/f4df.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkDyuEmGPOIL34XM/211e.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkBcInfUQIL34X6/0658.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nCXhmtHPUD8nezBWEdIL34Yl/d264.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nCXhmtHPUChHuMBPA7IL34ZN/20b9.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nCXhmtHPUBL8BsDiXjIL34Zz/1c15.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nCXhmtHPUBL8BsDhDjIL34ab/deb9.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nCXhmtHPUB854tBaUpIL34a8/e608.jpeg?fl=res,1024,768,1"],"last_seen":"2026-10-27","lat":50.0910634777129,"lift":true,"loggia":null,"lon":14.4297928917204,"offer":"rent","ownership":"personal","parking":true,"penb":"G","pets":null,"price":38000,"price_czk":38000,"price_m2":585,"private":false,"quarter":"Nové Město","quarter_median_m2":513,"source":"sreality","source_id":"3037212748","street":"Soukenická","terrace":null,"title":"Pronájem bytu 2+kk 65 m²","url":"https://www.sreality.cz/detail/pronajem/byt/2+kk/praha-nove-mesto-soukenicka/3037212748"},"sreality-3189379148":{"address":"Kostečná, Praha 1, Staré Město","also_on":[],"area":111,"available_from":null,"balcony":null,"cellar":null,"charges":null,"condition":null,"construction":null,"currency":"CZK","deposit":null,"description":null,"detail_done":false,"disp":"3+1","district":1,"first_seen":"2026-10-27","floor":null,"floors_total":null,"furnished":null,"garage":null,"heating":null,"history":[["2026-10-27",31000]],"id":"sreality-3189379148","images":["https://d18-a.sdn.cz/d_18/c_img_qG_D/kPyfG4fPEeCdpo1BY4UILt8T5/b5c5.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kPyfG4fPEeDb3WcBKkPILt8UT/d50b.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kPyfG4fPEeD7yCdDgQUILt8U6/0cb4.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kPyfG4fPEe0kCSBV90ILt8VT/698a.jpeg?fl=res,1024,768,1","htt