a. \r\n\r\nParkety, kamenná dlažba, plynový kotel, kuchyň se spotřebiči zn. Miele a Siemens, myčka, indukční varná deska, mikrovlnná trouba, videotelefon, sklep.","detail_done":true,"disp":"2+kk","district":2,"first_seen":"2026-10-27","floor":1,"floors_total":null,"furnished":"no","garage":null,"heating":null,"history":[["2026-10-27",30000]],"id":"sreality-174469196","images":["https://d18-a.sdn.cz/d_18/c_img_qG_C/nPTZ57SOdpDnYlBUKIHsebQ/e73c.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_C/kOzg0nKR97BXuvRULIHsejZ/cf55.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_C/kOzg0nKR97BYAkTUSIHserY/e41d.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_C/nPTZ57SOdpBYqLjUNIHsezD/88c2.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_C/kOzg0nKR97CjkgbUPIHse6s/5f44.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_C/kOzg0nKR97BXuvRjdIHsfEt/92de.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_C/kOzg0nKR97B6YEKURIHsfMs/7025.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_C/nPTZ57SOdpCAx7HUQIHsfUu/485c.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_C/kOzg0nKR97D5UHnUSIHsfc6/26dd.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_C/nPTZ57SOdpCnhRaURIHsfk0/c0fb.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90"],"last_seen":"2026-10-27","lat":50.0657023071169,"lift":true,"loggia":null,"lon":14.4282427799956,"offer":"rent","ownership":"personal","parking":null,"penb":"D","pets":null,"price":30000,"price_czk":30000,"price_m2":600,"private":false,"qu