k0OqwCKREBG8FGncHt7kYM/f753.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qF_B/k0OqwCKRZSJdCcnHt7kZC/51ee.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qF_B/nOdL4BtPEyvOo9BDEHt7kYM/9f62.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qF_B/k0OqwCKRDbeZQB3zHt7kY1/313f.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qF_B/nOdL4BtPEyCly89BVIHt7kYK/f19a.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90"],"last_seen":"2026-10-27","lat":50.049716839079885,"lift":null,"loggia":null,"lon":14.450302828744448,"offer":"rent","ownership":null,"parking":null,"penb":null,"pets":null,"price":35000,"price_czk":35000,"price_m2":422,"private":null,"quarter":"Michle","quarter_median_m2":470,"source":"sreality","source_id":"2593337420","street":"Baarova","terrace":null,"title":"Pronájem bytu 3+kk 83 m²","url":"https://www.sreality.cz/detail/pronajem/byt/3+kk/praha-michle-baarova/2593337420"},"sreality-3535081548":{"address":"Kbelská, Praha 9, Hloubětín","also_on":[{"price_czk":20000,"source":"bezrealitky","url":"https://www.bezrealitky.cz/nemovitosti-byty-domy/1079927-nabidka-pronajem-bytu-kbelska-praha"}],"area":30,"available_from":"2026-12-15","balcony":true,"cellar":true,"charges":4535,"condition":"very_good","construction":"brick","currency":"CZK","deposit":40000,"description":"Nabízíme k dlouhodobému pronájmu od přímého vlastníka (neplatíte žádnou provizi) nový byt o dispozici 1+kk, nacházející se v nově vybudovaném komplexu Rezidence Hloubětín v pohodlné lokalitě, Praha 9 - Hloubětín.\n\nNový byt 1+kk o celkové výměře 31 m2 se nachází v 2. NP a náleží k němu balkon a sklep. Jednotka disponuje prostorným obývacím pokojem, vybaveným novou značkovou nadstandardní vestavěnou kuchyňskou linkou Hanák včetně kvalitních spotřebičů. Koupelna má sprchový kout, pračku a je spojená s WC.\n\n\nPředsíň nabízí instalovanou šatní skříň (dostatek úložných prostor). V bytě je položena plovoucí laminátová podlaha, předností jsou též kvalitní plastová okna a bezpečnostní dveře. Byt se pronajímá částečně zařízen.\n\n\nV blízkosti projektu se nachází tramvajová zastávka Nový Hloubětín. Veškerou občanskou vybavenost najdete hned v okolí (docházkové vzdálenosti) bytového komplexu – poliklinika, rozmanitá nabídka obchodů, školy a školky, Hloubětínský zámek s parkem, památkově chráněný viadukt u Hořejšího rybníka, Kejřův mlýn, vrch Smetanka, Křižovnický dvůr a mnohé jiné.\n\n \n\nO správu a technický servis této nemovitosti se stará zkušený tým VESSAN Facility. Za pronájem a správu neplatíte žádnou provizi. Svým nájemníkům dlouhá léta garantujeme bezstarostný pronájem po celou dobu trvání smlouvy a technickou podporu (přehled o platbách, transparentní a férové vyúčtování služeb, prodloužení smlouvy, zajištění oprav).\n\nByt je vhodný pro toho, kdo hledá klidné a tiché bydlení v centru města, kde je vše blízko a na dosah. Pro více informací nás neváhejte kontaktovat.","detail_done":true,"disp":"1+kk","district":9,"first_seen":"2026-10-27","floor":1,"floors_total":null,"furnished":"partly","garage":null,"heating":null,"history":[["2026-10-27",20000]],"id":"sreality-3535081548","images":["https://d18-a.sdn.cz/d_18/c_img_qG_C/nCR9NVflLwO7jBAkvIHoXWY/988f.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_C/kcKfrMAkFnIwlBG4BIHoXgp/5c12.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_C/kcKfrMAkFDbqUhHLkIHoXnz/bd4c.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_C/nCR9NVflLCNT9cdHFIHoYdy/c8b0.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90"],"last_seen":"2026-10-27","lat":50.10557470851269,"lift":true,"loggia":null,"lon":14.532147460840484