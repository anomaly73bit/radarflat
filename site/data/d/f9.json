terrace":null,"title":"Pronájem bytu, 2+kk, 67 m²","url":"https://realitymix.cz/detail/praha/pronajem-bytu-2-kk-t-42-m-ul-u-cikanky-praha-13-stodulky-8711091.html"},"realitymix-8732391":{"address":"Divíškové, Praha 5, Hlubočepy","also_on":[{"price_czk":23500,"source":"sreality","url":"https://www.sreality.cz/detail/pronajem/byt/2+kk/praha-hlubocepy-diviskove/1515524172"},{"price_czk":22900,"source":"sreality","url":"https://www.sreality.cz/detail/pronajem/byt/2+kk/praha-hlubocepy-diviskove/2437808204"}],"area":50,"available_from":null,"balcony":true,"cellar":null,"charges":null,"condition":"new","construction":"brick","currency":"CZK","deposit":null,"description":"Popis nemovitosti Pronájem bytu 2+kk, 53 m², s balkonem a garážovým stáním – Divíškové, Praha 5 – Barrandov Nabízím k dlouhodobému pronájmu příjemný nový byt 2+kk s balkonem v rezidenčním projektu Nad skálou Barrandov, v ulici Divíškové v Praze 5 – Hlubočepích. Součástí nájemného je také garážové stání přímo v domě. Byt je volný ihned. Dispozici tvoří obývací pokoj s kuchyňským koutem o výměře 22,29 m², samostatná ložnice 13,24 m², předsíň 5,99 m², praktická komora přímo v bytě 3,18 m² a koupelna s vanou a WC 4,61 m². K bytu náleží balkon o velikosti 2,46 m², který nabízí prostor pro posezení a odpočinek. Vnitřní užitná plocha bytu činí 49,31 m², celková podlahová plocha dle plánku je 52,90 m². Byt se pronajímá nezařízený, s vybavenou kuchyňskou linkou. Velká okna přivádějí do interiéru dostatek denního světla a venkovní elektrické žaluzie umožňují regulovat zastínění i soukromí. Barrandov nabízí pohodlné zázemí pro každodenní život – obchody, restaurace, sportoviště i služby. V blízkosti se nachází tramvajová zastávka Poliklinika Barrandov se spojením na Smíchov a do centra Prahy. Výhodou je také blízkost Prokopského a Dalejského údolí, kam můžete vyrazit na procházku, běh nebo na kolo. Cena a podmínky pronájmu: • Nájemné včetně garážového stání: 22 900 Kč měsíčně • Zálohy na služby: 3 500 Kč měsíčně • Celkem: 26 400 Kč měsíčně + elektřina • Elektřina se převádí na nájemce. • Kauce: 45 800 Kč, tedy dva měsíční nájmy. • Provize RK: jeden měsíční nájem plus DPH. • Nájemní smlouva na dobu minimálně jednoho roku. • K nastěhování ihned. Pro více informací a domluvení prohlídky mě kontaktujte. Ráda vám byt osobně představím. Pronajímající si vyhrazuje právo vybrat nájemce na základě jím zvolených kritérií.","detail_done":true,"disp":"2+kk","district":5,"first_seen":"2026-10-27","floor":3,"floors_total":7,"furnished":null,"garage":null,"heating":null,"history":[["2026-10-27",22900]],"id":"realitymix-8732391","images":["https://st.realitymix.cz/i/66677944/7704759/nab_502268515_detail.jpg","https://st.realitymix.cz/i/66677944/7882911/nab_500796915_detail.jpg","https://st.realitymix.cz/i/6847448/8454493/nab_487602775_detail.jpg","https://st.realitymix.cz/i/66670288/8632759/nab_498958847_detail.jpg"],"last_seen":"2026-10-27","lat":50.031075,"lift":null,"loggia":null,"lon":14.376625,"offer":"rent","ownership":"personal","parking":null,"penb":"B","pets":null,"price":22900,"price_czk":22900,"price_m2":458,"private":false,"quarter":"Hlubočepy","quarter_median_m2":438,"source":"realitymix","source_id":"8732391","street":"Divíškové","terrace":null,"title":"Pronájem bytu, 2+kk, 53 m²","url":"https://realitymix.cz/detail/praha/pronajem-bytu-2-kk-53-m-s-balkonem-a-garazovym-stanim-diviskove-praha-5-barrandov-8732391.html"},"sreality-1188737100":{"address":"Honzíkova, Praha 10, Dolní Měcholupy","also_on":[],"area":78,"available_from":null,"balcony":null,"cellar":null,"charges":null,"condition":null,"construction":null,"currency":"CZK","deposit":null,"description":null,"detail_done":false,"disp":"3+kk","district":10,"first_seen":"2026-10-27","floor":null,"floors_total":null,"furnished":null,"garage":null,"heating":null,"history":[["2026-10-27",35000]],"id":"sreality-1188737100","images":["https://d18-a.sdn.cz/d_18/c_img_qF_C/k0OqwCKREBG8FZaHzE2LF/0557.jpeg?fl=res,1024,768,1","https://d18