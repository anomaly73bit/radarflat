osit":null,"description":null,"detail_done":false,"disp":"3+kk","district":4,"first_seen":"2026-10-27","floor":null,"floors_total":null,"furnished":null,"garage":null,"heating":null,"history":[["2026-10-27",30000]],"id":"realitymix-8673215","images":["https://st.realitymix.cz/i/66669194/8673215/nab_502505043_detail.jpg","https://st.realitymix.cz/i/66669194/8673215/nab_502505045_detail.jpg","https://st.realitymix.cz/i/66669194/8673215/nab_502505047_detail.jpg","https://st.realitymix.cz/i/66669194/8673215/nab_502505049_detail.jpg"],"last_seen":"2026-10-27","lat":null,"lift":null,"loggia":null,"lon":null,"offer":"rent","ownership":null,"parking":null,"penb":null,"pets":null,"price":30000,"price_czk":30000,"price_m2":240,"private":null,"quarter":"Michle","quarter_median_m2":470,"source":"realitymix","source_id":"8673215","street":"Elektrárenská","terrace":null,"title":"Pronájem bytu, 3+kk, 125 m²","url":"https://realitymix.cz/detail/praha/pronajem-bytu-3-kk-125-m-dve-terasy-garazove-stani-praha-10-michle-8673215.html"},"realitymix-8725075":{"address":"Společná, Praha 8, Libeň","also_on":[{"price_czk":22500,"source":"sreality","url":"https://www.sreality.cz/detail/pronajem/byt/2+kk/praha-liben-spolecna/3461812300"}],"area":46,"available_from":null,"balcony":null,"cellar":true,"charges":null,"condition":"very_good","construction":"mixed","currency":"CZK","deposit":null,"description":"Popis nemovitosti Pronájem zařízeného bytu 2+kk (46 m2) s předzahrádkou, celkem 60 m2, Praha 8 - Libeň, ul. Společná Realitní společnost Gepard Vám nabízí k dlouhodobému pronájmu útulný a prakticky řešený byt 2+kk s předzahrádkou o celkové výměře 60 m2. Samotný byt má 46 m2 a nachází se v přízemí bytového domu dokončeného v prosinci roku 2000. Byt má privátní uzavřenou vstupní chodbu společnou ještě s jedním bytem, kde se nachází vstupní dveře do bytu. Hlavní část tvoří světlý obývací pokoj s kuchyňskou linkou a jídelním sezením a vstupem na předzahrádku orientovanou do zeleně a klidové části. Ložnice je vybavená vestavnými skříněmi a dvoulůžkem. Z chodby je vstup do koupelny s toaletou, vanou a umyvadlem a dále do samostatné komory. Na podlahách obytných místností a chodby jsou kvalitní koberce, které jsou velmi příjemné a pohodlné na chůzi. Jsou zde také nainstalované venkovní předokenní rolety, v bytě je zabezpečovací systém a areál objektu je hlídaný. Nájemné činí 22.500 Kč měsíčně, měsíční zúčtovatelné zálohy na služby 3.000 Kč, elektřina se převádí na nájemníka. Kauce ve výši dvou měsíčních nájmů (45.000 Kč) a provize RK ve výši měsíčního nájmu vč. služeb (25.500 Kč). K bytu je možné si pronajmout uzavřené a prostorné parkovací stání (20 m2) a sklep (4 m2) v suterénu domu za celkovou cenu 2.500 Kč/měsíc. Velmi klidná lokalita s perfektní dostupností MHD (autobus 200 m, tramvaj 300 m, metro 400 m), veškerá občanská vybavenost v docházkové vzdálenosti. Byt je volný a ihned k dispozici.","detail_done":true,"disp":"2+kk","district":8,"first_seen":"2026-10-27","floor":1,"floors_total":5,"furnished":null,"garage":null,"heating":null,"history":[["2026-10-27",22500]],"id":"realitymix-8725075","images":["https://st.realitymix.cz/i/66677944/7539720/nab_501303563_detail.jpg","https://st.realitymix.cz/i/66677944/7734152/nab_500626275_detail.jpg","https://st.realitymix.cz/i/66677944/8010947/nab_501731909_detail.jpg","https://st.realitymix.cz/i/66670241/7938229/nab_489465453_detail.jpg"],"last_seen":"2026-10-27","lat":50.124522222222,"lift":null,"loggia":null,"lon":14.476538888889,"offer":"rent","ownership":"personal","parking":null,"penb":"G","pets":null,"price":22500,"price_czk":22500,"price_m2":489,"private":false,"quarter":"Libeň","quarter_median_m2":457,"source":"realitymix","source_id":"8725075","street":"Společná","terrace":true,"title":"Pronájem bytu, 2+kk, 60 m²","url":"https://realitymix.cz/detail/praha/pronajem-zarizeneho-bytu-2-kk-46-m2-s-predzahradkou-celkem-60-m2-praha-8-liben-ul-spolecna-8725075.html"},"realitymix-8727495":{"address":"Bubenská, P