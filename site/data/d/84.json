ivate":false,"quarter":"Braník","quarter_median_m2":433,"source":"sreality","source_id":"1252528204","street":"Nad křížkem","terrace":null,"title":"Pronájem bytu 2+kk 40 m²","url":"https://www.sreality.cz/detail/pronajem/byt/2+kk/praha-branik-nad-krizkem/1252528204"},"sreality-3182870604":{"address":"Žatecká, Praha 1, Josefov","also_on":[{"price_czk":72000,"source":"realitymix","url":"https://realitymix.cz/detail/praha/majestatni-mezonet-5-1-v-secesnim-dome-na-josefove-8680749.html"}],"area":195,"available_from":"2026-08-28","balcony":null,"cellar":null,"charges":null,"condition":"very_good","construction":"brick","currency":"CZK","deposit":null,"description":"Majestátní mezonet (je možné využít i na kanceláře) se nachází v 6. a 7. nadzemním podlaží secesního domu s výtahem na pražském Josefově. Dům i byt prošly nákladnou rekonstrukcí, při které se dbalo na zachování původních prvků, zejména pak špaletových oken a dubových parket. Praktické členění na 3 samostatné ložnice, prostorný obývací pokoj s kuchyní, dvě koupelny se sprchovým koutem a vanou a galerii. Součástí pronájmu je kombinovaná pračka se sušičkou. Na podestě ve vyšším poschodí je krb; podlahová krytina v bytě: dubové parkety.\r\n\r\nPro nájemce je k dispozici domovník v pracovní dny od 8:00 do 16:00.\r\n\r\nByt se pronajímá nezařízený; je zde možnost pronájmu s vybavením za vyšší nájemné. \r\n\r\n Poplatky 5 000 Kč = záloha na služby, která se vyúčtovává a přeplatky se vrací + 7 500 Kč = záloha na spotřebu energií v bytě (voda, elektřina, topení).","detail_done":true,"disp":"5+1","district":1,"first_seen":"2026-10-27","floor":5,"floors_total":null,"furnished":"no","garage":null,"heating":null,"history":[["2026-10-27",72000]],"id":"sreality-3182870604","images":["https://d18-a.sdn.cz/d_18/c_img_qF_A/k0OqwCKRB7OXgrKHraRhS/d0e5.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qF_A/nOdL4BtPEyBHthwBRKHraRhx/ef7f.jpeg?fl=res,1920,1080,1|wrm,/watermark/sre