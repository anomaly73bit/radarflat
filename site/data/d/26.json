1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kPyfG4fPEeC2TMrBORwILseFL/34b8.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nCXhmtHPUChHuMBIAsILseF4/197c.jpeg?fl=res,1024,768,1"],"last_seen":"2026-10-27","lat":50.0861005155117,"lift":null,"loggia":null,"lon":14.4825156796707,"offer":"rent","ownership":null,"parking":null,"penb":null,"pets":null,"price":18900,"price_czk":18900,"price_m2":485,"private":null,"quarter":"Žižkov","quarter_median_m2":489,"source":"sreality","source_id":"661708876","street":"Na Viktorce","terrace":null,"title":"Pronájem bytu 1+kk 39 m²","url":"https://www.sreality.cz/detail/pronajem/byt/1+kk/praha-zizkov-na-viktorce/661708876"},"sreality-708411468":{"address":"Pod Ateliéry, Praha 5, Hlubočepy","also_on":[{"price_czk":40000,"source":"realitymix","url":"https://realitymix.cz/detail/praha/pronajem-bytu-3-kk-103-m-pod-ateliery-praha-barrandov-8607077.html"}],"area":103,"available_from":"2026-09-01","balcony":true,"cellar":true,"charges":null,"condition":"very_good","construction":"mixed","currency":"CZK","deposit":null,"description":"K dlouhodobému pronájmu nabízíme prostorný a světlý byt s dispozicí 3+kk s užitnou plochou 103 m² a balkonem (2,5 m²), situovaný ve 2. nadzemním podlaží v atraktivní lokalitě Praha – Pod Ateliéry. Byt zaujme především velkorysým prostorem, množstvím přirozeného světla a kvalitními materiály. Dominantou interiéru je prostorný obývací pokoj s designovým krbem a velkoformátovými okny, který je propojený s moderní kuchyňskou a jídelní částí.\r\n\r\nModerní kuchyňská linka disponuje ostrůvkem a je plně vybavena vestavěnými spotřebiči (trouba, mikrovlnná trouba, varná deska, myčka nádobí, lednice s mrazákem). Z obytné části je vstup na balkon orientovaný do klidného prostředí. Dispozice dále nabízí dvě samostatné ložnice s vestavěnými skříněmi (jedna s pracovním koutem), nadstandardní koupelnu s vanou a dvojitým umyvadlem, samostatnou toaletu a technickou místnost s pračkou. Jedinečný charakter bytu dodávají dřevěné podlahy.\r\n\r\nLokalita Pod Ateliéry nabízí klidné rezidenční bydlení s výbornou dostupností MHD do centra města a kompletní občanskou vybaveností v okolí. V současné době bude byt procházet rekonstrukcí (výměna podlah, modernizace úložných prostor) a bude připraven k nastěhování od 1. 9. 2026.\r\n\r\nMěsíční poplatky činí přibližně 6 000 Kč + přepis elektřiny a plynu na nájemce. Vratná kauce je stanovená ve výši dvou měsíčních nájmů, provize RK činí jeden měsíční nájem + DPH. Možnost pronájmu parkovacího stání za 2 000 Kč/měsíc. Pro více informací nebo domluvení prohlídky nás neváhejte kontaktovat.","detail_done":true,"disp":"3+kk","district":5,"first_seen":"2026-10-27","floor":2,"floors_total":null,"furnished":"yes","garage":null,"heating":null,"history":[["2026-10-27",40000]],"id":"sreality-708411468","images":["https://d18-a.sdn.cz/d_18/c_img_qF_B/nOdL4BtPEyCly89C9cHtNYyL/6ae5.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_B/nOdL4BtPEyC2Er4DzbHtNYyu/f4f1.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_B/nOdL4BtPEyBHthwBeSHtNYzR/533c.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_B/nOdL4BtPEyvOo9WuHtNYzz/da10.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_B/nOdL4BtPEyvOo9BBlHtNY0X/c5f9.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_B/nOdL4BtPEyCly89C0UHtNY07/d91a.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_B/k0OqwCKRD1EvuEGVHtNY1c/4081.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_B/k0OqwCKRDgcHsHBvHtNY2J/fbfd.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_B/k0OqwCKRZSJdEEXHtNY20/a90f.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_B/nOdL4BtPEyCly89C0YHtNY3j/68d3.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_B/k0OqwCKRDbeZQDG7HtNY4I/c0f9.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_B/k0OqwCKRIhAnCDEHtNY4y/514c.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_B/nOdL4BtPEyBFnmYBPfHtNY5Z/965f.jpeg?fl=re