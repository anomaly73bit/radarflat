n_m2":489,"source":"sreality","source_id":"4149723212","street":"Roháčova","terrace":null,"title":"Pronájem bytu 2+1 50 m²","url":"https://www.sreality.cz/detail/pronajem/byt/2+1/praha-zizkov-rohacova/4149723212"},"sreality-4279578700":{"address":"Jeřabinová, Praha 5, Smíchov","also_on":[],"area":50,"available_from":"2026-10-26","balcony":true,"cellar":true,"charges":null,"condition":"very_good","construction":"mixed","currency":"CZK","deposit":null,"description":"Nabízíme k pronájmu nezařízený byt s parkováním a prosluněným balkónem orientovaným do zeleně, situovaný v 1. patře viladomu v rezidenčním komplexu Souhvězdí Homolka, který je zasazen do jižního zeleného svahu na rozhraní Prahy 5 a 6. Rezidence se nachází v naprosto klidném prostředí plném zeleně, v místě s výbornou dostupností do centra a s plnou občanskou vybaveností v pohodlném dosahu vč. několika venkovních sportovišť, cca 5 minut chůze je vzdálena nemocnice Na Homolce. V těsné blízkosti se rozkládá přírodní památka Skalka i park Ladronka s oblíbenou dráhou pro inline brusle. Dopravní spojení zajišťují autobusy, v docházkové vzdálenosti je i tramvajová zastávka.  \r\n\r\nInteriér bytu tvoří obývací pokoj s plně vybaveným kuchyňským koutem, dále 1 ložnice, koupelna (vana se sprchovou zástěnou), samostatná toaleta a předsíň. Z obývacího pokoje vede vstup na slunný balkón.\r\n\r\nNové prémiové třívrstvé dřevěné podlahy zn. Scheucher, okna Vekra s dřevěnými rámy a trojskly, centrální vytápění, kuchyňská linka zn. Hanák, spotřebiče zn. Miele, keramická pracovní deska, myčka, indukční varná deska, sklep. V ceně je zahrnuta uzavíratelná garáž v suterénu, před garáží je možné parkovat další auto.","detail_done":true,"disp":"2+kk","district":5,"first_seen":"2026-10-27","floor":1,"floors_total":null,"furnished":"no","garage":true,"heating":null,"history":[["2026-10-27",28000]],"id":"sreality-4279578700","images":["https://d18-a.sdn.cz/d_18/c_img_qG_D/nCXhmtHPUBiA4qBHcYILsLuW/c68f.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_D/kPyfG4fPEeC2TMrBORbILsL2I/2099.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_D/kPyfG4fPEeD7yCdDgRbILsL9v/e39f.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_D/nCXhmtHPUChHuMBIAsILsMHK/6e4a.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_D/kPyfG4fPEeC2yv3BZDfILsMOu/3140.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_D/kPyfG4fPEeDb3WcBKbDILsMW0/564c.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_D/kPyfG4fPEeushhBLLLILsMef/771b.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_D/kPyfG4fPEeC2yv3BZDfILsMml/731d.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_D/nCXhmtHPUD9QxwBFDKILsMu2/6958.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_D/kPyfG4fPEeBPfwtBXrJILsM2o/dc39.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90"],"last_seen":"2026-10-27","lat":50.0741947758128,"lift":true,"loggia":null,"lon":14.3590747424843,"offer":"rent","ownership":"personal","parking":true,"penb":"C","pets":null,"price":28000,"price_czk":28000,"price_m2":560,"private":false,"quarter":"Smíchov","quarter_median_m2":500,"source":"sreality","source_id":"4279578700","street":"Jeřabinová","terrace":null,"title":"Pronájem bytu 2+kk 50 m²","url":"https://www.sreality.cz/detail/pronajem/byt/2+kk/praha-smichov-jerabinova/4279578700"},"sreality-47252300":{"address":"Kollárova, Praha 8, Karlín","also_on":[],"area":65,"available_from":null,"balcony":null,"cellar":null,"charges":null,"condition":null,"construction":null,"currency":"CZK","deposit"