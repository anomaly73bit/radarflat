-a.sdn.cz/d_18/c_img_qG_C/nCR9NVflLCNT9cP6SIFoMuo/bbdf.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90"],"last_seen":"2026-10-27","lat":50.0388244692853,"lift":null,"loggia":null,"lon":14.3896791483685,"offer":"rent","ownership":null,"parking":null,"penb":null,"pets":null,"price":28000,"price_czk":28000,"price_m2":757,"private":null,"quarter":"Hlubočepy","quarter_median_m2":438,"source":"sreality","source_id":"2018390092","street":"Slivenecká","terrace":null,"title":"Pronájem bytu 2+kk 37 m²","url":"https://www.sreality.cz/detail/pronajem/byt/2+kk/praha-hlubocepy-slivenecka/2018390092"},"sreality-2151219276":{"address":"Mattioliho, Praha 10, Záběhlice","also_on":[{"price_czk":22990,"source":"realitymix","url":"https://realitymix.cz/detail/praha/pronajem-bytu-2-kk-54-m-8729991.html"}],"area":67,"available_from":"2026-10-22","balcony":true,"cellar":true,"charges":null,"condition":"new","construction":"brick","currency":"CZK","deposit":null,"description":"Nově uvolněno! \r\n\t‌\r\nNabízíme k pronájmu krásný, skvěle dispozičně vyřešený a světlý byt v novostavbě v Praze 10 – Záběhlice, ul. Mattioliho.\r\n\t‌\r\n Absolutní klid, množství zeleně, nádherný výhled a výborná dostupnost MHD (9 minut tramvají nebo 12 minut busem na |M| Strašnická). \r\n\t‌\r\nV blízkosti lesopark Hostivař.\r\n\t‌\r\nByt 2+kk (54,3 m2) s rohovým balkonem (8,2 m2), terasou (4,4 m2) a komorou na patře (3,2 m2). 4. patro z 6 s výtahem. Možnost garážového stání + 1.500,-Kč/měs.\r\n\t‌\r\nŠatní skříň v ložnici. Kuchyňská linka s vestavěnou varnou deskou, horkovzdušnou troubou, myčkou, lednicí s mrazákem a digestoří s odtahem. \r\n\t‌\r\nV obývacím pokoji troje francouzská okna se vstupem na balkon i terasu. Kuchyňský kout s oknem! Orientace oken na západ a sever. Velmi prostorná koupelna s vanou, WC a pračkou. Na podlahách dlažba a plovoucí. Vytápění dálkové - měřiče na tělesech. Stropy vysoké 264 cm. \r\n\t‌\r\nSpolečný prostor (kočárkárna x kolárna). \r\n\t‌\r\nInternet (optický kabel – 2 Gb/s) zaveden do bytu. Bezpečnostní dveře. \r\n\t‌\r\nKrásné okolí s plnou občanskou vybaveností a sportovního vyžití. Cyklostezka A23, OC Hostivař, pizzerie, restaurace, dětská hřiště…\r\n\t‌\r\nVíce fotografií (45) na stránkách blanikreality pod ID: 26231.\r\n\t‌\r\nK nastěhování ihned. Cena 23.000,-Kč + služby 3.800,-Kč + elektřina cca 1.000,-Kč. Garážové stání + 1.500,-Kč/měs. Kauce 27.000,-Kč, provize pro RK 23.000,-Kč + 21% DPH. \r\n\t‌\r\nTřída energetické náročnosti (PENB) - B - velmi úsporná.","detail_done":true,"disp":"2+kk","district":10,"first_seen":"2026-10-27","floor":4,"floors_total":7,"furnished":null,"garage":null,"heating":null,"history":[["2026-10-27",22990]],"id":"sreality-2151219276","images":["https://d18-a.sdn.cz/d_18/c_img_qG_C/kPyfG4fPEeD7yCdGS8IJCjAi/2c1f.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_C/kPyfG4fPEeD7yCdUNIJCjA3/8684.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_C/kPyfG4fPEeDb3WcBu4IJCjBS/584a.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_C/kPyfG4fPEeushhB7jIJCjBp/6378.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_C/kPyfG4fPEeBPfwtBCoIJCjCY/f406.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_C/ncz4PZ5CZD0oEb3UIJCjC3/946b.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_C/ncz4PZ5CZBHbOmBSdIJCjDV/6ae5.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_C/ncz4PZ5CZBHbOmBObIJCjDr/6395.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_C/kPyfG4fPEe0kCSBPjIJCjEG/e74d.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.