loha nabízí jedno z nejmodernějších a nejkomfortnějších bydlení v Praze a je určen k okamžitému nastěhování.","detail_done":false,"disp":"1+kk","district":9,"first_seen":"2026-10-27","floor":2,"floors_total":6,"furnished":null,"garage":null,"heating":null,"history":[["2026-10-27",19900]],"id":"realitymix-8599893","images":["https://st.realitymix.cz/i/66677944/7812475/nab_500717509_detail.jpg","https://st.realitymix.cz/i/66673475/7937954/nab_502601047_detail.jpg","https://st.realitymix.cz/i/66677944/7955800/nab_502353757_detail.jpg","https://st.realitymix.cz/i/66677944/8187843/nab_501934213_detail.jpg"],"last_seen":"2026-10-27","lat":50.102302777778,"lift":null,"loggia":null,"lon":14.507966666667,"offer":"rent","ownership":"personal","parking":null,"penb":"B","pets":null,"price":19900,"price_czk":19900,"price_m2":569,"private":false,"quarter":"Vysočany","quarter_median_m2":464,"source":"realitymix","source_id":"8599893","street":"Poděbradská","terrace":null,"title":"Pronájem bytu, 1+kk, 35 m²","url":"https://realitymix.cz/detail/praha/pronajem-bytu-1-kk-podebradska-vysocany-19900-kc-mes-35-m2-8599893.html"},"sreality-1050944076":{"address":"Soukenická, Praha 1, Nové Město","also_on":[],"area":115,"available_from":null,"balcony":null,"cellar":null,"charges":null,"condition":null,"construction":null,"currency":"CZK","deposit":null,"description":null,"detail_done":false,"disp":"3+kk","district":1,"first_seen":"2026-10-27","floor":null,"floors_total":null,"furnished":null,"garage":null,"heating":null,"history":[["2026-10-27",60000]],"id":"sreality-1050944076","images":["https://d18-a.sdn.cz/d_18/c_img_oW_A/kObgaqJNMnB0llrfTCP60PA/5c79.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_oW_A/nO1SBfAluiD9J7zfYCP60Pb/9235.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_oW_A/nO1SBfAluiDhBr0eCCP60P3/8ae7.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg