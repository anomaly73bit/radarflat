platky (elektřina, teplo, voda, služby): 9 000 Kč\r\nKauce : 75.600 Kč\r\n\r\nK bytu je možné si  pronajmout parkovací stání za 2.680 Kč.\r\n\r\nDatum nastěhování možné od 16.11.2026\r\n\r\nNeplatíte provizi. Pro bližší informace nebo prohlídku nás neváhejte kontaktovat.","detail_done":true,"disp":"3+kk","district":5,"first_seen":"2026-10-27","floor":1,"floors_total":8,"furnished":"yes","garage":null,"heating":null,"history":[["2026-10-27",37800]],"id":"sreality-2441068620","images":["https://d18-a.sdn.cz/d_18/c_img_qF_D/nOdL4BtPEyBiPBF9NH2belu/0155.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qF_D/nOdL4BtPEyC2Er4VWH2bemQ/78bb.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qF_D/nOdL4BtPEyBuWMSVWH2benA/89cf.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qF_D/nOdL4BtPEyBuWMSVOH2ben3/7396.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qF_D/nOdL4BtPEyBHthw8VH2beo4/8258.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qF_D/k0OqwCKRZSJdVQH2bepp/2a99.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qF_D/k0OqwCKRDbeZQDR5H2beqs/1950.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qF_D/nOdL4BtPEyBuWMSVRH2bero/7171.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qF_D/k0OqwCKRD1EvuvEH2besg/678f.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qF_D/nOdL4BtPEyD4lWfnCH2betH/7b5b.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qF_D/nOdL4BtPEyBiPBFVSH2bet7/77b4.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90"