odní centrum, obchody, bary a restaurace, služby, divadla, galerie.\n\nByt je kompletně vybaven pro vaše pohodlné bydlení.\nVšechny poplatky jsou zahrnuty v ceně.","detail_done":true,"disp":"atypical","district":1,"first_seen":"2026-10-27","floor":3,"floors_total":null,"furnished":"yes","garage":null,"heating":null,"history":[["2026-10-27",73483]],"id":"bezrealitky-831140","images":["https://api.bezrealitky.cz/media/cache/record_main_placeholder/public/img/placeholders/default_photo_main.png","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/831k/831140/flatiokp2sb8ljqokv899hywi.jpg","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/831k/831140/flatiomle85f6pskgu6koo9s8.jpg","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/831k/831140/flatio3rmmbpognvib1hgivvm.jpg","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/831k/831140/flatioms627qcddpmi2oyvcmu.jpg","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/831k/831140/flatio9201qmi1b1co7m6wrzo.jpg","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/831k/831140/flatiog8j7n6ri6tl1dqsdeuc.jpg","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/831k/831140/flatio3ehfemu15pv45ghxhux.jpg","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/831k/831140/flatio0qqnu28fm8ao0bvi4v6.jpg","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/831k/831140/flatioa1gutpjhc19b8ot7i71.jpg","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/831k/831140/flatioa5ig1fo3ot1beymlifm.jpg","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/831k/831140/flationg00ooj2jbmf0if0dvd.jpg"],"last_seen":"2026-10-27","lat":50.0822886,"lift":true,"loggia":null,"lon":14.4155231,"offer":"rent","ownership":null,"parking":null,"penb":null,"pets":null,"price":73483,"price_czk":73483,"price_m2":919,"private":true,"quarter":"Staré Město","quar