:[{"price_czk":90000,"source":"realitymix","url":"https://realitymix.cz/detail/praha/byt-4-1-ve-funkcionalisticke-vile-se-slavnou-historii-8716239.html"},{"price_czk":90000,"source":"realitymix","url":"https://realitymix.cz/detail/praha/prostorny-tri-loznicovy-byt-s-balkonem-s-uklidnujicim-vyhledem-v-lukrativni-lokalite-prahy-6-8705161.html"}],"area":142,"available_from":"2026-08-14","balcony":true,"cellar":null,"charges":null,"condition":"renovated","construction":"brick","currency":"CZK","deposit":null,"description":"K okamžitému pronájmu je připraven prostorný a mimořádně světlý byt s dispozicí 4+1, situovaný v prestižní rezidenční lokalitě pražské Ořechovky.\r\n\r\nByt se nachází v 1. nadzemním podlaží funkcionalistické vily z roku 1936, navržené podle projektu architekta Karla Stráníka. Vila má také významnou historickou stopu - v bytě se scházeli představitelé disidentského hnutí v čele s Václavem Havlem a vznikal zde text Charty 77.\r\n\r\nInteriér prošel kompletní a nákladnou rekonstrukcí, která citlivě kombinuje současný komfort s respektem k původní architektuře. Zachovány byly vysoké stropy, repasované dřevěné parkety, kazetové dveře a původní špaletová okna.\r\n\r\nDispozici tvoří vstupní hala, prostorný obývací pokoj, tři ložnice a kuchyně na míru s velkým množstvím úložného prostoru. Dvě ložnice disponují vlastními en-suite koupelnami - jedna se sprchovým koutem, druhá s vanou, sprchovým koutem a přímým vstupem na balkon. K dispozici je také samostatná toaleta přístupná z chodby. Kuchyně je plně vybavena spotřebiči Bosch včetně vestavěné pračky.\r\n\r\nByt je nově kompletně vybaven nábytkem, včetně kvalitních a designových solitérů, které podtrhují reprezentativní charakter interiéru. K příjemnému bydlení přispívá také možnost využívání společné zahrady.\r\n\r\nMěsíční poplatky činí 1 000 Kč za osobu. Elektřina a plyn budou převedeny na nájemce. Kauce je stanovena ve výši dvou měsíčních nájmů. Provize realitní kanceláři činí jeden měsíční nájem + DPH.","detail_done":true,"disp":"4+1","district":6,"first_seen":"2026-10-27","floor":0,"floors_total":3,"furnished":null,"garage":null,"heating":null,"history":[["2026-10-27",90000]],"id":"sreality-3548975180","images":["https://d18-a.sdn.cz/d_18/c_img_qG_A/nCR9NVflLrfprLMpIAIlYr/fc93.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_A/nCR9NVflLBaEbFIGRIAIlZJ/0007.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_A/kcKfrMAkFCDh88H7oIAIlZi/f42f.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_A/nCR9NVflLBkanYLPyIAIlZ7/dade.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_A/nCR9NVflLCnfP0jxlIAIlaW/84d3.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_A/kcKfrMAkFB3JsTi22IAIlav/2446.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_A/kcKfrMAkFCpZ9wOGzIAIlbG/bb90.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_A/nCR9NVflLCsdQ6MthIAIlbn/2536.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_A/kcKfrMAkFDzJCCLeuIAIlb9/5b74.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_A/nCR9NVflLChOIjMXOIAIlcY/2cd7.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_A/nCR9NVflLrfprKlcIAIlcu/2f24.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_A/nCR9NVflLCsdQ6M8TIAIldG/55d2.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_A/nCR9NVflLChOIjMZOIAIldf/1165.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|j