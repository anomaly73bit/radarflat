J_Jm/xwyxmB.jpeg?fl=res,1024,768,1"],"last_seen":"2026-10-27","lat":50.10809265551219,"lift":null,"loggia":null,"lon":14.437215286746671,"offer":"rent","ownership":null,"parking":null,"penb":null,"pets":null,"price":20904,"price_czk":20904,"price_m2":1394,"private":null,"quarter":"Holešovice","quarter_median_m2":523,"source":"sreality","source_id":"2159340636","street":"Na zátorách","terrace":null,"title":"Pronájem bytu 1+kk 15 m²","url":"https://www.sreality.cz/detail/pronajem/byt/1+kk/praha-holesovice-na-zatorach/2159340636"},"sreality-287359052":{"address":"Batelovská, Praha 4, Michle","also_on":[{"price_czk":23490,"source":"realitymix","url":"https://realitymix.cz/detail/praha/pronajem-bytu-2-1-batelovska-michle-23490-kc-mes-49-m2-8021897.html"}],"area":49,"available_from":"2026-11-01","balcony":true,"cellar":null,"charges":null,"condition":"very_good","construction":"brick","currency":"CZK","deposit":null,"description":"K dlouhodobému podnájmu nabízíme moderně zrekonstruovaný, ve vysokém standardu plně zařízený byt 2+1 s velkou lodžií orientovanou do vnitrobloku ve 3. patře udržovaného cihlového domu. \r\n\r\nDům se nachází v klidné, a přesto dopravně perfektně  dostupné lokalitě s vysokou kvalitou bydlení, nedaleko Pankráce, který je od domu jednu stanici metra. \r\n\r\nPouhých 300m od od domu je vzdálena stanice metra C - Budějovická, kde je také OC DBK. Přímo před domem je také autobusová zastávka, ze které se za 12 minut jízdy autobusem dopravíte na Smíchovské nádraží nebo za minutu jízdy autobusem v Business Centru \"Brumlovka\". \r\n\r\nByt s výměrou 49m2 tvoří vstupní chodba s nadstandartním množstvím úložného prostoru. \r\n\r\nObývací pokoj se vstupem na velmi prostornou lodžii napojený na kuchyňský kout. \r\n\r\nKuchyně vyrobena na míru je zařízena všemi vestavnými spotřebiči zn. Candy - vestavná trouba, indukční deska, mikrovlnná trouba, odtahová digestoř, myčka a volně stojící lednice. \r\n\r\nNa obývací pokoj navazuje ložnice vybavena  velkou vestavnou šatní skříní, volně stojící skříní prostornou komodou a kompletní postelí. \r\n\r\nZálohové platby už obsahují zálohy na elektřinu a pojištění domácnosti. \r\n\r\nByt bude připraven k nastěhování od 01.10.2026. V případě zájmu, možnost nastěhování už 22.9.2026.","detail_done":true,"disp":"2+1","district":4,"first_seen":"2026-10-27","floor":2,"floors_total":7,"furnished":"yes","garage":null,"heating":null,"history":[["2026-10-27",23490]],"id":"sreality-287359052","images":["https://d18-a.sdn.cz/d_18/c_img_qE_D/kPVqmweP7JB3Lg9BRYHlkHRZ/cc49.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qE_D/nPYADvcUkmBcG9PElJHlkHSA/7aa1.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qE_D/nPYADvcUkmBFAg3EDhHlkHSd/8166.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qE_D/kPVqmweP7JBuatXBThHlkHS4/014f.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qE_D/nPYADvcUkmBzBfmHCsHlkHTY/3a6b.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qE_D/nPYADvcUkmCfYovFddHlkHTx/aa02.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qE_D/kPVqmweP7JCNF9HBDCHlkHUP/8f4d.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qE_D/nPYADvcUkmBcG9PEl1HlkHUp/9031.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qE_D/kPVqmweP7JYnYGBIWHlkHVL/60bf.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qE_D/nPYADvcUkmBcG9PEidHlkHVo/8a06.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qE_D/kPVqmweP7JD9RxnBFhHlkHWD/3593.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qE_D/nPYADvcUkmBzBfmG5PHlkHWe/179b.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qE_D/nPYADvcUkmDOhBEWXHlkHW7/baba.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qE_D/nPYADvcUkmBcsRhETUHlkHXW/7b86.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qE_D/nPYADvcUkmDNojLB9dHlkHXx/51a7.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qE_D/kPVqmweP7JYnYGBKCHlkHYN/2b78.jpeg?fl=res,1024,768,1"],"last_seen":"2026-10-27","lat":50.0456127475679,"