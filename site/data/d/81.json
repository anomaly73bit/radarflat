/kPyfG4fPEeDb3WcHrFIJd4eq/5311.jpeg?fl=res,1024,768,1"],"last_seen":"2026-10-27","lat":50.10236,"lift":null,"loggia":null,"lon":14.530466,"offer":"rent","ownership":null,"parking":null,"penb":null,"pets":null,"price":40000,"price_czk":40000,"price_m2":421,"private":null,"quarter":"Hloubětín","quarter_median_m2":447,"source":"sreality","source_id":"2982289484","street":"K náhonu","terrace":null,"title":"Pronájem bytu 3+kk 95 m²","url":"https://www.sreality.cz/detail/pronajem/byt/3+kk/praha-hloubetin-k-nahonu/2982289484"},"sreality-4213964876":{"address":"Za poštou, Praha 10, Strašnice","also_on":[{"price_czk":21900,"source":"realitymix","url":"https://realitymix.cz/detail/praha/pronajem-bytu-2-kk-50-m-8734075.html"},{"price_czk":22000,"source":"realitymix","url":"https://realitymix.cz/detail/praha/pronajem-hezkeho-utulneho-bytu-2-1-48-m2-v-praze-10-strasnice-8731051.html"}],"area":50,"available_from":"2026-05-06","balcony":null,"cellar":true,"charges":null,"condition":"very_good","construction":"brick","currency":"CZK","deposit":null,"description":"Nově uvolněno!\r\n\t‌\r\nNabízíme k pronájmu krásný, skvěle dispozičně vyřešený a velmi světlý byt v cihlovém domě v Praze 10 - Strašnice, ul. Za poštou.\r\n\t‌\r\nAbsolutní klid a výborná dostupnost MHD (3 min. chůze na |M| Strašnická nebo 2 minuty na stanici tramvají č. 4, 6, 7, 19, 22 a 26). \r\n\t‌\r\nByt 2+kk (49,5 m2), patro na spaní (6 m2), drátěný sklep (3 m2). Balkón v mezipatre k užívání.\r\n2. patro ze 4 bez výtahu. \r\n\t‌\r\nKompletně zařízený spotřebiči i nábytkem, viz fotografie. V případě zájmu o nezařízený stav, je možné nábytek odstěhovat. \r\nKuchyňská linka s kombinovaným sporákem, lednicí a digestoří + druhá, samostatně stojící lednice. \r\nV předsíni dvě vestavěné skříně a komora.\r\n\t‌\r\nOrientace oken na západ. Velmi prostorná koupelna s vanou, pračkou a oknem do světlíku. WC samostatné také s oknem do světlíku. Na podlahách parkety a dlažba. \r\n\t‌\r\nVytápění jedněmi novými a druhými zánovními WAW, v koupelně podlahové topení. Ohřev vody bojlerem (100 l). \r\n\t‌\r\nStropy vysoké 283 cm. \r\n\t‌\r\nInternet (optický kabel – 2 Gb/s).\r\n\t‌\r\nKrásné okolí s plnou občanskou vybaveností a sportovního vyžití. 400 m od domu park Gutovka s minigolfem, lezeckou stěnou, skate parkem, lanovým centrem, Strašnickým zámečkem a několika dětskými hřišti. \r\n\t‌\r\nCena 21.900,-Kč + služby 600,-Kč/1 osoba + elektřina cca 1.900,-Kč + plyn cca 1.100,-Kč. Kauce 26.000,-Kč, provize pro RK 21.900,-Kč + 21% DPH.\r\n\t‌\r\nK dispozici ihned.","detail_done":true,"disp":"2+kk","district":10,"first_seen":"2026-10-27","floor":2,"floors_total":5,"furnished":null,"garage":null,"heating":null,"history":[["2026-10-27",21900]],"id":"sreality-4213964876","images":["https://d18-a.sdn.cz/d_18/c_img_qG_D/nQO0xPd86TDhsIbUOIMWmju/dce1.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkDyuEmmQ4IMWmkL/f35d.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkbxLFR70IMWmkp/9d22.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkCJCefN5SIMWmlK/06b6.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdk3whEnadIMWmln/16c4.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nQO0xPd86TDi9WNEFeIMWmmD/2967.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkB87eWOEIIMWmmc/1a97.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nQO0xPd86TCcWhaBzrIMWmm6/0145.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkCJCefN5SIMWmnU/7add.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkBcInfJtDIMWmnu/bbb8.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkbxLFR6GIMWmoJ/1e08.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nQO0xPd86TCcWhaBxvIMWmoh/1d8e.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkCfcGaOb0IMWmo5/a31e.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nQO0xPd86TDzG4UDWUIMWmp