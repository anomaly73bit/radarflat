cm6qn558vp3xff54z.jpeg","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/1076k/1076912/flatiougbti77pk2me8rqnwjp.jpeg"],"last_seen":"2026-10-27","lat":50.0643299,"lift":null,"loggia":null,"lon":14.4102127,"offer":"rent","ownership":null,"parking":null,"penb":null,"pets":null,"price":25935,"price_czk":25935,"price_m2":1081,"private":true,"quarter":"Smíchov","quarter_median_m2":500,"source":"bezrealitky","source_id":"1076912","street":"Strakonická","terrace":null,"title":"Pronájem bytu  24 m², Strakonická, Praha","url":"https://www.bezrealitky.cz/nemovitosti-byty-domy/1076912-nabidka-pronajem-bytu-strakonicka-praha"},"bezrealitky-1080791":{"address":"Zbynická, Praha - Radotín","also_on":[{"price_czk":16300,"source":"sreality","url":"https://www.sreality.cz/detail/pronajem/byt/1+kk/praha-radotin-zbynicka/1627979852"}],"area":39,"available_from":"2026-10-25","balcony":null,"cellar":null,"charges":3600,"condition":"very_good","construction":"brick","currency":"CZK","deposit":19900,"description":"„...mezi městem a přírodou...“\n\nNabízíme dlouhodobý pronájem bytu 1+kk na hezkém místě v Praze-Radotíně, v blízkosti řeky Berounky i vlakového nádraží (3 minuty chůze). Rychlé spojení do centra linkou S7 (Smíchovské nádraží 9 minut, Hlavní nádraží 19 minut).\n\nByt je vybaven novou kuchyňskou linkou s lednicí a vařičem. Právě byla dokončena příprava na pronájem a nastěhování je možné hned po podpisu smlouvy. \n\nNájemné: 16 300 Kč\nCelková záloha na služby vč. elektřiny: 3 600 Kč\nPřipojení k internetu: zdarma\nKauce: 19 900 Kč (tj. ve výši jedné měsíční platby)\n\nJako přímí majitelé v průběhu pronájmu zajišťujeme případné opravy a jsme Vám k dispozici.\n\nV blízkosti bytu se nachází bohatá občanská vybavenost (Billa, Žabka, několik dalších supermarketů a večerek, kavárny, restaurace, lékárny apod.) a široké sportovní zázemí (plavecký bazén s vířivkou, koupaliště Biotop Radotín, hřiště na plážový volejbal, finská sauna Kijukiju, víceúčelová sportovní hala, tenisové kurty, cyklostezka podél Berounky).\n\nDoplňující informace: Parkování v ulici je zdarma, nejsou tu modré zóny. Vytápění je zajištěno centrální plynovou kotelnou. Veškeré energie a služby se účtují přes nás, a tedy není potřeba uzavírat jakékoli další smlouvy s jednotlivými dodavateli. Dům je nekuřácký. Nejedná se o záplavovou oblast.","detail_done":true,"disp":"1+kk","district":5,"first_seen":"2026-10-27","floor":2,"floors_total":2,"furnished":"no","garage":null,"heating":"central","history":[["2026-10-27",16300]],"id":"bezrealitky-1080791","images":["https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/1080k/1080791/1792618415-xsikghcuni-img-1694.jpg","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/1080k/1080791/1792618414-rxetgwzibs-img-1705.jpg","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/1080k/1080791/1792618415-sqxecfzegh-img-1706.jpg","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/1080k/1080791/1792618414-qiedzkzlpb-img-1691.jpg","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/1080k/1080791/1792618417-bnpfapsrxt-img-1696.jpg","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/1080k/1080791/1792618414-darazfrmev-img-1701.jpg","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/1080k/1080791/1792618415-gxyxzxcjbs-img-1703.jpg","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/1080k/1080791/1792618417-dyjmufllkp-img-1700.jpg","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/1080k/1080791/1792618418-fpijkzbmpr-img-1708.jpg","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/1080k/1080791/1792618416-nolwaudvgq-img-1721.jpg"],"last_seen":"2026-10-27","lat":49.983291,"lift":false,"loggia":null,"lon":14.3637263,"offer":"rent","ownership":"personal","parking":null,"penb":"D","pets":null,"price":16300,"price_czk":16300,"price_m2":418,"private":true,"quarter":"Radotín","quarter_median_m2":396,"source":"bezrealitky","source_id":"1080791","street":"Zbynická","terrace":null,"title":"Pronájem bytu 1+kk • 39 m² • Zbynická • Praha - Radotín • bez RK","url":"https://www.bezrealitky.cz/nemovitosti-byty-domy/1080791-nabidka-pronajem-bytu-zbynicka-praha"},"bezrealitky-1081503":{"address":"Bydžovská, Praha - Klánovice","also_on":[],"area":54,"available_from":"2026-10-22","balcony":null,"cellar":null,"charges":5000,"condition":"very_good","construction":"brick","currency":"CZK","deposit":50000,"description":"Bydlení se zahradou v Klánovicích: 2+1 s vlastním vstupem, jen 3 minuty od vlaku\nHledáte pohodlí vlastního bytu a možnost trávit čas venku na zahradě? Nabízíme k dlouhodobému pronájmu byt 2+1 o velikosti 54 m² v ulici Bydžovská v Praze-Klánovicích, pouhé tři minuty pěšky od vlakového nádraží, odkud se pohodlně dopravíte do centra Prahy za pouhých 20 minut. \nByt se nachází v rodinném domě se dvěma samostatnými bytovými jednotkami. Každý byt má vlastní vstup. V roce 2021 prošel kompletní rekonstrukcí a je připraven k okamžitému nastěhování.\nPronajímá se nezařízený, takže si jej můžete zabydlet podle svého vkusu. Součástí je kuchyňská linka vybavená lednicí, myčkou, troubou a varnou deskou. Samostatná kuchyň ponechává oba pokoje plně k bydlení.\nDům obklopuje velká zahrada o rozloze přibližně 750m2 se zahradním domkem. Podmínky jejich užívání je na osobní domluvě.\nVelkou předností je spojení bydlení v zeleni s pohodlným dojížděním vlakem do Prahy. Blízký Klánovický les nabízí prostor pro procházky, běh i výlety na kole.\nZákladní informace:\n•\tDispozice 2+1, plocha 51 m².\n•\tVlastní vstup, pouze dva byty v domě.\n•\tKompletní rekonstrukce v roce 2021.\n•\tNezařízený byt s vybavenou kuchyní.\n•\tUžívání zahrady a zahradního domku.\n•\tVytápění společným plynovým kondenzačním kotlem, vlastní elektroměr.\n•\tK nastěhování ihned.\nNájemné: 25 000 Kč měsíčně + zálohy na služby a energie.\nVratná kauce: 50 000 Kč.\nMáte zájem o prohlídku? Rádi se s vámi domluvíme na osobním setkání.","detail_done":true,"disp":"2+1","district":9,"first_seen":"2026-10-27","floor":1,"floors_total":1,"furnished":"no","garage":null,"heating":null,"history":[["2026-10-27",25000]],"id":"bezrealitky-1081503","images":["https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/1081k/1081503/1792749168-vrhouucaeg-slunny-cc-81-du-cc-8am-pod-modrou-oblohou-4.png","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/1081k/1081503/1792749179-jupaspwxex-sve-cc-8cz-cc-8ci-cc-81-skandina-cc-81vsky-cc-81-pu-cc-8adorys-bytu.png","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/1081k/1081503/1792749202-yussvllkpb-prosve-cc-8ctleny-cc-81-interie-cc-81r-s-vy-cc-81hledem-1.png","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/1081k/1081503/1792749215-iyrdlgabxu-prosve-cc-8ctleny-cc-81-interie-cc-81r-s-vy-cc-81hledem-6.png","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/1081k/1081503/1792749235-pnjkptrtoe-sve-cc-8ctla-cc-81-kuchyne-cc-8c-s-vy-cc-81hledem-z-okna-2.png","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/1081k/1081503/1792749246-mkhkchjvsa-sve-cc-8ctly-cc-81-interie-cc-81r-zality-cc-81-denni-cc-81m-sve-cc-8ctlem-5.png","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/1081k/1081503/1792749263-zietjsgzzl-podzimni-cc-81-zahrada-v-teple-cc-81m-sve-cc-8ctle-3.png","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/1081k/1081503/1792749277-rvwmaemkfl-sve-cc-8ctly-cc-81-interie-cc-81r-s-vy-cc-81hledem-z-okna-1.png"],"last_seen":"2026-10-27","lat":50.0886745,"lift":false,"loggia":null,"lon":14.664331,"offer":"rent","ownership":null,"parking":null,"penb":null,"pets":null,"price":25000,"price_czk":25000,"price_m2":463,"private":true,"quarter":"Klánovice","quarter_median_m2":null,"source":"bezrealitky","source_id":"1081503","street":"Bydžovská","terrace":null,