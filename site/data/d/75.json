,"https://d18-a.sdn.cz/d_18/c_img_qG_C/kcKfrMAkFDbqUhBoUYIFmLsV/5e4c.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_C/nCR9NVflLChOIjyn7IFmLs2/8f0d.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_C/kcKfrMAkFDzJCCys0IFmLtS/4944.jpeg?fl=res,1024,768,1"],"last_seen":"2026-10-27","lat":50.0888334835367,"lift":null,"loggia":null,"lon":14.4662358296297,"offer":"rent","ownership":null,"parking":null,"penb":null,"pets":null,"price":33850,"price_czk":33850,"price_m2":230,"private":null,"quarter":"Praha 3","quarter_median_m2":403,"source":"sreality","source_id":"166137932","street":"","terrace":null,"title":"Pronájem bytu 2+kk 147 m²","url":"https://www.sreality.cz/detail/pronajem/byt/2+kk/praha-praha-3/166137932"},"sreality-1828986956":{"address":"Nekvasilova, Praha 8, Karlín","also_on":[],"area":67,"available_from":"2026-11-01","balcony":true,"cellar":true,"charges":null,"condition":"new","construction":"brick","currency":"CZK","deposit":null,"description":"ID zakázky: M1152\r\n\r\nGLJ Partners nabízí k dlouhodobému pronájmu kompletně zařízený byt o dispozici 2+kk s balkonem, situovaný v atraktivní a vyhledávané lokalitě Praha 8  Karlín. Byt o užitné ploše 60 m² doplňuje balkon o velikosti 7 m², celková plocha tedy činí 67 m². Nemovitost se nachází v moderním bytovém domě s výtahem a nabízí pohodlné městské bydlení s výbornou dostupností do centra Prahy.\r\n\r\nDispozice: 2+kk\r\nUžitná plocha: 60 m²\r\nBalkon: 7 m²\r\nNájemné: 33 000 Kč / měsíc\r\nPoplatky: 4 600 Kč / měsíc\r\nElektřina: převod na nájemce\r\nParkování: 2 000 Kč / měsíc\r\nSklep: součást pronájmu\r\nPlus Kauce a provize RK\r\nK nastěhování: 01.11\r\n\r\nVybavení a dispozice:\r\n\r\nByt se nabízí jako kompletně zařízený a je připraven k nastěhování. Interiér tvoří vstupní chodba, světlý obývací pokoj s kuchyňským koutem a jídelní částí, samostatná ložnice a koupelna. Kuchyňský kout je vybaven spotřebiči a poskytuje vše potřebné pro každodenní vaření. V obývací části se nachází sedací souprava, televize, jídelní stůl a židle. Ložnice má samostatný vstup z chodby a nabízí dostatek soukromí. Koupelna je vybavena vanou, toaletou a pračkou.\r\nSoučástí bytu je balkon o velikosti 7 m², který poskytuje příjemný venkovní prostor pro posezení a odpočinek.\r\n\r\nK bytu náleží sklep. Garážové parkovací stání je možné pronajmout za 2 000 Kč měsíčně.\r\n\r\nLokalita:\r\n\r\nByt se nachází ve velmi dobře dostupné části Prahy 8  Karlín, v bezprostřední blízkosti stanice metra B Invalidovna a tramvajové zastávky Invalidovna, které jsou vzdálené přibližně 1 minutu chůze od domu. V okolí je kompletní občanská vybavenost. V pěší vzdálenosti se nachází supermarket Albert, restaurace, kavárny, obchody, lékárna, služby a další místa pro každodenní nákupy i volný čas. Díky metru a tramvajovým spojům je centrum Prahy dostupné během několika minut. Lokalita zároveň nabízí příjemné možnosti pro procházky, sport a relaxaci v okolí Karlína, Rohanského nábřeží a přilehlých parků.\r\n\r\nProhlídky jsou možné po předchozí domluvě. Kontaktujte nás pro více informací.","detail_done":true,"disp":"2+kk","district":8,"first_seen":"2026-10-27","floor":6,"floors_total":11,"furnished":"yes","garage":true,"heating":null,"history":[["2026-10-27",33000]],"id":"sreality-1828986956","images":["https://d18-a.sdn.cz/d_18/c_img_qG_A/nCR9NVflLCsdQ6ONnH7uEGz/1a20.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_A/kcKfrMAkFB3JsTN34H7uEGf/4096.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_A/kcKfrMAkFCHDToOYVH7uEGF/d86b.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_A/nCR9NVflLrfprDU4H7uEFz/3563.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_A/nCR9NVflLBaEbFHjrH7uEHH/10ca.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_A/kcKfrMAkFB3JsTNzVH7uEHa/558c.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_A/kcKfrMAkFMsuhNYzH7uEHw/339d.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_A/kcKfrMAkFW9k4YJpH7uEIV/7c54.jpeg?fl