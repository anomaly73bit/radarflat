.sdn.cz/d_18/c_img_qG_A/nCR9NVflLBkdq1RDCH9lqIx/4b28.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_A/kcKfrMAkFB3JsTelgH9lqJH/d2e8.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_A/kcKfrMAkFDvG5qLpPH9lqJZ/6654.jpeg?fl=res,1024,768,1"],"last_seen":"2026-10-27","lat":50.0720968293091,"lift":null,"loggia":null,"lon":14.5476473505681,"offer":"rent","ownership":null,"parking":null,"penb":null,"pets":null,"price":22900,"price_czk":22900,"price_m2":440,"private":null,"quarter":"Štěrboholy","quarter_median_m2":440,"source":"sreality","source_id":"3183087692","street":"Andersenova","terrace":null,"title":"Pronájem bytu 2+kk 52 m²","url":"https://www.sreality.cz/detail/pronajem/byt/2+kk/praha-sterboholy-andersenova/3183087692"},"sreality-3241014604":{"address":"Maiselova, Praha 1, Josefov","also_on":[{"price_czk":36000,"source":"sreality","url":"https://www.sreality.cz/detail/pronajem/byt/3+kk/praha-josefov-maiselova/3945373772"},{"price_czk":36000,"source":"realitymix","url":"https://realitymix.cz/detail/praha/prostorny-byt-3-kk-74-m2-k-pronajmu-perfektni-lokalita-praha-1-maiselova-ulice-8012891.html"}],"area":74,"available_from":"2023-11-06","balcony":null,"cellar":null,"charges":null,"condition":"very_good","construction":"brick","currency":"CZK","deposit":null,"description":"Nabízíme k pronájmu prostorný byt po rekonstrukci o dispozici 3+kk a celkové užitné ploše 74 m2, který se nachází v atraktivní lokalitě Praha 1 – Josefov, ulice Maiselova. Byt je situován ve třetím podlaží secesního činžovního domu s výtahem.\r\n\r\nByt sestává z předsíně, dvou samostatných pokojů, obývacího pokoje volně propojeného s kuchyňským koutem vybaveným spotřebiči (sklokeramická varní deska, elektrická trouba, myčka na nádobí, mikrovlnná trouba, lednice s mrazákem), koupelny se sprchovým koutem a toaletou. V koupelně je podlahové vytápění.\r\nNa podlahách parkety a dlažba.\r\n\r\nPrestižní lokalita jen pár kroků od Staroměstského náměstí a Pařížské třídy v blízkost mnoha významných památek a současně na dosah všech služeb. Snadná dostupnost metrem, stanice metra A Staroměstská pár minut chůze. Kousek od domu staví také autobus umožňující pohodlné cestování po centru.\r\n\r\nPro více informací či prohlídku kontaktujte makléře.","detail_done":true,"disp":"3+kk","district":1,"first_seen":"2026-10-27","floor":2,"floors_total":6,"furnished":"no","garage":null,"heating":null,"history":[["2026-10-27",36000]],"id":"sreality-3241014604","images":["https://d18-a.sdn.cz/d_18/c_img_oX_A/nOzqs9nZOdD1A3zamCgbrj4/c4a5.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_oX_A/nOzqs9nZOdBr9sZZFCgbrpc/b2db.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_oX_A/nOzqs9nZOdDoRMeZECgbruj/c264.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_oX_A/kPWmeC9soBBaJRte4Cgbrye/74a1.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_oX_A/nOzqs9nZOdDdshAaNCgbr2p/547e.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_oX_A/kPWmeC9soBBaJRte4CgbsKF/25ba.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_oX_A/nOzqs9nZOdBZAD9cICgbsOH/f81d.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_oX_A/kPWmeC9soBBaJRte3CgbsSq/b423.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_oX_A/nOzqs9nZOdBr9sZZCCgbsXj/d705.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_oX_A/kPWmeC9soB1GgaaMCgbsZ0/3508.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_oX_A/kPWmeC9soBB5dBZecCgbsdi/cbcc.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_oX_A/kPWmeC9soBDmlC1ceCgbsfv/d90f.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_oX_A/nOzqs9nZOdDdshAaNCgbskN/faf5.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_oX_A/nOzqs9nZOdI9ozdFCgbsoI/e0fd.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_oX_A/kPWmeC9soBBaJRte4Cgbssj/d200.jpeg?fl=res,1024,768,1"],"last_seen":"2026-10-27","lat":50.088797,"lift":true,"loggia":null,"lon":14.418263,"offer":"rent","ownership":"personal","parking":null,"penb":"G","pets":null,"price":36000,"price_czk":36000,"price_m2":486,"private":false,"quarter":"Josefov","quarter_median_m2":500,"source":"sreality","source_id":"3241014604","street":"Maiselova","terrace":null,"title":"Pronájem bytu 3+kk 74 m²","url":"https://www.sreality.cz/detail/pronajem/byt/3+kk/praha-josefov-maiselova/3241014604"},"sreality-3415720012":{"address":"Nad Bořislavkou, Praha 6, Vokovice","also_on":[{"price_czk":25900,"source":"realitymix","url":"https://realitymix.cz/detail/praha/pronajem-bytu-v-klidne-casti-prahy-6-8679963.html"}],"area":60,"available_from":"2026-10-01","balcony":null,"cellar":true,"charges":null,"condition":"very_good","construction":"mixed","currency":"CZK","deposit":null,"description":"V zastoupení majitele nabízím k pronájmu nově zrekonstruovaný byt ve druhém patře (třetí nadzemní podlaží) cihlového domu bez výtahu.\r\nDo bytu se vstupuje prostornou předsíní (možnost umístění velké skříně). Nová kuchyňská linka je vybavena elektrickou varnou deskou, elektrickou troubou, digestoří, myčkou, lednicí s mrazákem a pračkou se sušičkou. V obývacím pokoje je sedací souprava. Balkonové dveře je možno otevřit, ale prostor balkonu čítá pouze několik málo centimetrů (viz fotografie). Z obývacího pokoje se vchází do ložnice, která je vybavena postelí a velkou skříní. V koupelně je sprchový kout, umyvadlo a toaleta. Naproti koupelny je praktická komora.\r\nVytápění a ohřev vody jsou lokální - plynový kotel. Elektřina v bytě a plyn se přepisují na nájemníky.\r\nVzhledem k rozsáhlé rekonstrukci nejsou domácí mazlíčci vítáni.\r\nK bytu náleží sklepní kóje. K bytu je možné pronajmout také samostatnou garáž ve dvoře, odkud se vchází do budovy. V případě zájmu vám rádi sdělíme cenu.\r\nStanice metra Bořislavka se nachází cca. 500 metrů od domu.\r\nNájemné 25.900 Kč + poplatky 1.500 Kč\r\nElektřina a plyn se převádějí na nájemce\r\n2 kauce - 51.800 Kč\r\nPoplatek RK - jeden nájem + DPH\r\nV případě zájmu o prohlídku mě neváhejte kontaktovat. Prosíme o stručný popis všech osob, které by v bytě rády bydlely.\r\nPronajímající si vyhrazuje právo vybrat nájemce na základě jím zvolených kritérií.","detail_done":true,"disp":"2+1","district":6,"first_seen":"2026-10-27","floor":2,"floors_total":3,"furnished":"partly","garage":true,"heating":null,"history":[["2026-10-27",25900]],"id":"sreality-3415720012","images":["https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkBQkMFdChIMPnrY/81fe.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkB87eWKDcIMPnr9/6826.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nCXhmtHPUCHypVBSENIMPnsm/e26e.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nCXhmtHPUB854tBeKnIMPntK/ddf8.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nCXhmtHPUD8nezBeTvIMPntr/7eb4.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nCXhmtHPUB6IMDD3jyIMPnuS/e35d.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkbxLFMsiIMPnu3/22e2.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nCXhmtHPUCHypVBSENIMPnvi/e57d.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nCXhmtHPUD9QxwBT0GIMPnwD/7c80.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkCfcGaKG3IMPnwk/8ead.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nCXhmtHPUD9QxwBTyTIMPnxO/a334.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nCXhmtHPUB13CvBZekIMPnx2/f4a2.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nCXhmtHPUBiA4qBTvMIMPnyb/140a.jpeg?fl=res,1024,768,1"],"last_seen":"2026-10-27","lat":50.095697,"lift":null,"loggia":null,"lon":14.366231,"offer":"rent","ownership":"personal","parking":null,"penb":"G","pets":null,"price":25900,"price_czk":25900,"price_m2":432,"private":false,"quarter":"Vokovice","quarter_median_m2":444,"source":"sreality","source_id":"3415720012","street":"Nad Bořislavkou","terrace":null,"title":"Pronájem bytu 2+1 60 m²","url":"https://www.sreality.cz/detail/pronajem/byt/2+1/praha-vokovice-nad-