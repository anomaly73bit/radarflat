_detail.jpg"],"last_seen":"2026-10-27","lat":null,"lift":null,"loggia":null,"lon":null,"offer":"rent","ownership":null,"parking":null,"penb":null,"pets":null,"price":19900,"price_czk":19900,"price_m2":302,"private":null,"quarter":"Troja","quarter_median_m2":414,"source":"realitymix","source_id":"8729591","street":"K sadu","terrace":null,"title":"Pronájem bytu, 2+kk, 66 m²","url":"https://realitymix.cz/detail/praha/pronajem-bytu-2-kk-s-terasou-garazovym-stanim-a-vyhledem-na-prahu-praha-7-troja-k-sadu-8729591.html"},"realitymix-8731613":{"address":"Do zahrádek I, Praha-Zličín, Třebonice","also_on":[{"price_czk":23990,"source":"sreality","url":"https://www.sreality.cz/detail/pronajem/byt/2+kk/praha-trebonice-do-zahradek-i/2604597324"}],"area":55,"available_from":null,"balcony":null,"cellar":null,"charges":null,"condition":"very_good","construction":"brick","currency":"CZK","deposit":null,"description":"Popis nemovitosti Podnájem, Byty 2+kk, 55m2, Praha 5 - Zličín, ul. Do zahrádek I Vzhledem ke zvýšené poptávce o námi nabízené nemovitosti prosíme všechny vážné zájemce, aby nás pro rychlé vyřízení kontaktovali pomocí odpovědního formuláře u inzerátu, nebo e-mailem. V reakci nám prosím uveďte alespoň základní informace (datum nastěhování, domácí mazlíček, zaměstnání, zda jste kuřák, kolik osob bude v bytě bydlet). Následně se vám ozveme a domluvíme se na další postupu a termínu prohlídky. Nabízíme Vám k podnájmu nový pěkný zařízený byt s balkonem o velikosti 2+kk o rozloze 55 m2. Byt se nachází ve 4. podlaží novostavby v dobře dostupné lokalitě Praha 5 - Zličín, ulice Do zahrádek I. K bytu patří velká uzamykatelná garáž přímo v domě. Prostorný obývací pokoj s rohovou sedací soupravou, pohodlným křeslem a moderním konferenčním stolem nabízí pohodlné místo k odpočinku. Otevřená kuchyně je vybavena moderní kuchyňskou linkou s elektrickou troubou, indukční varnou deskou, myčkou, lednicí s mrazákem a mikrovlnnou troubou. Z obývacího pokoje je přímý přístup do ložnice, která disponuje dvoulůžkovou postelí a vestavěnou skříní pro uložení oblečení a osobních věcí. Chodba bytu nabízí praktický botník a věšák pro uložení obuvi a kabátů. Koupelna je vybavena vanou a toaletou. Kromě toho má byt balkón pro venkovní posezení a také garážové stání pro bezpečné parkování vozidla. Dobré dopravní spojení do centra města zajišťuje stanice metra B - Zličín, která je cca 300m od bytu. V blízkém okolí je velké množství zeleně, parků a sportovních hřišť, které svádí k aktivnímu stylu života.. Veškeré nákupy obstaráte v nákupním centru Metropole Zličín, které je 5 minut chůze od domu. Byt je volný k nastěhování ihned. Bydlete se Stálým Nájmem. ️ Stalo se vám někdy, že pronajímatel neměl čas se Vám věnovat? S námi se to nestane – jsme vám k dispozici každý všední den od 9 do 17 hodin. Zajistíme převody energií, pojištění, vyúčtování a když se něco přihodí společně to vyřešíme. I když jen potřebujete poradit nebo si ujasnit nějaký detail - jsme tu pro Vás","detail_done":true,"disp":"2+kk","district":5,"first_seen":"2026-10-27","floor":4,"floors_total":5,"furnished":null,"garage":null,"heating":null,"history":[["2026-10-27",23990]],"id":"realitymix-8731613","images":["https://st.realitymix.cz/i/66677944/8029298/nab_502639007_detail.jpg","https://st.realitymix.cz/i/66675334/8664143/nab_502446457_detail.jpg","https://st.realitymix.cz/i/3503001/8715543/nab_501080415_detail.jpg","https://st.realitymix.cz/i/66678457/8727237/nab_502319855_detail.jpg"],"last_seen":"2026-10-27","lat":50.056223333333,"lift":null,"loggia":null,"lon":14.291008888889,"offer":"rent","ownership":"personal","parking":null,"penb":"G","pets":null,"price":23990,"price_czk":23990,"price_m2":436,"private":false,"quarter":"Třebonice","quarter_median_m2":487,"source":"realitymix","source_id":"8731613","street":"Do zahrádek I","terrace":null,"title":"Pronájem bytu, 2+kk, 55 m²","url":"https://realitymix.cz/detail/praha/podnajem-byty-2-kk-55m2-praha-5-zlicin-ul-do-zahradek-i-8731613.html"},"sreality