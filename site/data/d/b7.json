na klimatizace. K dispozici je kvalitní italské ložní prádlo a ručníky, je možné zajistit pravidelný úklid.\r\n\r\nPoplatky činí 500 EUR za energie a 50 EUR za internet za měsíc + DPH. Kauce je stanovena ve výši dvou měsíčních nájmů. Provize realitní kanceláři činí jeden měsíční nájem + DPH.","detail_done":true,"disp":"4+kk","district":1,"first_seen":"2026-10-27","floor":1,"floors_total":null,"furnished":"yes","garage":null,"heating":null,"history":[["2026-10-27",53372]],"id":"sreality-780734540","images":["https://d18-a.sdn.cz/d_18/c_img_qG_A/nCR9NVflLCNT9ccBxIAI3Lh/b6e2.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_A/kcKfrMAkFCHDToOTlIAI3L5/8a80.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_A/nCR9NVflLBkanYLPyIAI3MW/25f5.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_A/nCR9NVflLnoRVOYEIAI3M0/0f1f.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_A/nCR9NVflLBkdq1VFYIAI3NR/3526.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_A/nCR9NVflLBaEbFKQUIAI3Nn/6845.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_A/nCR9NVflLCnfP0kZOIAI3OE/93de.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_A/kcKfrMAkFDvG5qPwlIAI3Oa/e8a8.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90"],"last_seen":"2026-10-27","lat":50.0899915213,"lift":true,"loggia":null,"lon":14.4289165618,"offer":"rent","ownership":"personal","parking":null,"penb":"G","pets":null,"price":53372,"price_czk":53372,"price_m2":445,"private":false,"quarter":"Nové Město","quarter_median_m2":513,"source":"sreality","source_id":"780734540","street":"Truhlářská","terrace":null,"title":"Pronájem bytu 4+k