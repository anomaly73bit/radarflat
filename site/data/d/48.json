ages/advert/1075k/1075865/1791457519-kfrwgjkmtz-kuchy-c5-88sk-c3-a1-linka-bez-lednice.jpg","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/1075k/1075865/1791457547-ulrbsmokbq-img-0891.jpg"],"last_seen":"2026-10-27","lat":50.1311928,"lift":null,"loggia":null,"lon":14.4789793,"offer":"rent","ownership":null,"parking":null,"penb":null,"pets":null,"price":31000,"price_czk":31000,"price_m2":456,"private":true,"quarter":"Kobylisy","quarter_median_m2":419,"source":"bezrealitky","source_id":"1075865","street":"Frýdlantská","terrace":null,"title":"Pronájem bytu 3+1 68 m², Frýdlantská, Praha","url":"https://www.bezrealitky.cz/nemovitosti-byty-domy/1075865-nabidka-pronajem-bytu-frydlantska-praha"},"realitymix-7999800":{"address":"Moskevská, Praha 10, Vršovice","also_on":[{"price_czk":28000,"source":"sreality","url":"https://www.sreality.cz/detail/pronajem/byt/2+kk/praha-vrsovice-moskevska/1465450572"}],"area":46,"available_from":null,"balcony":null,"cellar":true,"charges":null,"condition":"renovated","construction":"brick","currency":"CZK","deposit":null,"description":"Popis nemovitosti Pronájem bytu 2+kk, 46 m2, Moskevská, Čechovo náměstí, Praha 10, Vršovice Nabízíme k pronájmu slunný byt 2+kk, 46 m2, Moskevská, Čechovo náměstí, Praha 10, Vršovice. Dům je přímo u zastávky tramvaje 22 do centra, 10 minut na všechny tři linky metra. Jedná se o příjemné bydlení s výhledem na jih do klidného vnitrobloku plného zeleně. Byt je v prvním patře. Skládá se z obývacího pokoje s kuchyňským koutem, ložnice, předsíně a koupelny s WC. Byt je po celkové rekonstrukci, je plně zařízen nábytkem, součástí je i nádobí, skleničky, příbory a je tak kompletně připravený k nastěhování. Kuchyňská linka je velmi prostorná, vyrobená na míru. Její součástí je vestavěná lednice s mrazákem, myčka na nádobí, elektrická varná deska, trouba a mikrovlnná trouba. V obývacím pokoji je jídelní kout s jídelním stolem a 4 židlemi, prostorná pohovka a konferenční stolek a dále je jeho součástí také televizní stolek a úplně nová 75-palcová QLED televize s uhlopříčkou 189 cm. K obývacímu pokoji přiléhá také komora jako šikovný úložný prostor. V ložnici je nová dvojpostel 180x200 cm s roštem a matracemi, noční stolek a dále jsou v ložnici a předsíni prostorné vestavěné skříně s posuvnými zrcadlovými dveřmi. Koupelna je se sprchovým koutem a také je tu nová pračka se sušičkou. V obývacím pokoji a ložnici jsou moderní plynová topidla, v koupelně pak topí nástěnný žebříček. Ohřev vody zajišťuje elektrický bojler. V ceně pronájmu je také vysokorychlostní optický internet s rychlostí 250 GBit. A k bytu patří také nově zrekonstruovaný sklep. Celkově jde o nadstandardní byt, s pěkným výhledem do zeleně vnitrobloku a s perfektní dostupností do centra. Vratná kauce je ve výši dvou měsíčních nájmů. Žádná provize RK. Byt je volný od listopadu či od prosince, dle domluvy. Vážní zájemci volejte Po-Pá 9-18.","detail_done":true,"disp":"2+kk","district":10,"first_seen":"2026-10-27","floor":1,"floors_total":6,"furnished":null,"garage":null,"heating":null,"history":[["2026-10-27",28000]],"id":"realitymix-7999800","images":["https://st.realitymix.cz/i/66677944/7895899/nab_501243827_detail.jpg","https://st.realitymix.cz/i/66677944/7926363/nab_500717579_detail.jpg","https://st.realitymix.cz/i/66677944/8332285/nab_501920237_detail.jpg","https://st.realitymix.cz/i/66677944/8424075/nab_501245153_detail.jpg"],"last_seen":"2026-10-27","lat":50.067902,"lift":null,"loggia":null,"lon":14.458825,"offer":"rent","ownership":"personal","parking":null,"penb":"D","pets":null,"price":28000,"price_czk":28000,"price_m2":609,"private":false,"quarter":"Vršovice","quarter_median_m2":491,"source":"realitymix","source_id":"7999800","street":"Moskevská","terrace":null,"title":"Pronájem bytu, 2+kk, 46 m²","url":"https://realitymix.cz/detail/praha/pronajem-bytu-2-kk-46-m2-moskevska-cechovo-namesti-praha-10-vrsovice-7999800.html"},"realitymix-8611943":{"address":"U trati, Praha 10, Strašnice","also_on":[],"area":46,"available_from":null,"balcony":null,"cellar":null,"charges":null,"condition":null,"construction":null,"currency":"CZK","deposit":null,"description":null,"detail_done":false,"disp":"2+1","district":10,"first_seen":"2026-10-27","floor":2,"floors_total":2,"furnished":null,"garage":null,"heating":null,"history":[["2026-10-27",18000]],"id":"realitymix-8611943","images":["https://st.realitymix.cz/i/1472754/8611943/nab_491653079_detail.jpg","https://st.realitymix.cz/i/1472754/8611943/nab_491653081_detail.jpg","https://st.realitymix.cz/i/1472754/8611943/nab_491653083_detail.jpg","https://st.realitymix.cz/i/1472754/8611943/nab_491653085_detail.jpg"],"last_seen":"2026-10-27","lat":null,"lift":null,"loggia":null,"lon":null,"offer":"rent","ownership":null,"parking":null,"penb":null,"pets":null,"price":18000,"price_czk":18000,"price_m2":391,"private":null,"quarter":"Strašnice","quarter_median_m2":436,"source":"realitymix","source_id":"8611943","street":"U trati","terrace":null,"title":"Pronájem bytu, 2+1, 46 m²","url":"https://realitymix.cz/detail/praha/pronajem-bytu-2-1-46-m-praha-ul-u-trati-8611943.html"},"sreality-1173278796":{"address":"K Botiči, Praha 10, Vršovice","also_on":[{"price_czk":35000,"source":"realitymix","url":"https://realitymix.cz/detail/praha/pronajem-bytu-3-kk-v-oblibene-prazske-ctvrti-vrsovice-8657585.html"}],"area":75,"available_from":"2026-07-29","balcony":null,"cellar":null,"charges":null,"condition":"very_good","construction":"mixed","currency":"CZK","deposit":null,"description":"K dlouhodobému  pronájmu je připravený světlý a prostorný byt s dispozicí 3+kk a celkovou výměrou 75 m², který se nachází v nejvyšším podlaží udržovaného bytového domu v klidné ulici K Botiči v oblíbené pražské čtvrti Vršovice.\r\n\r\nByt prošel kompletní rekonstrukcí, díky které nabízí moderní a komfortní bydlení. Noví nájemci ocení zcela nové podlahy, elegantní koupelnu i novou kuchyňskou linku, připravenou pro instalaci spotřebičů dle vlastních potřeb. Byt se pronajímá nezařízený, což poskytuje možnost vytvořit si interiér přesně podle vlastního vkusu.\r\n\r\nDominantou bytu je prostorný obývací pokoj se vstupem na lodžii, odkud se otevírá krásný panoramatický výhled na Prahu. Díky umístění v nejvyšším patře je byt příjemně světlý, tichý a nabízí dostatek soukromí.\r\n\r\nSoučástí pronájmu je také sklepní kóje, která poskytuje praktický úložný prostor. Parkování je možné pohodlně v modré rezidentní zóně přímo v okolí domu.\r\n\r\nVršovice patří mezi nejvyhledávanější pražské lokality díky skvělé občanské vybavenosti a výborné dopravní dostupnosti. V bezprostřední blízkosti se nachází oblíbené kavárny, restaurace, obchody, školy, sportoviště, park Grébovka nebo Havlíčkovy sady, ideální pro relaxaci a volnočasové aktivity. Centrum města je snadno dostupné během několika minut tramvají i autem.\r\n\r\nTento byt je ideální volbou pro zájemce, kteří hledají moderní bydlení po rekonstrukci v atraktivní lokalitě s výbornou dostupností a krásnými výhledy na Prahu.","detail_done":true,"disp":"3+kk","district":10,"first_seen":"2026-10-27","floor":3,"floors_total":null,"furnished":"no","garage":null,"heating":null,"history":[["2026-10-27",35000]],"id":"sreality-1173278796","images":["https://d18-a.sdn.cz/d_18/c_img_qE_D/nPYADvcUkmBFAg3WaHnVfFR/bd47.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qE_D/kPVqmweP7JBiRmGDYCHnVfF5/97fc.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qE_D/nPYADvcUkmBzBfmCGOHnVfGh/f6d3.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qE_D/kPVqmweP7JB3Lg93vHnVfHF/2178.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qE_D/nPYADvcUkmDcXILBKMHnVfHr/9998.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qE_D/kPVqmweP7JB3Lg9WqHnVfIl/920e.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qE_D/nPYADvcUkmDcXILBJyHnVfJP/c7f5.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qE_D/kPVqmweP7JCpoDkCOYHnVfJw/9297.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_im