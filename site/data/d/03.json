 nábytkem. Zázemí doplňuje koupelna s vanou, sprchovým koutem, bidetem a toaletou. V poslední řadě se v prvním patře nalézá samostatná toaleta, technická místnost a vstupní chodba s vestavěnými skříněmi.\r\n\r\nHorní patro tvoří velká otevřená galerie využitelná jako další ložnice, ze které se vstupuje na třetí terasu s úložnou komorou.\r\n\r\nSoučástí pronájmu je i sklep. Pronájem je možný ihned.","detail_done":true,"disp":"5+1","district":6,"first_seen":"2026-10-27","floor":5,"floors_total":6,"furnished":"yes","garage":null,"heating":null,"history":[["2026-10-27",75000]],"id":"sreality-2953576524","images":["https://d18-a.sdn.cz/d_18/c_img_qG_D/nQO0xPd86TCcWhaDZEIMY7bM/271a.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_D/nQO0xPd86TDhsIbPyZIMY7br/a5f5.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_D/nQO0xPd86TDzG4UFvjIMY7cJ/6c75.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_D/nQO0xPd86TDhsIbLXdIMY7cz/76d7.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkBQkMFnHgIMY7dT/4c0c.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_D/nQO0xPd86TCcWhaDZEIMY7dz/e79d.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_D/nQO0xPd86TnJSEEsgIMY7eV/632d.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkDyuEmn5FIMY7ev/3e48.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkCfcGaQoYIMY7fP/5d52.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_D/nQO0xPd86TBgJSgEaaIMY7fs/eb09.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,9