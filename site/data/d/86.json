ájemce - služba, se kterou budete bydlet bezstarostně a za férových podmínek. Když se něco přihodí, k dispozici jsou správci, kteří s vámi vše vyřeší. Pomůžeme s veškerou administrativou, s nastavením plateb a zajistíme vám speciální pojištění. Pojďte bydlet s námi!","detail_done":true,"disp":"2+1","district":9,"first_seen":"2026-10-27","floor":1,"floors_total":4,"furnished":"no","garage":null,"heating":null,"history":[["2026-10-27",22000]],"id":"sreality-2687250508","images":["https://d18-a.sdn.cz/d_18/c_img_qF_B/nOdL4BtPEyBuWMSBlgHtN1xv/5c71.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_B/k0OqwCKRIhAnCCyHtN1yL/f91c.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_B/nOdL4BtPEyC2Er4DzbHtN1yl/e93d.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_B/nOdL4BtPEyBiPBFB0ZHtN1zE/ae71.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_B/k0OqwCKRZSJdEP0HtN1zc/4ac0.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_B/k0OqwCKRDgcHsHGNHtN1z2/1766.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_B/k0OqwCKRBOXzT7MHtN10W/3362.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_B/k0OqwCKRB7OXgBmfHtN10z/2f75.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_B/nOdL4BtPEyBuWMSB43HtN11W/43ce.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_B/k0OqwCKRIhAnCNuHtN11v/50af.jpeg?fl=res,1024,768,1"],"last_seen":"2026-10-27","lat":50.0990245990763,"lift":false,"loggia":null,"lon":14.4829871417433,"offer":"rent","ownership":"personal","parking":null,"penb":"G","pets":null,"price":22000,"price_czk":22000,"price_m2":393,"private":false,"quarter":"Vysočany","quarter_median_m2":464,"source":"sreality","source_id":"2687250508","street":"Novovysočanská","terrace":null,"title":"Pronájem bytu 2+1 56 m²","url":"https://www.sreality.cz/detail/pronajem/byt/2+1/praha-vysocany-novovysocanska/2687250508"},"sreality-295112780":{"address":"Praha 10, Vinohrady","also_on":[],"area":145,"available_from":null,"balcony":nul