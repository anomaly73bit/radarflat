0m. U té je také obchodní centrum a Penny market. \r\n\r\nByt je k dispozici od 1.12.2026\r\n\r\nZálohové platby už obsahují zálohy na elektřinu a pojištění domácnosti.","detail_done":true,"disp":"2+1","district":10,"first_seen":"2026-10-27","floor":5,"floors_total":6,"furnished":"partly","garage":null,"heating":null,"history":[["2026-10-27",22500]],"id":"sreality-579342412","images":["https://d18-a.sdn.cz/d_18/c_img_qG_D/kPyfG4fPEeDb3WcI8lIJg50q/8218.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_D/kPyfG4fPEeDb3WcIDWIJg52R/4fbb.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_D/nCXhmtHPUB6IMDI0wIJg52u/7645.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_D/kPyfG4fPEeDb3WcIELIJg54U/ae06.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_D/nCXhmtHPUB13CvElQIJg541/a7e3.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_D/kPyfG4fPEeBPfwtLkXIJg55X/354d.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_D/kPyfG4fPEeC2TMrMTrIJg55z/0b84.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_D/nCXhmtHPUChHuMDiQIJg56Q/01cc.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_D/nCXhmtHPUD8nezBxaIJg56s/72c6.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_D/nCXhmtHPUBL8BsM5JIJg57N/f2d3.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_D/kPyfG4fPEeCdpo1MMPIJg578/029e.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_D/kPyfG4fPEeCsx6aZwcIJg58m/a3fd.jpeg?fl=res,1920,108