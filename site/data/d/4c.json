nice Dejvická a četné tramvajové spoje z Vítězného náměstí.\r\n\r\nInteriér bytu tvoří obývací pokoj s plně vybavenou kuchyní a jídelním prostorem, ložnice s en-suite koupelnou, samostatná toaleta a vstupní chodba. \r\n\r\nVinylové podlahy, dlažba, dřevěná okna, vestavěné skříně, pračka, myčka, sušička, plynový kotel, sklepní kóje.","detail_done":true,"disp":"2+kk","district":6,"first_seen":"2026-10-27","floor":2,"floors_total":null,"furnished":"no","garage":null,"heating":null,"history":[["2026-10-27",26000]],"id":"sreality-4164096076","images":["https://d18-a.sdn.cz/d_18/c_img_qG_D/nCXhmtHPUBL8BsNz1IJjK4D/9e26.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_D/kPyfG4fPEeushhJPyIJjLCA/c5e0.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_D/kPyfG4fPEeCdpo1MO3IJjLKC/3000.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_D/nCXhmtHPUB13CvEpcIJjLSJ/7da7.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_D/kPyfG4fPEeCdpo1N64IJjLab/efb6.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_D/kPyfG4fPEeC2TMrMTnIJjLiY/862c.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_D/kPyfG4fPEeD8XKqLReIJjLqg/e917.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_D/kPyfG4fPEeCdpo1MPBIJjLyg/1209.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90"],"last_seen":"2026-10-27","lat":50.0990247875337,"lift":true,"loggia":null,"lon":14.3923853354033,"offer":"rent","ownership":"personal","parking":null,"penb":"G","pets":null,"price":26000,"price_czk":26000,"price_m2":553,"private":false,"quarter":"Dejvice","quarter_median_m2":450,"source":"sreality","source_id":"4164096076","street":"Ka