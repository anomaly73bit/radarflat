 s vybavenou šatnou a koupelnou (vana, toaleta), dále koupelna se sprchovým koutem, toaleta pro hosty a vstupní hala se vstupem na balkon.\r\n\r\nKrásné výhledy do zeleně, dřevěné podlahy a dlažba, bezpečnostní dveře, plynový kotel, pračka, myčka, mikrovlnná trouba, alarm, videotelefon, samostatné měřiče energií. Parkování v garáži v ceně.","detail_done":true,"disp":"3+1","district":6,"first_seen":"2026-10-27","floor":2,"floors_total":null,"furnished":"no","garage":true,"heating":null,"history":[["2026-10-27",42000]],"id":"sreality-2225213516","images":["https://d18-a.sdn.cz/d_18/c_img_qG_B/kcKfrMAkFDzJCCo2kIEQGXz/56d3.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_B/nCR9NVflLwO7jlXQIEQGg3/063b.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_B/kcKfrMAkFCpZ9wGn5IEQGpl/9527.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_B/nCR9NVflLCsdQ6Ij2IEQGxo/e880.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_B/kcKfrMAkFW9k4TzfIEQG5s/e51a.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_B/nCR9NVflLrfpr4LDIEQHDs/af6d.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_B/nCR9NVflLrfpr45hIEQHLV/2c2d.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_B/nCR9NVflLCsdQ6IfPIEQHTX/60f7.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_B/kcKfrMAkFDzJCCo2kIEQHbT/bae1.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_B/kcKfrMAkFnIwlu7YIEQHjQ/1219.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_B/nCR9NVflLrfpr5TFIEQHrc/4252.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_B/nCR9NVflLCsdQ6IjyIEQHzg/a6aa.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_B/kcKfrMAkFDbqUhBbxWIEQH7b/e4cf.jpeg?fl=res,1024,768,1"],"last_seen":"2026-10-27","lat":50.0971420906195,"lift":null,"loggia":null,"lon":14.385841414874,"offer":"rent","ownership":"personal","parking":true,"penb":"G","pets":null,"price":42000,"price_czk":42000,"price_m2":385,"private":false,"quarter":"Střešovice","qu