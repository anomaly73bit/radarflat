aven k okamžitému nastěhování. Profesionální správa bytu: Tento byt je v profesionální správě společnosti Bohemian Estates International, což Vám zaručuje bezproblémový a klidný pronájem. Během celého pobytu se nebudete muset dohadovat s majitelem – o veškerou administrativu, vyúčtování i řešení případných technických závad se staráme my. Garantujeme Vám férové jednání, jasné smluvní podmínky a rychlou komunikaci v případě jakéhokoliv problému. Zaujal Vás tento byt a dokážete si zde představit svůj nový domov? Neváhejte nám napsat e-mail, velmi rádi s Vámi domluvíme termín prohlídky a vše Vám ukážeme osobně.","detail_done":true,"disp":"1+kk","district":8,"first_seen":"2026-10-27","floor":null,"floors_total":null,"furnished":null,"garage":null,"heating":null,"history":[["2026-10-27",17500]],"id":"realitymix-8724271","images":["https://st.realitymix.cz/i/66677944/7514465/nab_501407851_detail.jpg","https://st.realitymix.cz/i/6486858/8706031/nab_502256637_detail.jpg","https://st.realitymix.cz/i/66700873/8710859/nab_502487335_detail.jpg","https://st.realitymix.cz/i/66678949/8718325/nab_501316823_detail.jpg"],"last_seen":"2026-10-27","lat":50.111655555556,"lift":null,"loggia":null,"lon":14.470866111111,"offer":"rent","ownership":"personal","parking":null,"penb":"G","pets":null,"price":17500,"price_czk":17500,"price_m2":648,"private":false,"quarter":"Libeň","quarter_median_m2":457,"source":"realitymix","source_id":"8724271","street":"Kandertova","terrace":null,"title":"Pronájem bytu, 1+kk, 27 m²","url":"https://realitymix.cz/detail/praha/pronajem-bytu-1-kk-27-m-praha-liben-8724271.html"},"realitymix-8732553":{"address":"Pod Harfou, Praha 9, Vysočany","also_on":[{"price_czk":24490,"source":"bezrealitky","url":"https://www.bezrealitky.cz/nemovitosti-byty-domy/1072312-nabidka-pronajem-bytu-pod-harfou-praha"},{"price_czk":24000,"source":"sreality","url":"https://www.sreality.cz/detail/pronajem/byt/2+kk/praha-vysocany-pod-harfou/3376283724"},{"price_czk":24490,"source":"srealit