ntrální vytápění, pračka, sušička, myčka, mikrovlnná trouba, sklep. K dispozici je garážové stání za 2 500 Kč měsíčně.","detail_done":true,"disp":"2+kk","district":10,"first_seen":"2026-10-27","floor":4,"floors_total":null,"furnished":"yes","garage":true,"heating":null,"history":[["2026-10-27",29500]],"id":"sreality-3720872012","images":["https://d18-a.sdn.cz/d_18/c_img_qG_D/nCXhmtHPUD9QxwBFawILsGuE/8fba.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kPyfG4fPEeBPfwtBXrNILsG2L/4435.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kPyfG4fPEeDb3WcBKapILsG98/08e0.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kPyfG4fPEeC2TMrBN8gILsHIL/9f44.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nCXhmtHPUBiA4qBHwFILsHQD/a30a.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nCXhmtHPUD9QxwBFawILsHYF/8aa3.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kPyfG4fPEeD8XKqBN5jILsHgE/a27d.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nCXhmtHPUCaRYmBHIdILsHoI/57f2.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kPyfG4fPEeushhBKxPILsHwI/4ae1.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nCXhmtHPUChHuMBITDILsH4T/4891.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kPyfG4fPEeBPfwtBXrJILsICW/38d3.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kPyfG4fPEe0kCSBV8DILsIKj/3c97.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nCXhmtHPUBL8BsDVyBILsISd/bb50.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nCXhmtHPUB6IMDDQEkILsIai/80fc.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nCXhmtHPUCaRYmBHIFILsIiq/e9e4.jpeg?fl=res,1024,768,1"],"last_seen":"2026-10-27","lat":50.0722602538147,"lift":true,"loggia":null,"lon":14.4808170802538,"offer":"rent","ownership":"personal","parking":true,"penb":"B","pets":null,"price":29500,"price_czk":29500,"price_m2":670,"private":false,"quarter":"Vršovice","quarter_median_m