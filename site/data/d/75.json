G_A/kcKfrMAkFCpZ9wKN2H7u2CU/0443.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_A/kcKfrMAkFCpZ9wKN2H7u2Ci/1ac5.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_A/nCR9NVflLCnfP0OsPH7u2C1/66bd.jpeg?fl=res,1024,768,1"],"last_seen":"2026-10-27","lat":50.1307136037382,"lift":null,"loggia":null,"lon":14.4965794641845,"offer":"rent","ownership":null,"parking":null,"penb":null,"pets":null,"price":30000,"price_czk":30000,"price_m2":395,"private":null,"quarter":"Střížkov","quarter_median_m2":460,"source":"sreality","source_id":"2685673548","street":"Zásadská","terrace":null,"title":"Pronájem bytu 3+kk 76 m²","url":"https://www.sreality.cz/detail/pronajem/byt/3+kk/praha-strizkov-zasadska/2685673548"},"sreality-3472855116":{"address":"Komunardů, Praha 7, Holešovice","also_on":[{"price_czk":75000,"source":"realitymix","url":"https://realitymix.cz/detail/praha/moderni-mezonet-3-kk-s-velkou-terasou-a-garazi-holesovice-8592451.html"}],"area":96,"available_from":"2026-05-12","balcony":true,"cellar":null,"charges":null,"condition":"very_good","construction":"brick","currency":"CZK","deposit":null,"description":"Představuji k pronájmu výjimečný mezonetový byt se střešní terasou a nádhernými výhledy v 6. a 7. patře rezidenčního projektu Linea Pura v oblíbené lokalitě Holešovice.\r\nByt nabízí užitnou plochu 96,5 m² a velkorysé venkovní prostory o celkové výměře 55,1 m² v podobě terasy a balkonů. Dispozice je promyšleně rozdělena do dvou podlaží.\r\n\r\nV horním patře se nachází vstupní předsíň, prostorný obývací pokoj s kuchyňským koutem a vstupem na krásnou střešní terasu, která poskytuje příjemné soukromí i jedinečné výhledy na okolí. Kuchyňská linka je aktuálně ve výrobě a bude dodána na míru včetně spotřebičů. Na tomto podlaží je zároveň samostatná toaleta.\r\nSpodní patro tvoří klidová část bytu se dvěma ložnicemi. Každá ložnice disponuje vlastní koupelnou se sprchovým koutem a toaletou a zároveň vstupem na balkon. Jeden pokoj je orientován do ulice, druhý do klidného vnitrobloku.\r\n\r\nByt se nabízí nezařízený, majitelé jsou však po dohodě schopni zajistit kompletní vybavení dle potřeb budoucího nájemce. Samozřejmostí jsou elektrické venkovní rolety, inteligentní ovládání bytu, stropní chlazení a vytápění či geotermální systém s tepelnými čerpadly. Komfort bydlení doplňují vysoké stropy, 24hodinová recepce a bezpečnostní služba. Součástí pronájmu je také garážové stání.","detail_done":true,"disp":"3+kk","district":7,"first_seen":"2026-10-27","floor":6,"floors_total":null,"furnished":"yes","garage":true,"heating":null,"history":[["2026-10-27",75000]],"id":"sreality-3472855116","images":["https://d18-a.sdn.cz/d_18/c_img_qD_E/nO2CysqjGrDPliFBUgUHQYuSy/275b.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qD_E/kQMlcCt5zmBDkXauE8HQYuTV/871a.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qD_E/nO2CysqjGrCP7qOBUhmHQYuT5/7990.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qD_E/kQMlcCt5zmBDkXauQqHQYuUh/816e.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qD_E/kQMlcCt5zmBDp4mfFuHQYuVH/fe4f.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qD_E/nO2CysqjGrDPliFBUbFHQYuV4/cf9e.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qD_E/kQMlcCt5zmChFvGdPSHQYuW8/df4a.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qD_E/kQMlcCt5zmBDkXauQzHQYuXk/8e28.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qD_E/nO2CysqjGrC2szhB6oLHQYuYQ/c9cc.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qD_E/nO2CysqjGrCP7qOBUirHQYuZC/c58d.jpeg?fl=res,1024,768,1"],"last_seen":"2026-10-27","lat":50.1032503,"lift":true,"loggia":null,"lon":14.4499747,"offer":"rent","ownership":"personal","parking":true,"penb":"G","pets":null,"price":75000,"price_czk":75000,"price_m2":781,"private":false,"quarter":"Holešovice","quarter_median_m2":523,"source":"sreality","source_id":"3472855116","street":"Komunardů","terrace":true,"title":"Pronájem bytu 3+kk 96 m²","url":"https://www.sreality.cz/detail/pronajem/byt/3+kk/praha-holesovice-komunardu/3472855116"},"sreality-3732156492":{"address":"Bubenská, Praha 7, Holešovice","also_on":[],"area":21,"available_from":"2026-09-25","balcony":null,"cellar":null,"charges":null,"condition":"renovated","construction":"brick","currency":"CZK","deposit":null,"description":"Nabízíme k pronájmu kompletně zrekonstruovaný byt o užitné ploše 21 m² s terasou o velikosti 3,5 m², která nabízí příjemný výhled do klidného vnitrobloku a nachází se v 6. patře s výtahem.<br />\r\nByt se pronajímá nezařízený a je vhodný pro jednotlivce. Součástí vybavení je kuchyňská linka s dřezem a lednice s mrazákem.<br />\r\nVelkou výhodou je poloha – stanice metra Vltavská je vzdálena přibližně 2 minuty chůze. V bezprostředním okolí naleznete širokou nabídku restaurací, kaváren, obchodů a dalších služeb. Milovníci procházek a sportu jistě ocení také blízkost rozlehlého parku Stromovka.<br />\r\nZálohy na služby činí 2.000 Kč měsíčně, záloha na elektřinu je 500 Kč měsíčně. Kauce je stanovena ve výši 20.000 Kč. Provize realitní kanceláři činí 17.000 Kč + DPH.<br />\r\nPro více informací nebo sjednání termínu prohlídky nás neváhejte kontaktovat.","detail_done":true,"disp":"1+kk","district":7,"first_seen":"2026-10-27","floor":6,"floors_total":8,"furnished":"partly","garage":null,"heating":null,"history":[["2026-10-27",17000]],"id":"sreality-3732156492","images":["https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkCJCefMpQIMV4Yi/e9a0.png?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkCJCefNY0IMV4ZX/c71a.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nQO0xPd86TDi9WNDlVIMV4aR/87dd.png?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkBcInfJrKIMV4bH/83b5.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nQO0xPd86TDhsIbH6zIMV4b1/784e.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkDyuEmcrGIMV4co/c80a.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nQO0xPd86TkUyxB5xIMV4da/4e