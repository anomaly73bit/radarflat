 Praha, ul. Ledvinova Nabízíme k dlouhodobému pronájmu byt 1+1 o výměře 35 m² na ulici Ledvinova, v panelovém domě po rekonstrukci, situovaný v šestém podlaží. Kuchyň je samostatná, byt je plně zařízen nábytkem i spotřebiči, připraven k okamžitému nastěhování. Obytná místnost je prostorná, byt je bez balkonu a orientován na jihozápad (JZ), takže je světlý a příjemný. Koupelna a toaleta jsou oddělené, dům je po rekonstrukci s udržovanými společnými prostory. Lokalita nabízí dobrou dostupnost do centra i okolí, v blízkosti je občanská vybavenost a MHD. Parkování je možné na ulici. Vhodné pro jednotlivce nebo pár hledající klidné, plně vybavené bydlení. K nastěhování dle dohody. Pro více informací nebo prohlídku nás kontaktujte.","detail_done":true,"disp":"1+1","district":4,"first_seen":"2026-10-27","floor":6,"floors_total":8,"furnished":null,"garage":null,"heating":null,"history":[["2026-10-27",15000]],"id":"realitymix-8545647","images":["https://st.realitymix.cz/i/6901658/8721137/nab_501553245_detail.jpg","https://st.realitymix.cz/i/66679173/8731573/nab_502417623_detail.jpg","https://st.realitymix.cz/i/66677944/8482425/nab_501750767_detail.jpg","https://st.realitymix.cz/i/66673308/8632233/nab_502636337_detail.jpg"],"last_seen":"2026-10-27","lat":null,"lift":null,"loggia":null,"lon":null,"offer":"rent","ownership":null,"parking":null,"penb":"G","pets":null,"price":15000,"price_czk":15000,"price_m2":429,"private":false,"quarter":"Chodov","quarter_median_m2":443,"source":"realitymix","source_id":"8545647","street":"Ledvinova","terrace":null,"title":"Pronájem bytu, 1+1, 35 m²","url":"https://realitymix.cz/detail/praha/pronajem-bytu-1-1-35-m-praha-ul-ledvinova-8545647.html"},"realitymix-8720705":{"address":"Jankovcova, Praha 7, Holešovice","also_on":[],"area":55,"available_from":null,"balcony":null,"cellar":null,"charges":null,"condition":null,"construction":null,"currency":"CZK","deposit":null,"description":null,"detail_done":false,"disp":"2+kk","district":7,"first_seen"