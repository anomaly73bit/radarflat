í nájemné: 37 000 Kč včetně parkovacího stání.\n- Poplatky: 9 000 Kč měsíčně (včetně energií)\n- Celkem: 46 000 Kč měsíčně.\n\n## Termín nastěhování\n- K nastěhování od prosince.\n- Po domluvě je možné i nastěhování koncem listopadu – budeme se snažit vyjít vstříc.","detail_done":true,"disp":"3+kk","district":8,"first_seen":"2026-10-27","floor":6,"floors_total":9,"furnished":"partly","garage":true,"heating":"central","history":[["2026-10-27",37000]],"id":"bezrealitky-1082133","images":["https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/1082k/1082133/1792922206-pmwlzemrqe-img-6446.jpg","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/1082k/1082133/1792922207-actqomikda-pudorys-karlin.png","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/1082k/1082133/1792922206-dqnxogpdbi-img-9951.jpg","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/1082k/1082133/1792922207-dcorhjqnkp-img-0002.jpg","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/1082k/1082133/1792922206-csphtsjufy-img-6432.jpg","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/1082k/1082133/1792922205-ebfrpvmmzh-img-3370.jpg","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/1082k/1082133/1792922206-sbyachksxd-img-3376.jpg","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/1082k/1082133/1792922207-lohbqcrerj-img-6438.jpg","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/1082k/1082133/1792922206-mvanhdrhvd-img-6440.jpg","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/1082k/1082133/1792922207-hiqoqqolyb-img-6444.jpg","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/1082k/1082133/1792922206-mapkpgxhbr-img-6437.jpg"],"last_seen":"2026-10-27","lat":50.0955858,"lift":true,"loggia":null,"lon":14.4504141,"offer":"rent","ownership":null,"parking":null,"penb":null,"pets":null,"price":37000,"