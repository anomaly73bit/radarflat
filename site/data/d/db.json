69635/8689961/nab_500594155_detail.jpg"],"last_seen":"2026-10-27","lat":null,"lift":null,"loggia":null,"lon":null,"offer":"rent","ownership":null,"parking":null,"penb":null,"pets":null,"price":23000,"price_czk":23000,"price_m2":397,"private":null,"quarter":"Ruzyně","quarter_median_m2":454,"source":"realitymix","source_id":"8689961","street":"Stočesova","terrace":null,"title":"Pronájem bytu, 2+kk, 58 m²","url":"https://realitymix.cz/detail/praha/byt-k-pronajmu-2-kk-53-7m2-balkon-5-4m2-sklep-4-1m2-garazove-stani-praha-6-ruzyne-8689961.html"},"realitymix-8729555":{"address":"Elišky Přemyslovny, Praha-Zbraslav, Zbraslav","also_on":[],"area":38,"available_from":null,"balcony":null,"cellar":null,"charges":null,"condition":"very_good","construction":"mixed","currency":"CZK","deposit":null,"description":"Popis nemovitosti Pronájem bytu 1+kk, 35 m2, park. stání, Elišky Přemyslovny, Praha 5-Zbraslav Ve výhradním zastoupení majitele nabízíme na pronájem nový, zatím neužívaný byt 1+kk, o velikosti 35 m2, nacházející se ve 2 NP nedávno zkolaudovaném developerském projektu Rezidence Elišky Přemyslovny, v klidné části Prahy 5 - Zbraslavi. Byt sestává z předsíně s praktickou šatní stěnou a je zde z prostorových důvodů umístěna pračka se sušičkou. Z předsíně se vchází do koupelny s velkým sprchovým koutem, WC, umyvadlem a koupelnovou skřínkou. V hlavní obytné místnosti je nová, moderní kuchyňská linka, s trojplotýnkovou el. varnou deskou, troubou, mikrovlnou troubou, myčkou a menší vestavěnou lednicí s mrazáčkem. Obytná místnost skýtá dostatek prostoru na umístění jídelního stolu, sedačky, komody pod televizi, podle představ nájemníků. Spací kout je opticky oddělen a velikostně odpovídá umístění max. 160 m široké postele. Vytápění a ohřev vody je zajišťován vlastní kotelnou v domě, budova má fotovoltaické panely na střeše, PENB B ukazuje na velmi úspornou budovu a dá se předpokládat, že náklady na vytápění vzhledem k umístění bytu v rámci domu a jižní orientaci, budou nízké. Byt je ihned k nastěhování. Nájemné činí 19.500,- Kč/měs., zálohy na služby související s užíváním bytu jsou 1.800,- Kč/měs. a elektřina se převádí na nájemníka. K bytu je možné pronajmout venkovní parkovací stání s dálkově ovládaným uzamčením (800,- Kč/měs) přímo u domu. Vratná kauce je ve výši 21.300,- Kč, provize RK 19.500,- Kč + DPH. Rezidence Elišky Přemyslovny nabízí komfortní bydlení s dobrou dostupností veškeré občanské vybavenosti. V blízkém okolí najdete obchody, supermarket, lékárnu, zdravotnická zařízení, mateřské i základní školy, restaurace a další služby pro každodenní život. Výhodou lokality je i vlakové nádraží Praha-Zbraslav, odkud se lze pohodlně dopravit do Prahy i do okolních míst. Milovníci přírody ocení blízkost zeleně, možnosti procházek a aktivního odpočinku, díky nimž Zbraslav nabízí příjemné spojení městského komfortu s klidnějším bydlením.","detail_done":true,"disp":"1+kk","district":5,"first_seen":"2026-10-27","floor":2,"floors_total":4,"furnished":null,"garage":null,"heating":null,"history":[["2026-10-27",19500]],"id":"realitymix-8729555","images":["https://st.realitymix.cz/i/66672166/8704303/nab_502395373_detail.jpg"],"last_seen":"2026-10-27","lat":null,"lift":null,"loggia":null,"lon":null,"offer":"rent","ownership":"personal","parking":null,"penb":"B","pets":null,"price":19500,"price_czk":19500,"price_m2":513,"private":false,"quarter":"Zbraslav","quarter_median_m2":472,"source":"realitymix","source_id":"8729555","street":"Elišky Přemyslovny","terrace":null,"title":"Pronájem bytu, 1+kk, 38 m²","url":"https://realitymix.cz/detail/praha/pronajem-bytu-1-kk-35-m2-park-stani-elisky-premyslovny-praha-5-zbraslav-8729555.html"},"sreality-1871781964":{"address":"5. května, Praha 4, Nusle","also_on":[],"area":53,"available_from":null,"balcony":null,"cellar":null,"charges":null,"condition":null,"construction":null,"currency":"CZK","deposit":null,"description":null,"detail_done":false,"disp":"2+1","district":2,"first_seen":"2026-10-27","floor":null,"floo