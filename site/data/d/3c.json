000,- kč za služby ( topení, spol.elektřina, elektřina, plyn, odpady, úklid domu, vodné, stočné ). Při podpisu smlouvy se platí hotově první nájemné 18.500,- kč, + 5.000,- kč služby, dále vratná kauce 37.000,- kč a 18.500,- kč + DPH provize RK. Byt je volný k nastěhování od 01.12.2026. Kontaktujte makléře nabídky. Pronajímající si vyhrazuje právo vybrat nájemce na základě jím zvolených kritérií.","detail_done":true,"disp":"1+1","district":6,"first_seen":"2026-10-27","floor":3,"floors_total":6,"furnished":null,"garage":null,"heating":null,"history":[["2026-10-27",18500]],"id":"realitymix-8730017","images":["https://st.realitymix.cz/i/6847448/8592199/nab_494515187_detail.jpg","https://st.realitymix.cz/i/66675551/8702661/nab_500698551_detail.jpg","https://st.realitymix.cz/i/66670820/8724081/nab_501764897_detail.jpg","https://st.realitymix.cz/i/66669890/5170917/nab_502133071_detail.jpg"],"last_seen":"2026-10-27","lat":50.084316666667,"lift":null,"loggia":null,"lon":14.371608333333,"offer":"rent","ownership":"personal","parking":null,"penb":"B","pets":null,"price":18500,"price_czk":18500,"price_m2":462,"private":false,"quarter":"Břevnov","quarter_median_m2":456,"source":"realitymix","source_id":"8730017","street":"Pod Marjánkou","terrace":null,"title":"Pronájem bytu, 1+1, 40 m²","url":"https://realitymix.cz/detail/praha/pronajem-krasneho-bytu-1-1-40m2-praha-6-brevnov-8730017.html"},"sreality-2469269580":{"address":"Na Petřinách, Praha 6","also_on":[],"area":50,"available_from":null,"balcony":null,"cellar":null,"charges":null,"condition":null,"construction":null,"currency":"CZK","deposit":null,"description":null,"detail_done":false,"disp":"2+kk","district":6,"first_seen":"2026-10-27","floor":null,"floors_total":null,"furnished":null,"garage":null,"heating":null,"history":[["2026-10-27",22900]],"id":"sreality-2469269580","images":["https://d18-a.sdn.cz/d_18/c_img_qG_B/nCR9NVflLwO7jQqcIBT59O/73d2.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_B/kcKfrMAkFnIwlbHa