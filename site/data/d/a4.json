tem, samostatné toalety a pokoje spojeného s kuchyní, která je vybavena varnou deskou, dřezem a lednicí. Letná patří mezi jedny z nejoblíbenějších a nejvyhledávanějších částí Prahy. V bezprostřední blízkosti se nachází park Stromovka a Letenské sady, stejně jako mnoho kaváren a restaurací, které můžete navštěvovat ve svém volném čase. Samozřejmostí je i skvělá dopravní dostupnost do centra Prahy. Nastěhování je možné od 15.10.2026.","detail_done":true,"disp":"1+kk","district":6,"first_seen":"2026-10-27","floor":null,"floors_total":null,"furnished":null,"garage":null,"heating":null,"history":[["2026-10-27",16500]],"id":"realitymix-8715085","images":["https://st.realitymix.cz/i/1472754/8697309/nab_499584051_detail.jpg","https://st.realitymix.cz/i/66670328/8712773/nab_500982767_detail.jpg","https://st.realitymix.cz/i/66679173/8725989/nab_501930701_detail.jpg","https://st.realitymix.cz/i/66700195/8734077/nab_502630617_detail.jpg"],"last_seen":"2026-10-27","lat":50.101993888889,"lift":null,"loggia":null,"lon":14.418388888889,"offer":"rent","ownership":"personal","parking":null,"penb":"G","pets":null,"price":16500,"price_czk":16500,"price_m2":688,"private":false,"quarter":"Bubeneč","quarter_median_m2":489,"source":"realitymix","source_id":"8715085","street":"Jana Zajíce","terrace":null,"title":"Pronájem bytu, 1+kk, 24 m²","url":"https://realitymix.cz/detail/praha/svetly-byt-1-kk-par-kroku-od-parku-stromovka-8715085.html"},"realitymix-8730219":{"address":"Sosnovecká, Praha 8, Troja","also_on":[{"price_czk":16990,"source":"sreality","url":"https://www.sreality.cz/detail/pronajem/byt/1+1/praha-troja-sosnovecka/4106813516"}],"area":29,"available_from":null,"balcony":null,"cellar":null,"charges":null,"condition":"good","construction":"panel","currency":"CZK","deposit":null,"description":"Popis nemovitosti Podnájem, Byty 1+1, 29m2, Praha 8 - Troja, ul. Sosnovecká Vzhledem ke zvýšené poptávce o námi nabízené nemovitosti prosíme všechny vážné zájemce, aby nás pro rychlé vyřízení 