rasou. Byt je klimatizovaný s podlahovým vytápěním a zabezpečený dveřmi s kódem. Je určen k dlouhodobému pronájmu a je nevybavený. Lokalita nabízí blízkost mezinárodních škol, letiště a rekreační zázemí s bazénem, saunou, fitness, dětským hřištěm a squashem. K bytu patří sklep a dvě garážová stání. Měsíční poplatky za služby jsou stanoveny podle skutečné spotřeby s předpokládanými zálohami cca 30 000 Kč.","detail_done":true,"disp":"6+","district":5,"first_seen":"2026-10-27","floor":null,"floors_total":null,"furnished":null,"garage":null,"heating":null,"history":[["2026-10-27",150000]],"id":"realitymix-8732771","images":["https://st.realitymix.cz/i/66677944/7704759/nab_502268515_detail.jpg","https://st.realitymix.cz/i/66677944/7794104/nab_501852501_detail.jpg","https://st.realitymix.cz/i/1170900/7858692/nab_495726567_detail.jpg","https://st.realitymix.cz/i/66677944/7882911/nab_500796915_detail.jpg"],"last_seen":"2026-10-27","lat":50.07616,"lift":null,"loggia":null,"lon":14.3782175,"offer":"rent","ownership":"personal","parking":null,"penb":"G","pets":null,"price":150000,"price_czk":150000,"price_m2":505,"private":false,"quarter":"Smíchov","quarter_median_m2":500,"source":"realitymix","source_id":"8732771","street":"Na Hřebenkách","terrace":null,"title":"Pronájem bytu, 6+kk, 297 m²","url":"https://realitymix.cz/detail/praha/pronajem-mezonetoveho-bytu-6-kk-v-prestizni-rezidenci-xy-8732771.html"},"sreality-1057034316":{"address":"U staré studánky, Praha 10, Dubeč","also_on":[{"price_czk":22500,"source":"realitymix","url":"https://realitymix.cz/detail/praha/2-kk-s-parkovanim-44-m2-8723505.html"}],"area":44,"available_from":null,"balcony":null,"cellar":null,"charges":null,"condition":null,"construction":null,"currency":"CZK","deposit":null,"description":null,"detail_done":false,"disp":"2+kk","district":10,"first_seen":"2026-10-27","floor":null,"floors_total":null,"furnished":null,"garage":null,"heating":null,"history":[["2026-10-27",22500]],"id":"sreality-1057034316","ima