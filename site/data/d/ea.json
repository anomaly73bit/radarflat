y.cz/media/cache/record_main/data/images/advert/1078k/1078099/1792160890-vhmrszgxoh-cerne-ramy.jpg","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/1078k/1078099/1792160890-ubdhaedinz-whatsapp-image-2026-10-16-at-16-03-11.jpg","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/1078k/1078099/1792160890-yhfmsvlmkj-04-281-29.png"],"last_seen":"2026-10-27","lat":50.1026761,"lift":null,"loggia":null,"lon":14.4534118,"offer":"rent","ownership":null,"parking":null,"penb":null,"pets":null,"price":37530,"price_czk":37530,"price_m2":751,"private":true,"quarter":"Holešovice","quarter_median_m2":523,"source":"bezrealitky","source_id":"1078099","street":"Na Maninách","terrace":null,"title":"Pronájem bytu 2+kk 50 m², Na Maninách, Praha","url":"https://www.bezrealitky.cz/nemovitosti-byty-domy/1078099-nabidka-pronajem-bytu-na-maninach-praha"},"bezrealitky-1080337":{"address":"Poděbradská, Praha - Hloubětín","also_on":[{"price_czk":20500,"source":"sreality","url":"https://www.sreality.cz/detail/pronajem/byt/1+kk/praha-hloubetin-podebradska/2484797516"},{"price_czk":19900,"source":"sreality","url":"https://www.sreality.cz/detail/pronajem/byt/1+kk/praha-vysocany-podebradska/1711312972"}],"area":33,"available_from":"2026-11-01","balcony":true,"cellar":true,"charges":3286,"condition":"new","construction":"mixed","currency":"CZK","deposit":42000,"description":"Nabízíme k dlouhodobému pronájmu od přímého vlastníka (neplatíte žádnou provizi) krásný nový byt s dispozicí 1+kk, který je umístěn v moderní rezidenci Tesla Hloubětín na Praze 9.\n\nBytová jednotka s podlahovou plochou 33 m2 se nachází v 2. NP. K pronájmu byt je nabízen částečně vybavený dle foto. Koupelna se sprchovým koutem včetně pračky. Byt má vlastní lodžii (6m2). K bytu náleží prostorný sklep 3m2.\n\nVeškerá občanská vybavenost v blízkém okolí : supermarket Kaufland, sportovní a plavecký areál, fitness centrum, bleší trhy, přírodní park \"Smetanka\", OC Harfa, O2 Arena, a mnoho dalšího. Přímo před domem je tram. zastávka \"Nademlejnská\" a nedaleko stanice metra linky B - \"Hloubětín\".\n\nO správu a technický servis této nemovitosti se stará zkušený tým VESSAN Facility. Za pronájem a správu neplatíte žádnou provizi. Svým nájemníkům dlouhá léta garantujeme bezstarostný pronájem po celou dobu trvání smlouvy a technickou podporu (přehled o platbách, transparentní a férové vyúčtování služeb, prodloužení smlouvy, zajištění oprav).\n\nJe vhodný pro toho, kdo hledá klidné a tiché bydlení v centru města, kde vše je blízko a na dosah, kde není nutné nikam dojíždět za nákupy, nebo lékařem, kde je možné trávit čas v klidu a bez problémů.\n\nPro více informace neváhejte nás kontaktovat.","detail_done":true,"disp":"1+kk","district":9,"first_seen":"2026-10-27","floor":2,"floors_total":7,"furnished":"partly","garage":null,"heating":null,"history":[["2026-10-27",20500]],"id":"bezrealitky-1080337","images":["https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/1080k/1080337/1792489513-ezifipfaoi-2026-02-23-132214-hdr.jpg","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/1080k/1080337/1792489512-dolpsebdgc-2026-02-23-132212-hdr.jpg","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/1080k/1080337/1792489512-fikmfplgmq-2026-02-23-132208-hdr-281-29.jpg","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/1080k/1080337/1792489503-lvcpgvegjj-2026-02-23-132203-hdr-281-29.jpg","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/1080k/1080337/1792489504-ryfyqwjscz-2026-02-23-132206-hdr-281-29.jpg","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/1080k/1080337/1792489514-wplkfqcydy-2026-02-23-132204-hdr.jpg","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/1080k/1080337/1792489514-evuawmwroy-2026-02-23-132222-hdr-281-29.jpg","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/1080k/1080337/1792489513-likrytbadu-2026-02-23-132216-hdr.jpg","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/1080k/1080337/1792489513-rlbrwjdtte-2026-02-23-132224-hdr.jpg"],"last_seen":"2026-10-27","lat":50.1034743,"lift":false,"loggia":null,"lon":14.5234628,"offer":"rent","ownership":null,"parking":null,"penb":null,"pets":null,"price":20500,"price_czk":20500,"price_m2":621,"private":true,"quarter":"Hloubětín","quarter_median_m2":447,"source":"bezrealitky","source_id":"1080337","street":"Poděbradská","terrace":null,"title":"Pronájem bytu 1+kk • 33 m² • Poděbradská • Praha - Hloubětín • bez RK","url":"https://www.bezrealitky.cz/nemovitosti-byty-domy/1080337-nabidka-pronajem-bytu-podebradska-praha"},"bezrealitky-1081925":{"address":"Koštířova, Praha - Chodov","also_on":[],"area":34,"available_from":"2026-10-23","balcony":null,"cellar":null,"charges":3500,"condition":"very_good","construction":"brick","currency":"CZK","deposit":28000,"description":"Nabízíme k pronájmu slunný byt 1+kk o ploše 34 m2 se zasklenou lodžií (6m2). Byt se nachází ve 2. patře udržovaného cihlového domu s výtahem, cca. 600m od metra C Chodov i Kunratického lesa. Byt je vybavený kuchyňskou linkou se sklokeramickou deskou, el. troubou a lednicí s mrazákem, v koupelně je pračka. WC samostatné. Parkování před domem. Byt je k dispozici ihned. \nPreferujeme nájemce bez domácích mazlíčků. V případě zájmu prosím napište stručnou informaci o sobě, případně i spolubydlících. Děkujeme.","detail_done":true,"disp":"1+kk","district":4,"first_seen":"2026-10-27","floor":2,"floors_total":4,"furnished":"partly","garage":null,"heating":"central","history":[["2026-10-27",14000]],"id":"bezrealitky-1081925","images":["https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/1081k/1081925/1792865242-snpcvykzbp-1000044732.jpg","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/1081k/1081925/1792865241-sconnxpxry-1000044729.jpg","https://api.bezrealitky.cz/media/cache/record_main/data/images/adver