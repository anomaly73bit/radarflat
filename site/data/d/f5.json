"disp":"2+kk","district":1,"first_seen":"2026-10-27","floor":2,"floors_total":null,"furnished":"no","garage":null,"heating":null,"history":[["2026-10-27",34000]],"id":"sreality-3795198028","images":["https://d18-a.sdn.cz/d_18/c_img_qG_D/nQO0xPd86TDi9WNUNIMV2T1/7470.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nQO0xPd86TkUyxB5cIMV2cF/f8d2.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nQO0xPd86TDzG4UUQIMV2kV/48b2.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nQO0xPd86TDi9WNCDSIMV2sg/dc4f.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nQO0xPd86Tw5RPGGbIMV20n/2a1d.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkBcInfJrKIMV28t/7516.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nQO0xPd86TBSHZcBgTIMV3Gx/f143.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkBcInfJrKIMV3PM/70ed.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkCJCefNY0IMV3XY/569c.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkbxLFR6GIMV3fo/cf60.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkCfcGaNKGIMV3n4/db0a.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nQO0xPd86TBctrNDBeIMV3wP/8240.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkC4TclNpOIMV34n/0b46.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkCfcGaOZ7IMV4Cv/6a07.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nQO0xPd86TBctrNFJHIMV4LD/eb7b.jpeg?fl=res,1024,768,1"],"last_seen":"2026-10-27","lat":50.088508741897,"lift":true,"loggia":null,"lon":14.3994213186039,"offer":"rent","ownership":"personal","parking":null,"penb":"G","pets":null,"price":34000,"price_czk":34000,"price_m2":895,"private":false,"quarter":"Malá Strana","quarter_median_m2":534,"source":"sreality","source_id":"3795198028","street":"Nerudova","terrace":null,"title":"Pronájem bytu 2+kk 38 m²","url":"https://www.sreality.cz/detail/pronajem/byt/2+kk/praha-mala-strana-nerudova/3795198028"},"sreality-420282444":{"address":"Slezská, Praha 3, Vinohrady","also_on":[],"area":24,"available_from":"2026-12-07","balcony":null,"cellar":true,"charges":null,"condition":"very_good","construction":"brick","currency":"CZK","deposit":null,"description":"<p>Nabízíme moderní byt 1+kk k pronájmu o velikosti 24 m² situovaný v 1. NP rezidenční budovy s výtahem. Nemovitost se nachází ve vyhledávané lokalitě Prahy 2 - Vinohrady, disponující veškerou občanskou vybaveností a dobrou dopravní infrastrukturou.</p><p><br></p><p>Tento zařízený byt 1+kk k pronájmu dispozičně nabízí obývací pokoj s plně vybaveným kuchyňský koutem včetně jídelního prostoru a ložnicové části. Dále se v bytě nachází koupelna v mramorovém dekoru s černými prvky, jež disponuje sprchovým koutem a pračkou se sušičkou. K bytu náleží sklep.</p><p><br></p><p>Byt je plně zařízený a nabízí dostatek úložného prostoru a pohodlí. Kuchyňský kout je plně vybaven (sklokeramická deska, lednice, mrazák, mikrovlnná trouba a myčka nádobí)</p><p><br></p><p>Vinohrady jsou jedna z nejžádanějších pražských lokalit. Mají skvělou polohu, kde vše potřebné najdete do 10 minut chůze. Oblast má výbornou dopravní dostupnost - 2 stanice metra - Náměstí Míru a I.P. Pavlova, několik tramvajových linek a autobusy. Na Václavské náměstí se MHD dostanete už za 5 minut. Dobré je i silniční napojení. Na&nbsp;dálniční okruh dojedete autem už za 12 minut a na letiště Václava Havla za 27 minut. V okolí domu je kompletní občanská vybavenost - lékárna, poliklinika, pošta, supermarkety, úřady, banky, lokální obchody, restaurace a bary. V&nbsp;blízkosti se nacházejí mateřské, základní a střední školy, vysoká škola a dětská hřiště. Pro volnočasové aktivity můžete využít Havlíčkovy a Riegrovy sady s&nbsp;krásnými výhledy na Prahu.</p><p><br></p><p>Poptávající klient je srozuměn s úhradou provize ve výši 1 měsíčního nájmu plus DPH.</p><p><br></p><p>Pokud si nemovitost nemůžete prohlédnout osobně, nabízíme Vám také videoprohlídku z pohodlí Vašeho domova v reálném čase přes Messenger, WhatsApp a další komunikační platformy.</p>","detail_done":true,"disp":"1+kk","district":2,"first_seen":"2026-10-27","floor":0,"floors_total":6,"furnished":"yes","garage":null,"heating":null,"history":[["2026-10-27",18000]],"id":"sreality-420282444","images":["https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkDyuEmi2hIMVy06/4b75.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nQO0xPd86Tw5RPULIMVy1e/38de.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nQO0xPd86TkUyxB5xIMVy19/a30d.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nQO0xPd86TnJSEBvrIMVy2l/85d1.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkbxLFRn3IMVy3K/dd8b.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkCfcGaOZ7IMVy3q/8fe2.jpeg?fl=res,1024,768,1"],"last_seen":"2026-10-27","lat":50.0762876968393,"lift":true,"loggia":null,"lon":14.4519508356482,"offer":"rent","ownership":"personal","parking":null,"penb":"G","pets":null,"price":18000,"price_czk":18000,"price_m2":750,"private":false,"quarter":"Vinohrady","quarter_median_m2":549,"source":"sreality","source_id":"420282444","street":"Slezská","terrace":null,"title":"Pronájem bytu 1+kk 24 m²","url":"https://www.sreality.cz/detail/pronajem/byt/1+kk/praha-vinohrady-slezska/420282444"},"sreality-589234252":{"address":"Arnošta Staňka, Praha 10, Hostivař","also_on":[],"area":41,"available_from":null,"balcony":null,"cellar":null,"charges":null,"condition":null,"construction":null,"currency":"CZK","deposit":null,"description":null,"detail_done":false,"disp":"2+kk","district":10,"first_seen":"2026-10-27","floor":null,"floors_total":null,"furnished":null,"garage":null,"heating":null,"history":[["2026-10-27",22100]],"id":"sreality-589234252","images":["https://d18-a.sdn.cz/d_18/c_img_qG_D/kPyfG4fPEeCsx6aD43fILzrpc/6590.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nCXhmtHPUCaRY