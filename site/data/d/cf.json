8zYf/41e2.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kPyfG4fPEeD8XKqVLBIJ8zZT/eae3.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kPyfG4fPEeDb3WcTS5IJ8zaK/f09b.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nCXhmtHPUB6IMDxbhIJ8zap/75af.jpeg?fl=res,1024,768,1"],"last_seen":"2026-10-27","lat":50.1401770214,"lift":null,"loggia":null,"lon":14.4453476468,"offer":"rent","ownership":null,"parking":null,"penb":null,"pets":null,"price":28000,"price_czk":28000,"price_m2":354,"private":null,"quarter":"Dolní Chabry","quarter_median_m2":419,"source":"sreality","source_id":"1260789836","street":"Poštova","terrace":null,"title":"Pronájem bytu 3+kk 79 m²","url":"https://www.sreality.cz/detail/pronajem/byt/3+kk/praha-dolni-chabry-postova/1260789836"},"sreality-1815871564":{"address":"U družstva Život, Praha 4, Nusle","also_on":[{"price_czk":18990,"source":"realitymix","url":"https://realitymix.cz/detail/praha/podnajem-byt-1-1-56-m2-praha-4-nusle-ul-u-druzstva-zivot-8734101.html"}],"area":56,"available_from":"2026-10-27","balcony":null,"cellar":null,"charges":null,"condition":"very_good","construction":"brick","currency":"CZK","deposit":null,"description":"Vzhledem ke zvýšené poptávce o námi nabízené nemovitosti prosíme všechny vážné zájemce, aby nás pro rychlé vyřízení kontaktovali pomocí odpovědního formuláře u inzerátu. Následně Vám zašleme email s odkazem na krátký osobní dotazník. Po jeho vyplnění se vám ozveme a domluvíme se na dalším postupu a termínu prohlídky.\r\n\r\nRádi bychom vám představili prostorný a vzdušný byt o dispozici 1+1 s velkorysou výměrou 55,3 m², který se nachází ve zvýšeném přízemí udržovaného cihlového domu v klidné ulici U družstva Život. Byt představuje ideální volbu pro jednotlivce nebo pár, kteří ocení pohodlí komornějšího bydlení s výborným zázemím přímo na rozhraní oblíbených Nuslí a Pankráce. \r\n\r\nDispozice bytu nabízí samostatnou prostornou kuchyni s jídelní částí a velký, světlý obytný pokoj, který hravě pojme spací i odpočinkovou či pracovní zónu. Součástí je také koupelna a vstupní chodba. \r\n\r\nLokalita vyniká skvělou dopravní dostupností i bohatým společenským vyžitím. Na metro C (Pankrác i Pražského povstání) dojdete za 7–10 minut pěšky a tramvaje ze zastávek Palouček či Nuselská radnice vás během chvilky dopraví na Karlovo náměstí i I. P. Pavlova. V pěším dosahu najdete nákupní centrum Arkády Pankrác i pestrý výběr bister, kaváren a restaurací, kterými jsou moderní Nusle proslulé. Pro chvíle odpočinku, sport nebo kulturu skvěle poslouží nedaleký park Jezerka s rybníčkem a známým divadlem, případně park na Pankráci či historický Vyšehrad.\r\n\r\nByt je k nastěhování ihned.\r\nUvádíme energetickou náročnost G – jelikož nemáme doloženo PENB.\r\n\r\nBydlete se Stálým Nájmem. ️\r\n\r\nStalo se vám někdy, že pronajímatel neměl čas se Vám věnovat?\r\nS námi se to nestane – jsme vám k dispozici každý všední den od 9 do 17 hodin.\r\nZajistíme převody energií, pojištění, vyúčtování a když se něco přihodí společně to vyřešíme.\r\nI když jen potřebujete poradit nebo si ujasnit nějaký detail - jsme tu pro Vás","detail_done":true,"disp":"1+1","district":2,"first_seen":"2026-10-27","floor":0,"floors_total":null,"furnished":"partly","garage":null,"heating":null,"history":[["2026-10-27",18990]],"id":"sreality-1815871564","images":["https://d18-a.sdn.cz/d_18/c_img_qG_D/nQO0xPd86TnJSEDGQIMXaoP/481c.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nQO0xPd86TnJSEDVfIMXaok/91a7.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkDyuEmnE1IMXao6/02d3.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkbxLFR8iIMXapT/54da.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nQO0xPd86Tw5RPG4pIMXaqA/1c5d.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nQO0xPd86TBctrNHQGIMXaqb/23a1.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nQO0xPd86TDhsIbKEnIMXaqu/e4b2.jpeg?fl=res,1024,768,1","https://