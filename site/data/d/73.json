d86TBgJSgD3mIMXB0A/db5a.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkB87eWOEIIMXB0v/a47b.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkBcInfJuFIMXB1g/bc30.jpeg?fl=res,1024,768,1"],"last_seen":"2026-10-27","lat":50.0685403049094,"lift":null,"loggia":null,"lon":14.4507591607445,"offer":"rent","ownership":null,"parking":null,"penb":null,"pets":null,"price":35160,"price_czk":35160,"price_m2":703,"private":null,"quarter":"Vršovice","quarter_median_m2":491,"source":"sreality","source_id":"2117469004","street":"Rostovská","terrace":null,"title":"Pronájem bytu 2+kk 50 m²","url":"https://www.sreality.cz/detail/pronajem/byt/2+kk/praha-vrsovice-rostovska/2117469004"},"sreality-2757898316":{"address":"Žitomírská, Praha 10, Vršovice","also_on":[],"area":58,"available_from":"2026-11-01","balcony":null,"cellar":null,"charges":4500,"condition":"renovated","construction":"brick","currency":"CZK","deposit":56000,"description":"Exkluzivně nabízíme k pronájmu zcela nový, světlý a nadstandardně provedený byt 2+kk o výměře 58 m², situovaný v kompletně a citlivě zrekonstruovaném činžovním domě v atraktivní lokalitě na pomezí Vršovic a Vinohrad.\nInteriér bytu byl navržen s důrazem na čistý moderní design, kvalitní materiály a maximální komfort každodenního bydlení. Dominantou obytného prostoru je nová kuchyňská linka vyrobená na míru, vybavená kompletní sadou vestavěných spotřebičů – indukční varnou deskou, horkovzdušnou troubou, mikrovlnnou troubou, myčkou nádobí a lednicí s mrazákem.\nDostatek úložného prostoru zajišťují vestavěné skříně vyrobené na míru. Byt bude kompletně vybaven novým, pečlivě vybraným nábytkem. Nábytek zobrazený na fotografiích je přesně ten, kterým bude byt vybaven, a fotografie tak věrně představují jeho finální podobu. Byt bude připraven ke komfortnímu bydlení bez nutnosti dalšího zařizování.\nK vysokému standardu bytu přispívá také klimatizace. Podlahy tvoří elegantní dřevěné parkety v kombinaci s moderní velkoformátovou dlažbou.\nVýznamnou předností je rovněž samotný dům, který prošel kompletní rekonstrukcí, při níž byl zachován charakter tradiční pražské činžovní architektury a zároveň vytvořen komfort odpovídající současným nárokům na moderní městské bydlení.\nVyhledávaná poloha na rozhraní Vinohrad a Vršovic nabízí příjemné městské prostředí s množstvím restaurací, kaváren, obchodů a služeb a zároveň výbornou dostupnost do centra Prahy.\nVýjimečná nabídka pro nájemce, kteří hledají zcela nové, reprezentativní a kompletně vybavené bydlení v jedné z nejoblíbenějších pražských lokalit.","detail_done":true,"disp":"2+kk","district":10,"first_seen":"2026-10-27","floor":4,"floors_total":null,"furnished":null,"garage":null,"heating":null,"history":[["2026-10-27",28000]],"id":"sreality-2757898316","images":["https://d18-a.sdn.cz/d_18/c_img_qF_D/nOdL4BtPEyBFnmYDyvH3xzHr/e93c.png?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_D/k0OqwCKRD1EvuBVqH3xzWq/5ca7.png?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_D/nOdL4BtPEyBHthwET8H3xzNl/81a0.png?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_D/nOdL4BtPEyCly89BGsH3JC9W/6d7b.png?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_B/k0OqwCKRDgcHsCZJHt8aZU/b16a.png?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_B/nOdL4BtPEyC2Er4WyHt8aQC/829e.png?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_D/k0OqwCKREBG8FBiGH3NmCT/d6f9.png?fl=res,1024,768,1"],"last_seen":"2026-10-27","lat":50.06784214845221,"lift":true,"loggia":null,"lon":14.455440762766369,"offer":"rent","ownership":"personal","parking":null,"penb":"C","pets":null,"price":28000,"price_czk":28000,"price_m2":483,"private":false,"quarter":"Vršovice","quarter_median_m2":491,"source":"sreality","source_id":"2757898316","street":"Žitomírská","terrace":null,"title":"Pronájem bytu 2+kk 58 m²","url":"https://www.sreality.cz/detail/pronajem/byt/2+kk/praha-vrsovice-zitomirska/2757898316"},"sreality-3089375308":{"address":"Dlouhá, Praha 1, Staré Město","a