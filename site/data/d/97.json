fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkDyuEmk8dIMWJni/8735.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90"],"last_seen":"2026-10-27","lat":50.115911333182,"lift":null,"loggia":null,"lon":14.4894760201789,"offer":"rent","ownership":null,"parking":null,"penb":null,"pets":null,"price":20900,"price_czk":20900,"price_m2":380,"private":null,"quarter":"Prosek","quarter_median_m2":420,"source":"sreality","source_id":"1125494860","street":"Na rozhraní","terrace":null,"title":"Pronájem bytu 1+1 55 m²","url":"https://www.sreality.cz/detail/pronajem/byt/1+1/praha-prosek-na-rozhrani/1125494860"},"sreality-2461798476":{"address":"U Plynárny, Praha 4, Michle","also_on":[{"price_czk":30600,"source":"realitymix","url":"https://realitymix.cz/detail/praha/pronajem-bytu-3-kk-62-m-praha-michle-8720937.html"}],"area":62,"available_from":"2026-11-01","balcony":true,"cellar":true,"charges":null,"condition":"new","construction":"skeleton","currency":"CZK","deposit":null,"description":"K dlouhodobému pronájmu krásmý byt 3+kk o velikosti 62m2 s lodžií 12m2 a s balkonem 4m2 v novém rezidenčním komplexu Bohdalecké kvarteto.\r\n\r\nTypické je zde využití přírodních materiálů a udržitelných technologií, které zajišťují zdravé vnitřní mikroklima a jsou šetrné k životnímu prostředí.\r\n\r\nByt je vybaven vestavěnými skříněmi, kuchyňskou linkou, kombinovanou lednicí s mrazákem, myčkou ( šířka 60 cm ), varnou deskou, elektrickou troubou a digestoří.\r\n\r\nZ obývací části i z ložnice je přímý vstup na prostornou lodžii.\r\n\r\nMezi základní standardy patří automatický systém řízeného větrání s rekuperací tepla a předokenni žaluzie.\r\n\r\nK dispozici je vnitroblok s relaxačními prvky, který je osázený zelení a stromy, nedaleko je lesopark Bohdalecký vrch a vyhlášený Hamerský rybník.\r\n\r\nLokalita má skvělou dopravní dostupnost, v bezprostřední blízkosti areálu jsou zastávky MHD Plynárna Michle a Chodovská, na Václavské náměstí se lze dopravit během 15 minut.\r\n\r\nV blízkém okolí je výborná občanská vybavenost.\r\n\r\nParkování je zajištěno v podzemních garážích, cena za pronájem jednoho parkovacího stání je 1.500 Kč měsíčně.\r\n\r\nSoučástí pronájmu bytu je sklepní komora o velikosti 3m2.\r\n\r\nMěsíční zálohové poplatky činí 6.319 Kč včetně internetu plus elektřina ( doporučená záloha 1.200 Kč měsíčně)","detail_done":true,"disp":"3+kk","district":4,"first_seen":"2026-10-27","floor":7,"floors_total":null,"furnished":"no","garage":null,"heating":null,"history":[["2026-10-27",30600]],"id":"sreality-2461798476","images":["https://d18-a.sdn.cz/d_18/c_img_qG_B/nCR9NVflLwO7jgA4IDg0bY/9b9b.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_B/kcKfrMAkFW9k4MaLIDg0b8/adf6.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_B/kcKfrMAkFB3JsT4ypIDg0ch/3b19.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_B/kcKfrMAkFB3JsT5HmIDg0dJ/d2aa.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_B/kcKfrMAkFCpZ9wCNTIDg0do/439b.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_B/nCR9NVflLCNT9cB7gIDg0eV/61cb.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_B/kcKfrMAkFDzJCCjeBIDg0fL/afeb.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_B/kcKfrMAkFDvG5qoMSIDg0fn/6272.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_B/nCR9NVflLnoRVXPKIDg0gX/68dc.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_B/kcKfrMAkFDvG5qoOKIDg0hG/9f4a.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|j