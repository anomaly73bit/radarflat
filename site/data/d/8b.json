2-rxpjmelcwm-img-4465.jpg","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/861k/861613/1726321204-lsfhamnfcx-img-4466.jpg","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/861k/861613/1726322090-ktzdmgbzsl-img-4478.jpg"],"last_seen":"2026-10-27","lat":50.0544562,"lift":true,"loggia":null,"lon":14.4832576,"offer":"rent","ownership":"personal","parking":true,"penb":"C","pets":null,"price":21000,"price_czk":21000,"price_m2":512,"private":true,"quarter":"Záběhlice","quarter_median_m2":401,"source":"bezrealitky","source_id":"861613","street":"Podle Náhonu","terrace":null,"title":"Pronájem bytu 2+kk • 41 m² • Podle Náhonu • Praha - Záběhlice • bez RK","url":"https://www.bezrealitky.cz/nemovitosti-byty-domy/861613-nabidka-pronajem-bytu-podle-nahonu-praha"},"realitymix-8410987":{"address":"Štěpařská, Praha 5, Hlubočepy","also_on":[],"area":68,"available_from":null,"balcony":null,"cellar":null,"charges":null,"condition":"very_good","construction":"brick","currency":"CZK","deposit":null,"description":"Popis nemovitosti Pronájem bytu 2+kk, Štěpařská, Hlubočepy, 68 m2 K dlouhodobému podnájmu Vám nabízíme krásný, světlý, částečně zařízený byt o dispozici 2+kk s celkovou výměrou 68m2 s komorou a balkonem. Byt se nachází ve 5.NP cihlového domu, který je součástí rezidenčního bydlení na pražském Barrandově. Byt se skládá z centrální, vstupní chodby, velké komory, samostatné toalety, koupelny zařízené vanou, pračkou, umyvadlem a drobným koupelnovým nábytkem. Obývací pokoj se vstupem na balkón, s nádherným výhledem do zeleně a dále na Prahu. Ložnice, rovněž s výhledem do zeleně je zařízena velkou, vestavnou šatní skříní. Zcela nová kuchyňská linka, zhotovená na míru je vybavena všemi vestavnými spotřebiči - lednice s mrazákem, myčka, vestavná mikrovlnná trouba, sklokeramická varná deska, odtahová digestoř a trouba. Byt se nachází v klidné, přesto velmi dobře dopravné dostupné lokalitě s kompletní občanskou vybaveností na dosah, na pražském Barrandově - jen pár kroků od domu je hypermarket Albert. Necelých 5 minut chůze se nachází tramvajová zastávka Poliklinika Barrandov s přímým spojením na Smíchov, kam se dostanete za cca 15 minut. Dále zde najdete kompletní síť menších obchodů a služeb, základní i mateřské školy. Zdravotnické zařízení Poliklinika Barrandov je od domu 5 minut chůze, stejně tak Aqua Park Barrandov. Pro vycházky a sportovní vyžití je Vám k dispozici nedaleké Prokopské údolí, které je vzdálené 10 minut chůze od domu. K bytu je možné pronajmout garážové parkovací stání, umístěné ve vedlejším domě. Byt je k dispozici k okamžitému, dlouhodobému bydlení.","detail_done":false,"disp":"2+kk","district":5,"first_seen":"2026-10-27","floor":5,"floors_total":5,"furnished":null,"garage":null,"heating":null,"history":[["2026-10-27",28900]],"id":"realitymix-8410987","images":["https://st.realitymix.cz/i/66677944/7704759/nab_502268515_detail.jpg","https://st.realitymix.cz/i/66679876/8029076/nab_501465737_detail.jpg","https://st.realitymix.cz/i/66683705/8606809/nab_501884695_detail.jpg","https://st.realitymix.cz/i/66670288/8632759/nab_498958847_detail.jpg"],"last_seen":"2026-10-27","lat":50.0321,"lift":null,"loggia":null,"lon":14.373533333333,"offer":"rent","ownership":"personal","parking":null,"penb":"B","pets":null,"price":28900,"price_czk":28900,"price_m2":425,"private":false,"quarter":"Hlubočepy","quarter_median_m2":438,"source":"realitymix","source_id":"8410987","street":"Štěpařská","terrace":null,"title":"Pronájem bytu, 2+kk, 68 m²","url":"https://realitymix.cz/detail/praha/pronajem-bytu-2-kk-steparska-hlubocepy-68-m2-8410987.html"},"realitymix-8501133":{"address":"V dolině, Praha 10","also_on":[],"area":49,"available_from":null,"balcony":null,"cellar":null,"charges":null,"condition":null,"construction":null,"currency":"CZK","deposit":null,"description":null,"detail_done":false,"disp":"2+1","district":10,"first_seen":"2026-10-27","floor":8,"floors_total":14,"furnished":null,"garage":null,"heati