, samostatnou toaletu pro hosty, technickou komoru a lodžii s výhledem do vnitrobloku.\r\n\r\nZachované původní prvky, dřevěné podlahy, velká špaletová okna, mozaikové obklady v koupelnách, množství úložných prostor, myčka, pračka, sušička, plynové vytápění. Možnost pronájmu garážového stání s velkým úložným prostorem za 3.500 Kč/měs.","detail_done":true,"disp":"3+kk","district":6,"first_seen":"2026-10-27","floor":4,"floors_total":null,"furnished":"yes","garage":true,"heating":null,"history":[["2026-10-27",55000]],"id":"sreality-924848204","images":["https://d18-a.sdn.cz/d_18/c_img_qG_C/kPw320bnC5lmsPFCyII0hNq/cb68.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_C/nPQ64TBsMvBQugUIBmII0hWJ/014d.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_C/kPw320bnC5lmsPFHAII0heZ/1943.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_C/nPQ64TBsMvBXFDPGCKII0hmz/cb0a.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_C/kPw320bnC5lmsPFHAII0hvK/08ee.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_C/nPQ64TBsMvDLsWDGZgII0h3j/5826.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_C/nPQ64TBsMvBXFDPF5DII0iCG/2cce.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_C/kOdFH5t9SRDfAvxUPII0iL4/53ae.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_C/kOdFH5t9SRsdBgUPII0iVk/a0fa.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_C/kOdFH5t9SRBfiQyURII0ifZ/9f72.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_C/nPQ64TBsMvBQugUILNII0in