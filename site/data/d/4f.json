pozici za poplatek 2 500 Kč / měs. + DPH\r\n•\tSklepní kóje k dispozici za poplatek od 700 Kč / měs. + DPH\r\n•\tV budově je 24/7 recepce / ostraha, kamerový systém\r\n•\tK dispozici je společná střešní terasa s výhledem na Prahu.\r\n\r\nProvize za zprostředkování se neplatí.\r\n\r\nFotografie jsou pouze ilustrativní!\r\n\r\nDostupnost: K nastěhování od 15.11.2026.","detail_done":true,"disp":"1+kk","district":5,"first_seen":"2026-10-27","floor":3,"floors_total":null,"furnished":"yes","garage":true,"heating":null,"history":[["2026-10-27",20100]],"id":"sreality-3828617292","images":["https://d18-a.sdn.cz/d_18/c_img_qG_C/nPQ64TBsMvCorp5UUIHtjuK/46f2.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_C/kO1NtbE1zwLuBeUSIHtju1/82e3.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_C/kO1NtbE1zwD7vcrUTIHtjvc/e5bf.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_C/kO1NtbE1zwCMHsAUTIHtjwF/91dc.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_C/nPQ64TBsMvDLsWDURIHtjwo/c830.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_C/kO1NtbE1zwCMHsAUSIHtjxM/d0ac.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_C/nPQ64TBsMvBXFDPUNIHtjxo/320e.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_C/kO1NtbE1zwnEzzURIHtjyE/3176.jpeg?fl=res,1024,768,1"],"last_seen":"2026-10-27","lat":50.0529839048,"lift":true,"loggia":null,"lon":14.4094639926,"offer":"rent","ownership":"personal","parking":null,"penb":"A","pets":null,"price":20100,"price_czk":20100,"price_m2":718,"private":false,"quarter":"Smíchov","quarter_median_m2":500,"source":"sreality","source_id":"3828617292","street":"U Lihovaru","terrace":null,"title":"Pronájem bytu 1+kk 28 m²","url":"https://www.sreality.cz/detail/pronajem/byt/1+kk/praha-smichov-u-lihovaru/3828617292"},"sreality-617746508":{"address":"Nad Ryšánkou, Praha 4, Krč","also_on":[],"area":61,"available_from":null,"balcony":null,"cellar":null,"charges":null,"condition":null,"construction":null,"currency":"C