ským koutem, malá ložnice, koupelna se sprchovým koutem a toaletou a vstupní chodba. \r\n\r\nRepasované parkety, dlažba, elektrické vytápění, myčka, indukční varná deska.","detail_done":true,"disp":"2+kk","district":1,"first_seen":"2026-10-27","floor":4,"floors_total":null,"furnished":"no","garage":null,"heating":null,"history":[["2026-10-27",24000]],"id":"sreality-2638151756","images":["https://d18-a.sdn.cz/d_18/c_img_qG_D/nQO0xPd86TBgJSgGZ4IMZ9T2/3b76.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkCJCefPGwIMZ9b4/19d5.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nQO0xPd86TBgJSgGaWIMZ9jK/3de5.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nQO0xPd86TBgJSgGaWIMZ9rQ/bc14.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nQO0xPd86TBctrNK2qIMZ9yt/0eb1.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkB87eWOcZIMZ96p/61c9.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkCfcGaQooIMaAEq/8039.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkC4TclQV5IMaAMo/3607.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkCfcGaQ7EIMaAUj/b41f.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdk3RI9QwdIMaAcr/4b27.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nQO0xPd86TnJSEFMZIMaAkP/9796.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkBcInfLPpIMaAsU/7b73.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkBQkMFlBUIMaAz7/6855.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdk3RI9O8dIMaA77/4974.jpeg?fl=res,1024,768,1"],"last_seen":"2026-10-27","lat":50.0772653326249,"lift":true,"loggia":null,"lon":14.4258380419002,"offer":"rent","ownership":"personal","parking":null,"penb":"G","pets":null,"price":24000,"price_czk":24000,"price_m2":558,"private":false,"quarter":"Nové Město","quarter_median_m2":513,"source":"sreality","source_id":"2638151756","stre