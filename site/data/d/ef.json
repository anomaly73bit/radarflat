omě je výtah i prostorné schodiště a také tu najdete kolárnu a sušárnu. K bytu je nabízen také sklep. Měsíční poplatky jsou ve výši 4906,-. Plyn a elektřina budou převedeny na nájemce.\r\nDo bytu hledáme dlouhodobé klidné a spolehlivé nájemníky, nehledáme zájemce o spolubydlení.\r\nPronajímající si vyhrazuje právo vybrat nájemce na základě jím zvolených kritérií.","detail_done":true,"disp":"2+1","district":2,"first_seen":"2026-10-27","floor":3,"floors_total":7,"furnished":null,"garage":null,"heating":null,"history":[["2026-10-27",33000]],"id":"sreality-327487564","images":["https://d18-a.sdn.cz/d_18/c_img_qG_D/kPyfG4fPEeCsx6aDtLNILrzK8/f329.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_D/kPyfG4fPEeC2yv3BYqFILrzLu/c86a.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_D/nCXhmtHPUD8nezBNXRILrzMY/c9fb.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_D/nCXhmtHPUB6IMDDPDKILrzNC/269e.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_D/nCXhmtHPUB13CvBJnNILrzNm/09d1.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_D/nCXhmtHPUBL8BsDVxrILrzON/2fae.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_D/kPyfG4fPEeD8XKqBNUNILrzO9/d696.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_D/nCXhmtHPUCHypVBC21ILrzPm/5448.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_D/nCXhmtHPUD9QxwBFDOILrzQS/8ab4.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_D/kPyfG4fPEeC2yv3BX4UILrzRD/6f0d.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18