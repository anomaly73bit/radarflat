liben-vosmikovych/246464588"},"sreality-3011051596":{"address":"Husitská, Praha 8","also_on":[],"area":20,"available_from":null,"balcony":null,"cellar":null,"charges":null,"condition":null,"construction":null,"currency":"CZK","deposit":null,"description":null,"detail_done":false,"disp":"room","district":8,"first_seen":"2026-10-27","floor":null,"floors_total":null,"furnished":null,"garage":null,"heating":null,"history":[["2026-10-27",19000]],"id":"sreality-3011051596","images":["https://d18-a.sdn.cz/d_18/c_img_qG_C/kOdFH5t9SRBfiQyhdII5CMX/35c6.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_C/ncz4PZ5CZDjuOX7UII5CMr/b5ad.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_C/kOdFH5t9SR3dPwfDII5CMj/cd32.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_C/ncz4PZ5CZCgVhboHII5CMh/158a.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_C/ncz4PZ5CZ4EaddfII5CMf/6079.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_C/kOdFH5t9SRBBtBFqhII5CLv/f1a8.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_C/ncz4PZ5CZCgVhbo4II5CNE/ddae.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_C/kOdFH5t9SRsdBgmpII5CMc/d86d.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_C/kOdFH5t9SRDfAvxqXII5CLr/e4c3.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_C/ncz4PZ5CZBDO8VZAII5CMo/757e.jpeg?fl=res,1024,768,1"],"last_seen":"2026-10-27","lat":50.08683549836289,"lift":null,"loggia":null,"lon":14.445433322790176,"offer":"rent","ownership":null,"parking":null,"penb":null,"pets":null,"price":19000,"price_czk":19000,"price_m2":950,"private":null,"quarter":null,"quarter_median_m2":null,"source":"sreality","source_id":"3011051596","street":"Husitská","terrace":null,"title":"Pronájem bytu pokoje 20 m²","url":"https://www.sreality.cz/detail/pronajem/byt/Pokoj/praha-husitska/3011051596"},"sreality-3257815884":{"address":"Počernická, Praha 10, Malešice","also_on":[{"price_czk":22000,"source":"realitymix","url":"https://realitymix.cz/detail/praha/pronajem-bytu-2-1-pocernicka-malesice-55-m2-8524047.html"}],"area":55,"available_from":"2026-11-01","balcony":null,"cellar":null,"charges":null,"condition":"renovated","construction":"panel","currency":"CZK","deposit":null,"description":"Tento světlý byt o dispozici 2+1 v žádané lokalitě pražských Malešic představuje ideální volbu pro ty, kteří hledají komfortní dlouhodobé bydlení v klidném prostředí s veškerým městským zázemím na dosah. Jednotka o celkové výměře 55 m² se nachází ve druhém patře pečlivě udržovaného bytového domu s výtahem, přičemž velkým benefitem v této oblasti je vlastní parkovací stání náležící k bytu.\r\n\r\nInteriér je nabízen jako nezařízený, což budoucím nájemníkům otevírá prostor pro realizaci vlastních představ a vytvoření skutečného domova podle osobního vkusu. Srdcem bytu je prostorná a prosvětlená obývací část, která hravě pojme velkorysou sedací soupravu i jídelní kout pro společné chvíle. Kuchyně je plně připravena k okamžitému užívání a je vybavena všemi nezbytnými spotřebiči včetně lednice s mrazákem, sporáku, mikrovlnné trouby a digestoře s dostatkem úložných prostor. Soukromí zajišťuje samostatná neprůchozí ložnice a moderně řešená koupelna se sprchovým koutem, toaletou a pračkou.\r\n\r\nLokalita Počernické ulice vyniká perfektní kombinací přírody a služeb. Doslova pár kroků od domu naleznete supermarket Lidl, poštu, široký výběr restaurací, kaváren i komplexní lékařskou péči na blízké poliklinice. Pro milovníky aktivního odpočinku se v bezprostřední blízkosti nachází oblíbený Malešický park s vodními prvky a rozsáhlý Malešický les. Vynikající dopravní spojení do centra města i na metro zajišťuje blízká autobusová zastávka a nově vybudovaná tramvajová trať. \r\n\r\nByt je volný k nastěhování od 01.11.2026\r\n\r\nEnergetická třída: G (průkaz nedodán).","detail_done":true,"disp":"2+1","district":10,"first_seen":"2026-10-27","floor":3,"floors_total":7,"furnished":"no","garage":null,"heating":null,"history":[["2026-