dlahy, velkoformátová dlažba, elektrický kotel, podlahové vytápění, myčka, vestavěné skříně, krbová kamna.","detail_done":true,"disp":"4+kk","district":6,"first_seen":"2026-10-27","floor":1,"floors_total":null,"furnished":"no","garage":null,"heating":null,"history":[["2026-10-27",49500]],"id":"sreality-940449868","images":["https://d18-a.sdn.cz/d_18/c_img_qF_D/nOdL4BtPEyvOo9VaH19Bch/9e89.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_D/nOdL4BtPEyC2Er4BD2H19Bk2/6b63.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_D/nOdL4BtPEyC2Er4BD6H19Bt3/38c9.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_D/nOdL4BtPEyBiPBFocH19B2S/f946.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_D/nOdL4BtPEyBiPBFo0H19CAo/bf29.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_D/nOdL4BtPEyD4lWfVZH19CIO/538a.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_D/nOdL4BtPEyDrQHrVLH19CRR/c683.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_D/nOdL4BtPEyD4lWfVTH19CYt/5782.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_D/nOdL4BtPEyvOo9VaH19CgX/970d.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_D/k0OqwCKRZSJdVRH19Cog/a603.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_D/k0OqwCKRDgcHsVSH19CwX/061c.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_D/nOdL4BtPEyvOo9VZH19C40/42d9.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_D/k0OqwCKRCO7AFBGDH19DCc/15c9.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_D/nOdL4BtPEyBiPBFVPH19DKg/26b2.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_D/nOdL4BtPEyCly89VYH19DSP/84fc.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_D/nOdL4BtPEyBHthwVPH19Da9/586d.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_D/k0OqwCKRB7OXgoRH19Dkc/7635.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_D/k0OqwCKRCO7AFVNH19DtJ/b1e3.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_D/k0OqwCKRBO