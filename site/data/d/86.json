ardního prostoru, soukromé sauny, rozlehlé terasy orientované do vnitrobloku a jedné z nejžádanějších lokalit pražských Vinohrad.\nByt je k dispozici ihned.","detail_done":true,"disp":"atypical","district":3,"first_seen":"2026-10-27","floor":0,"floors_total":null,"furnished":null,"garage":null,"heating":null,"history":[["2026-10-27",39000]],"id":"sreality-955064396","images":["https://d18-a.sdn.cz/d_18/c_img_qF_D/k0OqwCKRIhAnVaH19GVU/e4fd.png?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_D/nOdL4BtPEyBiPBFooH19HPG/d067.png?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_D/k0OqwCKREB0TcVbH19KAW/1ab2.png?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_D/k0OqwCKRB7OXgoRH19GlY/e6b9.png?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_D/k0OqwCKREB0TcVYH19JXO/82e2.png?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_D/nOdL4BtPEyvOo9VYH19SBF/20d6.png?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_D/nOdL4BtPEyBiPBFVTH19Jm0/28c6.png?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_D/k0OqwCKRCO7AFVQH19RVx/e84e.png?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_D/k0OqwCKRDbeZQVeH19HcH/204d.png?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_D/nOdL4BtPEyBFnmYVdH19ICH/94cf.png?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_D/nOdL4BtPEyD4lWfVTH19IK0/5c3f.png?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_D/nOdL4BtPEyBiPBFo0H19Ho6/f421.png?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_D/nOdL4BtPEyDrQHriUH19H0m/0904.png?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_D/k0OqwCKREB0TcVYH19Ie2/8687.png?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_D/nOdL4BtPEyBiPBFooH19JMK/4c50.png?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_D/nOdL4BtPEyBFnmYVlH19Ioi/7751.png?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_D/nOdL4BtPEyC2Er4BD6H19IzA/5f2a.png?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qF_D/nOdL4BtPEyCly89VYH19JAW/64b5.png?fl=res,1024,768,1","https://d18-a.s