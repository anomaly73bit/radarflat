"district":8,"first_seen":"2026-10-27","floor":null,"floors_total":null,"furnished":null,"garage":null,"heating":null,"history":[["2026-10-27",59000]],"id":"realitymix-8632881","images":["https://st.realitymix.cz/i/66670288/8632881/nab_500814777_detail.jpg","https://st.realitymix.cz/i/66670288/8632881/nab_500814779_detail.jpg","https://st.realitymix.cz/i/66670288/8632881/nab_500814781_detail.jpg","https://st.realitymix.cz/i/66670288/8632881/nab_500814783_detail.jpg"],"last_seen":"2026-10-27","lat":null,"lift":null,"loggia":null,"lon":null,"offer":"rent","ownership":null,"parking":null,"penb":null,"pets":null,"price":59000,"price_czk":59000,"price_m2":396,"private":null,"quarter":"Libeň","quarter_median_m2":457,"source":"realitymix","source_id":"8632881","street":"Pomezní","terrace":null,"title":"Pronájem bytu, 4+1, 149 m²","url":"https://realitymix.cz/detail/praha/velkorysy-byt-se-zahradou-v-prvorepublikove-vile-8632881.html"},"realitymix-8708915":{"address":"U nádražní lávky, Praha 8, Karlín","also_on":[{"price_czk":40000,"source":"sreality","url":"https://www.sreality.cz/detail/pronajem/byt/3+kk/praha-karlin-u-nadrazni-lavky/803283020"}],"area":101,"available_from":null,"balcony":null,"cellar":null,"charges":null,"condition":"renovated","construction":"brick","currency":"CZK","deposit":null,"description":"Popis nemovitosti 3+kk, Praha 8 - Karlín, po rekonstrukci, 101 m2, Pronájem prostorného bytu o dispozici 3+kk s celkovou podlahovou plochou 101,5 m², který se nachází ve 2. patře klasického cihlového domu v jedné z nejžádanějších částí Prahy – Karlíně, v docházkové vzdálenosti od stanic metra Křižíkova i Florenc. Byt bude k nastěhování od 1.prosince. Byt je světlý a vzdušný, s velkými okny a vysokými stropy, které vytvářejí příjemnou atmosféru typickou pro činžovní domy této lokality. V obytných místnostech jsou zachovalé parkety, které dodávají interiéru eleganci a charakter. Dispozice bytu nabízí tři prostorné pokoje, které jsou vzájemně průchozí. Kuchyňský kout je vybaven kuchyňskou linkou se spotřebiči (varná deska, trouba, myčka, mikrovlnná trouba a lednice). V koupelně se nachází sprchový kout, umyvadlo a toaleta. Vytápění i ohřev vody zajišťuje vlastní plynový kotel, což umožňuje regulovat provozní náklady. Okna bytu jsou orientována na severozápad, díky velkým oknům je však byt velmi dobře prosvětlený po celý den. Parkování je možné v rezidentních modrých zónách v okolí domu. Karlín patří dlouhodobě mezi nejatraktivnější pražské čtvrti, s množstvím kaváren, restaurací, parků i kancelářských center. Lokalita nabízí výbornou dopravní dostupnost do centra města i kompletní občanskou vybavenost.","detail_done":true,"disp":"3+kk","district":8,"first_seen":"2026-10-27","floor":3,"floors_total":5,"furnished":null,"garage":null,"heating":null,"history":[["2026-10-27",40000]],"id":"realitymix-8708915","images":["https://st.realitymix.cz/i/66686032/8641685/nab_500177915_detail.jpg","https://st.realitymix.cz/i/4334281/8693515/nab_502284295_detail.jpg","https://st.realitymix.cz/i/66673308/8694179/nab_502140175_detail.jpg","https://st.realitymix.cz/i/66674185/8725139/nab_501862489_detail.jpg"],"last_seen":"2026-10-27","lat":null,"lift":null,"loggia":null,"lon":null,"offer":"rent","ownership":"cooperative","parking":null,"penb":"D","pets":null,"price":40000,"price_czk":40000,"price_m2":396,"private":false,"quarter":"Karlín","quarter_median_m2":569,"source":"realitymix","source_id":"8708915","street":"U nádražní lávky","terrace":null,"title":"Pronájem bytu, 3+kk, 101 m²","url":"https://realitymix.cz/detail/praha/3-kk-praha-8-karlin-po-rekonstrukci-101-m2-8708915.html"},"sreality-4228763724":{"address":"Ohradní, Praha 4, Michle","also_on":[],"area":138,"available_from":null,"balcony":null,"cellar":null,"charges":null,"condition":null,"construction":null,"currency":"CZK","deposit":null,"description":null,"detail_done":false,"disp":"4+kk","district":4,"first_seen":"2026-10-27","floor":null,"floors_total":null,"furnished":null,"garage