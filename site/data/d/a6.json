u, která naleží bytu. Ničím nerušené bydlení se nachází blízko metra Černý Most, kam se jednoduše lze dostat autobusovým spojem, který zastavuje přímo u domu.","detail_done":true,"disp":"2+kk","district":9,"first_seen":"2026-10-27","floor":null,"floors_total":null,"furnished":null,"garage":null,"heating":null,"history":[["2026-10-27",23000]],"id":"realitymix-8733407","images":["https://st.realitymix.cz/i/66677944/8400251/nab_502333271_detail.jpg","https://st.realitymix.cz/i/66677944/8423117/nab_500756263_detail.jpg","https://st.realitymix.cz/i/66668631/8674549/nab_497628433_detail.jpg","https://st.realitymix.cz/i/66678514/8707945/nab_500417955_detail.jpg"],"last_seen":"2026-10-27","lat":50.115423055556,"lift":null,"loggia":null,"lon":14.560714444444,"offer":"rent","ownership":"personal","parking":null,"penb":"G","pets":null,"price":23000,"price_czk":23000,"price_m2":460,"private":false,"quarter":"Kyje","quarter_median_m2":457,"source":"realitymix","source_id":"8733407","street":"Davidovičova","terrace":true,"title":"Pronájem bytu, 2+kk, 50 m²","url":"https://realitymix.cz/detail/praha/klidne-bydleni-s-privatni-zastresenou-terasou-zahradou-a-parkovacim-stanim-8733407.html"},"sreality-1071845452":{"address":"Radlická, Praha 5, Smíchov","also_on":[],"area":28,"available_from":null,"balcony":null,"cellar":null,"charges":null,"condition":null,"construction":null,"currency":"CZK","deposit":null,"description":null,"detail_done":false,"disp":"1+kk","district":5,"first_seen":"2026-10-27","floor":null,"floors_total":null,"furnished":null,"garage":null,"heating":null,"history":[["2026-10-27",19000]],"id":"sreality-1071845452","images":["https://d18-a.sdn.cz/d_18/c_img_qG_B/kcKfrMAkFB3JsT6fFIDo2ET/729a.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_C/nCR9NVflLCnfP0BdLPIHoI3i/f42c.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_B/kcKfrMAkFMsuhpRIIDo2Fd/08c6.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_B/nCR9NVflLwO7jhMqIDo2Bn/16af.jpeg?fl=