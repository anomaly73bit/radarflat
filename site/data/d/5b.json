,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qE_B/nPYADvcUkmBFAg3WgHd86ny/962f.png?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qE_B/kPVqmweP7JCkmYdWkHd88xs/449a.png?fl=res,1024,768,1"],"last_seen":"2026-10-27","lat":50.11975141901102,"lift":null,"loggia":null,"lon":14.453542118077927,"offer":"rent","ownership":null,"parking":null,"penb":null,"pets":null,"price":18900,"price_czk":18900,"price_m2":472,"private":null,"quarter":"Libeň","quarter_median_m2":457,"source":"sreality","source_id":"3913990220","street":"S. K. Neumanna","terrace":null,"title":"Pronájem bytu 2+kk 40 m²","url":"https://www.sreality.cz/detail/pronajem/byt/2+kk/praha-liben-s-k-neumanna/3913990220"},"sreality-4188479564":{"address":"Novoborská, Praha 9, Prosek","also_on":[{"price_czk":19900,"source":"realitymix","url":"https://realitymix.cz/detail/praha/pronajem-bytu-2-kk-novoborska-prosek-19-900-kc-mes-39-m2-7678186.html"}],"area":39,"available_from":"2026-12-01","balcony":true,"cellar":true,"charges":null,"condition":"very_good","construction":"panel","currency":"CZK","deposit":null,"description":"K dlouhodobému podnájmu nabízíme krásný byt po rekonstrukci o dispozici 2+kk v atraktivní lokalitě Praha - Prosek. Byt o celkové výměře 39 m2 se nachází ve třetím patře panelového domu s výtahem. K bytu dále patří i balkón s výhledem do zeleně a sklep.\r\n\r\nByt má navíc nové podlahy, dveře a výmalbu.\r\n\r\nByt se nabízí částečně vybavený. Pěkná kuchyně disponuje lednicí, vestavěnou elektrickou troubou, plynovým sporákem a digestoří. Obývací část je stejně jako ložnice nezařízená. Součástí koupelny je vana, umyvadlo, pračku a umyvadlo. V předsíni najdeme vestavěnou šatní skříň. \r\n\r\nV okolí domu jsou restaurace, základní a mateřská škola, gymnázium, pošta, Penny Market atd. Dopravní dostupnost je zajištěna autobusovou zastávkou Novoborská, která je vzdálená 100 metrů od domu. Metro Střížkov je vzdálené 10 minut chůze od domu. \r\n\r\nVolný k nastěhování od 1.12.2026 . Domácí mazlíčci jsou možní po domluvě. \r\n\r\nUvedena energetická kategorie G, jelikož nemáme k dispozici PENB.\r\n\r\nByt pronajímá Ideální nájemce - služba, se kterou budete bydlet bezstarostně a za férových podmínek. Když se něco přihodí, k dispozici jsou správci, kteří s vámi vše vyřeší. Pomůžeme s veškerou administrativou, s nastavením plateb a zajistíme vám speciální pojištění. Pojďte bydlet s námi!\r\n_____________\r\n\r\nNajděte bydlení bezkontaktně díky virtuální prohlídce a elektronickým podpisům.\r\n\r\nZavázali jsme se, že budeme z pronajímání dělat bezstarostnou záležitost, a svému slibu chceme dostát i v této nelehké situaci. Proto vám nabízíme možnost najít dlouhodobý pronájem bezpečně a bezkontaktně. Osobní či virtuální prohlídku bytu si u nás zarezervujete online a všechny dokumenty podepíšeme elektronicky. S jakýmkoliv dotazem vám pomůže naše posílené oddělení klientské podpory.","detail_done":true,"disp":"2+kk","district":9,"first_seen":"2026-10-27","floor":2,"floors_total":7,"furnished":"partly","garage":null,"heating":null,"history":[["2026-10-27",19900]],"id":"sreality-4188479564","images":["https://d18-a.sdn.cz/d_18/c_img_qG_B/kcKfrMAkFnIwlqytIDlmpe/260d.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_B/kcKfrMAkFMsuho7lIDlmp5/ee08.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_B/nCR9NVflLCnfP09y3IDlmqV/ae3d.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_B/nCR9NVflLCnfP09y3IDlmqx/efa3.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_B/kcKfrMAkFW9k4NcpIDlmrN/95b9.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_B/nCR9NVflLChOIjkoLIDlmrj/2185.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_B/nCR9NVflLBkdq1YdVIDlmsA/9dee.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_B/kcKfrMAkFCpZ9wC80IDlmtG/63ba.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_B/nCR9NVflLChOIjkoLIDlmtk/5816.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_B/kcKfrMAkFDvG5qouoIDlmuF/d1a4.jpeg?fl=