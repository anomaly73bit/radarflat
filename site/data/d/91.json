6e8.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_B/kcKfrMAkFCpZ9wJrvIEwRLZ/7313.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_B/nCR9NVflLCsdQ6LaeIEwRnw/02aa.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_B/nCR9NVflLrfprBBMuIEwSDR/4a7b.jpeg?fl=res,1024,768,1"],"last_seen":"2026-10-27","lat":50.053990563307295,"lift":null,"loggia":null,"lon":14.437334501274645,"offer":"rent","ownership":null,"parking":null,"penb":null,"pets":null,"price":29900,"price_czk":29900,"price_m2":729,"private":null,"quarter":"Nusle","quarter_median_m2":500,"source":"sreality","source_id":"162598988","street":"Na Pankráci","terrace":null,"title":"Pronájem bytu 2+kk 41 m²","url":"https://www.sreality.cz/detail/pronajem/byt/2+kk/praha-nusle-na-pankraci/162598988"},"sreality-1693253708":{"address":"Sedlářova, Praha 9, Kbely","also_on":[],"area":91,"available_from":"2026-12-07","balcony":null,"cellar":true,"charges":7,"condition":"new","construction":"brick","currency":"CZK","deposit":50000,"description":"Nabízíme exkluzivně k pronájmu byt 4+kk s terasou v posledním 6. NP budovy B (Bravo) nové rezidenční čtvrti Albatros Kbely (kolaudace 2023). \n\nByt o čisté podlahové ploše 91 m2 se skládá z prostorného obývacího pokoje (27 m2) a třech ložnic. V obývacím pokoji se nachází kuchyňská linka vybavená sklokeramickou varnou deskou, digestoří, el. troubou, mikrovlnnou troubou, lednicí s mrazákem a myčkou. Z obývacího pokoje lze vstoupit na terasu (29 m2) se stahovací markýzou na elektřinu. Tři samostatné ložnice (18, 14 a 11 m2) s východní orientací nabízí dostatek úložného prostoru ve vestavěných velkokapacitních skříních. Všechny obytné místnosti bytu mají zabudované klimatizační jednotky. Největší ložnice má svou vlastní koupelnu se sprchovým koutem (3 m2). Společná koupelna (4 m2) je vybavena vanou a dvěma umývadly. Obě koupelny mají vyhřívané podlahy. Pračka se sušičkou může být umístěna v komoře, která má přívod vody a odpad. V bytě je jedno samostatné WC s umyvadlem a jedno jako součást menší koupelny. Vstupní část předsíně je vybavena vestavěnou skříní (botníkem). \n\nK bytu přísluší také sklep v přízemí domu (1,6 m2) a možnost využívat parkovací stání č. 22. U parkovacího místa je nainstalována funkční dobíjecí stanice 11kW s kabelem Typ 2. V budově je kolárna se sprchou na mytí kol.  \n\nSoučástí projektu Albatros je park s hřišti, mateřská škola Albatros (přímo u domu) a relaxační zóny, přímo u projektu vede cyklostezka. Pět minut pěšky se nachází Billa, Rossmann, ACTIOM (domácí potřeby), dětské centrum s bazénem, hernou a kavárnou. Přibližně deset minut pěšky je vzdálen Lesopark Letňany. Metro Letňany je v dosahu 5 min. autobusem (nejbližší MHD zastávka „Valcha“). V nedalekých Letňanech se nachází plná občanská vybavenost včetně hypermarketů, multikin, sportovišť (zimní stadión a plavecký bazén), škol a školek.  \n  \nVřele doporučujeme jako moderní, komfortní bydlení pro rodiny s dětmi. Preferujeme nekuřáky bez domácích zvířat. Nájem na dobu jednoho roku s možností automatického prodlužování. K nastěhování od 7. 12. 2026. \n \nProsíme všechny zájemce, aby místo volání napsali na mail tyto informace: 1/ na jaký byt reagujete 2/ krátké představení 3/ od kdy byste chtěli bydlet a na jak dlouho 4/ pokud jste cizinec – jak dlouho již žijete v Praze. Vzhledem k velkému zájmu o pronájmy bohužel nemůžeme z důvodu kapacity poptávky vyřizovat telefonicky, děkujeme za pochopení.","detail_done":true,"disp":"4+kk","district":9,"first_seen":"2026-10-27","floor":5,"floors_total":null,"furnished":null,"garage":null,"heating":null,"history":[["2026-10-27",38000]],"id":"sreality-1693253708","images":["https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkDyuEmUPIL351U/1c33.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdk3whEUNIL352T/cdb5.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkbxLFULIL351h/4f57.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nCXhmtHPUCHypVBOI5IL35xa/82