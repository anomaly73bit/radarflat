,"history":[["2026-10-27",32900]],"id":"bezrealitky-878125","images":["https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/878k/878125/1736943013-kozeycvymc-inzer-c3-a1t1.jpg","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/878k/878125/1744616942-fcjkgbiemi-img-2795.jpg","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/878k/878125/1744616942-cjnwzuuqkp-img-2787.jpg"],"last_seen":"2026-10-27","lat":50.0906409,"lift":null,"loggia":null,"lon":14.4473171,"offer":"rent","ownership":null,"parking":null,"penb":null,"pets":null,"price":32900,"price_czk":32900,"price_m2":598,"private":true,"quarter":"Karlín","quarter_median_m2":569,"source":"bezrealitky","source_id":"878125","street":"Peckova","terrace":null,"title":"Pronájem bytu 2+kk 55 m², Peckova, Praha","url":"https://www.bezrealitky.cz/nemovitosti-byty-domy/878125-nabidka-pronajem-bytu-peckova-praha"},"realitymix-8731927":{"address":"Nad pískovnou, Praha 4, Krč","also_on":[{"price_czk":21990,"source":"sreality","url":"https://www.sreality.cz/detail/pronajem/byt/2+1/praha-krc-nad-piskovnou/2580480076"}],"area":67,"available_from":null,"balcony":null,"cellar":null,"charges":null,"condition":"good","construction":"brick","currency":"CZK","deposit":null,"description":"Popis nemovitosti Pronájem bytu 2+1 K dlouhodobému podnájmu nabízíme krásný a prostorný byt o dispozici 2+1 v samém srdci lokality Praha-Krč. Byt o celkové výměře 67 m2 se nachází na 3. podlaží cihlového domu. K bytu patří sklep, který je zahrnut již v ceně. Součástí je také terasa s překrásným výhledem. Byt je volný k nastěhování ihned a je skvělou volbou jak pro rodiny, tak pro začínající páry nebo jednotlivce. Byt se nabízí spíše nevybavený. Nadstandardně vybavená kuchyně disponuje všemi důležitými spotřebiči včetně lednice, myčky a klasické trouby s digestoří. Součástí je také varná deska a prostor na vaření. Obývací část je nezařízena a je to tak skvělá šance pro vytvoření domova. Ložnice se taktéž nabízí nezařízená. V koupelně najdeme moderní sprchový kout a velký bonus v podobě pračky. Toaleta je řešena separátně. Výhodou je také velká předsíň s úložnými prostory. Z obývacího pokoje lze vystoupit na velkou terasu s výhledem na Kunratický les. V okolí domu najdeme veškerou občanskou vybavenost. V docházkové vzdálenosti se nachází OC Budějovická, které nabízí veškeré služby a obchody. V těsné blízkosti se nachází jak základní, tak střední školy. Výborné spojení s centrem zajištují přilehlé autobusové zastávky a stanice metra C Kačerov. Parkování je zde dostupné a silniční spojení zajištuje dobrou dostupnost téměř do všech částí Prahy. V okolí bytu je spoustu krásných míst včetně Kunratického lesa, které nabízí sportovní vyžití. O byt se stará Ideální nájemce, služba zajištující bezpečné bydlení. Pokud máte zájem o prohlídku, neváhejte nás kontaktovat skrz formulář.","detail_done":true,"disp":"2+1","district":4,"first_seen":"2026-10-27","floor":3,"floors_total":3,"furnished":null,"garage":null,"heating":null,"history":[["2026-10-27",21990]],"id":"realitymix-8731927","images":["https://st.realitymix.cz/i/66677944/8021897/nab_497947807_detail.jpg","https://st.realitymix.cz/i/66672740/8299143/nab_502243781_detail.jpg","https://st.realitymix.cz/i/5895097/8713753/nab_502468569_detail.jpg","https://st.realitymix.cz/i/2294522/8714213/nab_502387489_detail.jpg"],"last_seen":"2026-10-27","lat":50.039411111111,"lift":null,"loggia":null,"lon":14.450230555556,"offer":"rent","ownership":"personal","parking":null,"penb":"C","pets":null,"price":21990,"price_czk":21990,"price_m2":328,"private":false,"quarter":"Krč","quarter_median_m2":413,"source":"realitymix","source_id":"8731927","street":"Nad pískovnou","terrace":null,"title":"Pronájem bytu, 2+1, 67 m²","url":"https://realitymix.cz/detail/praha/pronajem-bytu-2-1-8731927.html"},"sreality-1453330508":{"address":"Svatoslavova, Praha 4, Nusle","also_on":[],"area":43,"available_from":null,"balcony":null,"cellar":null,"char