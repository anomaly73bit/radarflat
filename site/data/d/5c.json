množstvím vyhlášených kaváren, restaurací a obchodů v bezprostředním okolí. Stanice metra i tramvají Náměstí Míru je vzdálena pouhé 3 minuty klidné chůze od domu.\r\n\r\nPoplatky za služby jsou 2 000 Kč měsíčně plus elektřina, která se převádí na nájemce. Vratná kauce je stanovena ve výši dvou měsíčních nájmů a provize realitní kanceláře odpovídá jednomu měsíčnímu nájmu plus DPH. \r\n\r\nByt je volný k nastěhování ihned. V případě zájmu o více informací nebo domluvení termínu prohlídky nás neváhejte kontaktovat.","detail_done":true,"disp":"2+kk","district":2,"first_seen":"2026-10-27","floor":5,"floors_total":6,"furnished":"no","garage":null,"heating":null,"history":[["2026-10-27",25500]],"id":"sreality-3396075596","images":["https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkbxLFQM7IMVKMh/66b9.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nQO0xPd86TDzG4UB5rIMVKNS/dd1d.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdk3whElyTIMVKN3/572c.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkDyuEmi2hIMVKOc/c29e.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkC4TclNikIMVKPI/b6a3.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkbxLFPFdIMVKPv/d02a.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkDyuEmcrKIMVKQR/e746.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/kb4JgeTdkBQkMFkN3IMVKQ0/c679.jpeg?fl=res,1024,768,1"],"last_seen":"2026-10-27","lat":50.0742343895,"lift":true,"loggia":null,"lon":14.4369255787,"offer":"rent","ownership":"personal","parking":null,"penb":"G","pets":null,"price":25500,"price_czk":25500,"price_m2":567,"private":false,"quarter":"Vinohrady","quarter_median_m2":549,"source":"sreality","source_id":"3396075596","street":"Americká","terrace":null,"title":"Pronájem bytu 2+kk 45 m²","url":"https://www.sreality.cz/detail/pronajem/byt/2+kk/praha-vinohrady-americka/3396075596"},"sreality-3887555404":{"address":"Devonská, Praha 5, H