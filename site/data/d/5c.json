,"area":57,"available_from":null,"balcony":null,"cellar":null,"charges":null,"condition":null,"construction":null,"currency":"CZK","deposit":null,"description":null,"detail_done":false,"disp":"2+1","district":2,"first_seen":"2026-10-27","floor":2,"floors_total":5,"furnished":null,"garage":null,"heating":null,"history":[["2026-10-27",22900]],"id":"realitymix-8713753","images":["https://st.realitymix.cz/i/5895097/8713753/nab_502468569_detail.jpg","https://st.realitymix.cz/i/5895097/8713753/nab_502468571_detail.jpg","https://st.realitymix.cz/i/5895097/8713753/nab_502468573_detail.jpg","https://st.realitymix.cz/i/5895097/8713753/nab_502468575_detail.jpg"],"last_seen":"2026-10-27","lat":null,"lift":null,"loggia":null,"lon":null,"offer":"rent","ownership":null,"parking":null,"penb":null,"pets":null,"price":22900,"price_czk":22900,"price_m2":402,"private":null,"quarter":"Nusle","quarter_median_m2":500,"source":"realitymix","source_id":"8713753","street":"Spolupráce","terrace":null,"title":"Pronájem bytu, 2+1, 57 m²","url":"https://realitymix.cz/detail/praha/pronajem-byty-2-1-47-m-praha-nusle-8713753.html"},"realitymix-8731285":{"address":"Levá, Praha 4, Podolí","also_on":[{"price_czk":24000,"source":"sreality","url":"https://www.sreality.cz/detail/pronajem/byt/2+kk/praha-podoli-leva/125763660"}],"area":50,"available_from":null,"balcony":null,"cellar":null,"charges":null,"condition":"renovated","construction":"brick","currency":"CZK","deposit":null,"description":"Popis nemovitosti Dlouhodobý pronájem krásně zrekonstruovaného zařízeného bytu ve vynikající lokalitě Prahy 4 – Podolí K dlouhodobému pronájmu nabízíme tento perfektně zrekonstruovaný, zařízený byt 2+kk ve čtvrtém patře prvorepublikového bytového domu, v pohádkově klidném místě na okraji vilové čtvrti, jen několik desítek metrů od Podolského nábřeží s ikonickou stavbou podolské vodárny. Byt prošel před nedávnem celkovou rekonstrukcí. Z oken obou obytných místností je výhled směrem na jihovýchod, do volného prostoru, na několik desítek metrů vzdálenou vilovou zástavbu. Byt disponuje kuchyňskou linkou včetně spotřebičů, umístěnou v obývacím pokoji, kde najdeme i sedačku, jídelní stůl, a další základní nábytek. Ložnice je vybavena vestavěnou skříní, komodou, a dvojlůžkem. Do obou těchto místností se vstupuje samostatně z hlavní chodby bytu. V koupelně najdeme sprchový kout a pračku. Byt je díky orientaci na JV a díky vyšší poloze v rámci domu velice světlý, je vytápěn etážovým topením s radiátory a elektrokotlem, umístěným v komoře. Dům, vybavený výtahem, je situován v lokalitě s výbornou dostupností (frekventované tramvajové linky, centrum města do 10 minut...), a je i v dochozí vzdálenosti na metro (linka C, Pražského Povstání). Ulice samotná je velice klidná, a byt je díky tomu výjimečně tichý. Pár desítek metrů od domu se rozprostírá příjemný park, navíc je zde možnost sportovního vyžití na cyklostezce podél řeky, vedoucí až na známou novoměstskou náplavku. Plavecký stadion v Podolí je taktéž vzdálen 3 minuty pěší chůze. Jedná se velice dobře udržovaný dům se solidními majiteli, kde jsou výhradně dlouhodobě pronajímané byty. Tento byt je aktuálně volný, prohlídky jsou možné od 26. října dále. Cena nájmu je uvedena bez poplatků za služby a energie, kde na elektřinu je nutno počítat okolo 2.000 Kč, a záloha na domovní služby činí 900,– Kč na osobu a měsíc.","detail_done":true,"disp":"2+kk","district":4,"first_seen":"2026-10-27","floor":5,"floors_total":7,"furnished":null,"garage":null,"heating":null,"history":[["2026-10-27",24000]],"id":"realitymix-8731285","images":["https://st.realitymix.cz/i/66669197/7838542/nab_501135913_detail.jpg","https://st.realitymix.cz/i/66677944/7864791/nab_501107003_detail.jpg","https://st.realitymix.cz/i/66670241/8610007/nab_497781315_detail.jpg","https://st.realitymix.cz/i/66683705/8636091/nab_499929759_detail.jpg"],"last_seen":"2026-10-27","lat":50.056034396111,"lift":null,"loggia":null,"lon":14.4212289425,"offer":"rent","ownership":"personal","