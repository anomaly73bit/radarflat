floors_total":6,"furnished":null,"garage":null,"heating":null,"history":[["2026-10-27",18500]],"id":"realitymix-8713953","images":["https://st.realitymix.cz/i/771263/7881738/nab_502612015_detail.jpg","https://st.realitymix.cz/i/66670241/8652409/nab_497761979_detail.jpg","https://st.realitymix.cz/i/66692387/8715113/nab_501881623_detail.jpg","https://st.realitymix.cz/i/6847448/8683301/nab_500742821_detail.jpg"],"last_seen":"2026-10-27","lat":50.075189,"lift":null,"loggia":null,"lon":14.428423,"offer":"rent","ownership":"personal","parking":null,"penb":null,"pets":null,"price":18500,"price_czk":18500,"price_m2":597,"private":false,"quarter":"Nové Město","quarter_median_m2":513,"source":"realitymix","source_id":"8713953","street":"Kateřinská","terrace":null,"title":"Pronájem bytu, 1+kk, 31 m²","url":"https://realitymix.cz/detail/praha/pronajem-bytu-1-kk-31-m-praha-2-nove-mesto-8713953.html"},"realitymix-8727877":{"address":"Bryksova, Praha 14, Černý Most","also_on":[{"price_czk":18990,"source":"sreality","url":"https://www.sreality.cz/detail/pronajem/byt/2+kk/praha-cerny-most-bryksova/402919500"},{"price_czk":18500,"source":"sreality","url":"https://www.sreality.cz/detail/pronajem/byt/2+kk/praha-cerny-most-bryksova/2410090572"}],"area":40,"available_from":null,"balcony":null,"cellar":null,"charges":null,"condition":"renovated","construction":"panel","currency":"CZK","deposit":null,"description":"Popis nemovitosti Podnájem, Byty 2+kk, 40m2, Praha 9 - Černý Most, ul. Bryksova Vzhledem ke zvýšené poptávce na pronájem nemovitostí z důvodu aktuální situace na Ukrajině, prosíme primárně využívat odpovědní formulář nebo sms s adresou bytu, na který reagujete. Nabízíme k podnájmu pěkný byt o velikosti 2+kk o rozloze 40m2, v 8. podlaží panelového domu v lokalitě Černý Most - Praha 9, ul. Bryksova. Z chodby bytu se dostanete do obývacího pokoje, který je průchozí do kuchyně, která disponuje kuchyňskou linkou el. varnou deskou, troubou, myčkou a lednicí s mrazákem. Dále se z chodby dostanete také do ložnice. Z chodby je také vstup do koupelny se sprchovým koutem a vanou a na samostatné WC. Vybavení bytu zobrazené na fotografiích nemusí odpovídat skutečnému vybavení bytu. Jedná se o klidnou lokalitu s veškerou občanskou vybaveností a dobrou dopravní dostupností. Byt je volný k nastěhování od 1.2.2027. Bydlete se Stálým Nájmem. ️ Stalo se vám někdy, že pronajímatel neměl čas se Vám věnovat? S námi se to nestane – jsme vám k dispozici každý všední den od 9 do 17 hodin. Zajistíme převody energií, pojištění, vyúčtování a když se něco přihodí společně to vyřešíme. I když jen potřebujete poradit nebo si ujasnit nějaký detail - jsme tu pro Vás","detail_done":true,"disp":"2+kk","district":9,"first_seen":"2026-10-27","floor":8,"floors_total":10,"furnished":null,"garage":null,"heating":null,"history":[["2026-10-27",18990]],"id":"realitymix-8727877","images":["https://st.realitymix.cz/i/66668631/8674549/nab_497628433_detail.jpg","https://st.realitymix.cz/i/66677944/8708777/nab_500489615_detail.jpg","https://st.realitymix.cz/i/66679173/8729517/nab_502347503_detail.jpg","https://st.realitymix.cz/i/66668277/8731013/nab_502380331_detail.jpg"],"last_seen":"2026-10-27","lat":50.105595277778,"lift":null,"loggia":null,"lon":14.581757777778,"offer":"rent","ownership":"personal","parking":null,"penb":"G","pets":null,"price":18990,"price_czk":18990,"price_m2":475,"private":false,"quarter":"Černý Most","quarter_median_m2":475,"source":"realitymix","source_id":"8727877","street":"Bryksova","terrace":null,"title":"Pronájem bytu, 2+kk, 40 m²","url":"https://realitymix.cz/detail/praha/podnajem-byty-2-kk-40m2-praha-9-cerny-most-ul-bryksova-8727877.html"},"realitymix-8731777":{"address":"Vrtbova, Praha 4, Nusle","also_on":[{"price_czk":33000,"source":"sreality","url":"https://www.sreality.cz/detail/pronajem/byt/2+kk/praha-nusle-vrtbova/1374617676"},{"price_czk":32500,"source":"sreality","url":"https://www.sreality.cz/detail/pronajem/byt/2+kk/praha-nusle-muzikova/3150172236"},{"price_czk":32500,"source":"realitymix","url":"https://realitymix.cz/detail/praha/pronajem-bytu-2-kk-t-gs-63-2-m2-p4-nusle-ul-muzikova-2-np-cihla-sklep-8660459.html"}],"area":57,"available_from":null,"balcony":null,"cellar":true,"charges":null,"condition":"new","construction":"brick","currency":"CZK","deposit":null,"description":"Popis nemovitosti Praha / Nusle, byt 2+kk / mezonet, sklep, garážové stání Nabízíme k pronájmu luxusně zařízený mezonetový byt 2+kk o užitné ploše 53,9 m² ve 3. nadzemním podlaží rezidenčního projektu Nuselský pivovar na adrese Vrtbova 1678/17, Praha 4 - Nusle. Byt zaujme původními dřevěnými trámy, střešními okny a promyšleným vybavením v černo-dřevěném designu. Interiéry byly navržené Ateliérem Krása a nábytek je na míru od renomovaného truhláře. Stačí se nastěhovat! Ve spodním podlaží najdete vstupní chodbu s vestavěnou šatní skříní a lavicí, samostatné WC a prostorný obývací pokoj s kuchyňským koutem. Ocelové schodiště s dubovými stupni vede do horního podlaží s ložnicí s pracovním místem a koupelnou. Byt nabízí mnoho důmyslného úložného prostoru na míru. Kuchyň je vybavena vestavěnou pečící troubou, indukční varnou deskou s integrovaným odsavačem par, dřezem, myčkou nádobí, vestavěnou chladničkou s mrazákem a skříňkou připravenou pro mikrovlnnou troubu. V bytě se nachází sedací souprava, jídelní stůl se židlemi, dvojpostel, noční stolky a pracovní stůl. V každém patře je klimatizační jednotka. Koupelna nabízí sprchový kout, WC, umyvadlo na skříňce, pračku a sušičku. V bytě jsou dubové podlahy a velkoformátová dlažba v koupelně, na WC a v chodbě. K bytu patří sklep o ploše 2,9 m². S bytem je možné pronajmout parkovací stání ve vedlejší části projektu za cenu 2 700 Kč / měsíc, není však podmínkou. Nuselský pivovar je rezidenční areál v klidné ulici nedaleko parků Folimanka a Havlíčkovy sady, minutu chůze od tramvaje. V areálu je pošta, Penny, Rossmann, kavárna s pekárnou, restaurace a fitness. Do centra se dostanete velmi rychle tramvají, nejbližší stanice metra jsou Vyšehrad (trasa C), I.P. Pavlova (trasa C) nebo Karlovo náměstí (trasa B). Nájemné 33 000 Kč / měsíc, zálohy na služby 4 000 Kč / měsíc pro 1 osobu nebo 4 500 Kč / měsíc pro 2 osoby + elektrická energie se převádí na nájemce (předpoklad 1 000 Kč / měsíc). Jistota (kauce) 55 000 Kč. Odměna realitní kanceláře je jedno měsíční nájemné.","detail_done":true,"disp":"2+kk","district":2,"first_seen":"2026-10-27","floor":null,"floors_total":null,"furnished":null,"garage":null,"heating":null,"history":[["2026-10-27",33000]],"id":"realitymix-8731777","images":["https://st.realitymix.cz/i/66677944/7864791/nab_501107003_detail.jpg","https://st.realitymix.cz/i/66682300/8618613/nab_502639697_detail.jpg","https://st.realitymix.cz/i/66670288/8629629/nab_500700199_detail.jpg","https://st.realitymix.cz/i/66683705/8636091/nab_499929759_detail.jpg"],"last_seen":"2026-10-27","lat":50.065277777778,"lift":null,"loggia":null,"lon":14.437222222222,"offer":"rent","ownership":"personal","parking":null,"penb":"D","pets":null,"price":33000,"price_czk":33000,"price_m2":579,"private":false,"quarter":"Nusle","quarter_median_m2":500,"source":"realitymix","source_id":"8731777","street":"Vrtbova","terrace":null,"title":"Pronájem bytu, 2+kk, 57 m²","url":"https://realitymix.cz/detail/praha/praha-nusle-byt-2-kk-mezonet-sklep-garazove-stani-8731777.html"},"sreality-1945636940":{"address":"Sovova, Praha 8, Karlín","also_on":[],"area":49,"available_from":null,"balcony":null,"cellar":null,"charges":null,"condition":null,"construction":null,"currency":"CZK","deposit":null,"description":null,"detail_done":false,"disp":"2+kk","district":8,"first_seen":"2026-10-27","floor":null,"floors_total":null,"furnished":null,"garage":null,"heating":null,"history":[["2026-10-27",39500]],"id":"sreality-1945636940","images":["https://d18-a.sdn.cz/d_18/c_img_qG_D/nCXhmtHPUBL8BsDX9lILuBh3/a9be.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_D/nCXhmtHPUBL8BsDX95ILuBif/2468.jpeg?fl