reality.png,10|shr,,20|jpg,90"],"last_seen":"2026-10-27","lat":50.0531781088,"lift":null,"loggia":null,"lon":14.5131115585,"offer":"rent","ownership":null,"parking":null,"penb":null,"pets":null,"price":20500,"price_czk":20500,"price_m2":387,"private":null,"quarter":"Záběhlice","quarter_median_m2":401,"source":"sreality","source_id":"1596334156","street":"Velenovského","terrace":null,"title":"Pronájem bytu 2+kk 53 m²","url":"https://www.sreality.cz/detail/pronajem/byt/2+kk/praha-zabehlice-velenovskeho/1596334156"},"sreality-2129666124":{"address":"Bechlínská, Praha 9, Letňany","also_on":[{"price_czk":20500,"source":"realitymix","url":"https://realitymix.cz/detail/praha/pronajem-bytu-2-kk-praha-bechlinska-20-500-czk-54-m2-7497643.html"}],"area":54,"available_from":"2026-12-01","balcony":true,"cellar":true,"charges":null,"condition":"very_good","construction":"brick","currency":"CZK","deposit":null,"description":"K dlouhodobému podnájmu nabízíme byt o dispozici 2+kk s balkonem v atraktivní lokalitě Praha - Prosek s bezproblémovou dopravní dostupností do centra města. Byt o celkové výměře 54 m2 se nachází v prvním podlaží cihlového domu.\r\n\r\nByt se nabízí částečně vybavený. Kuchyňská linka disponuje lednicí, mrazákem, sklo-keramickou deskou, digestoří, mikrovlnou troubou a horkovzdušnou troubou. V místnosti se nachází také vstup na balkon. Druhý pokoj je zařízen postelí a nočními stolky. Koupelna je zařízená vanou, umyvadlem se zrcadlem, toaletou a pračkou. K bytu náleží také sklep, garáž a parkovací stání. \r\n\r\nV okolí bytu se nachází veškerá občanská vybavenost. Najdeme zde obchody s potravinami, lékárnu, drogerii, restaurace,  kavárnu, Českou poštu, gymnázium atd. U domu jsou také zastávky MHD (Terezínská, Českolipská)\r\n\r\nByt je volný k nastěhování od 1.12.2026. Domácí mazlíčci nejsou povoleni. \r\n\r\nUvedena energetická kategorie G, jelikož nemáme k dispozici PENB.\r\n\r\nByt pronajímá Ideální nájemce - služba, se kterou budete bydlet bezstarostně a za férových podmínek. Když se něco přihodí, k dispozici jsou správci, kteří s vámi vše vyřeší. Pomůžeme s veškerou administrativou, s nastavením plateb a zajistíme vám speciální pojištění. Pojďte bydlet s námi!","detail_done":true,"disp":"2+kk","district":9,"first_seen":"2026-10-27","floor":0,"floors_total":6,"furnished":"partly","garage":true,"heating":null,"history":[["2026-10-27",20500]],"id":"sreality-2129666124","images":["https://d18-a.sdn.cz/d_18/c_img_qF_E/nOdL4BtPEyDrQHrC58H56mMc/4d58.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qF_E/k0OqwCKRZSJdCo4H56mM6/83d5.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qF_D/k0OqwCKRB7OXgC4eH56mNT/b595.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qF_D/k0OqwCKRCO7AFDuXH56mNy/f924.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qF_D/k0OqwCKRCO7AFDuLH56mOU/b131.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qF_D/nOdL4BtPEyvOo9CSdH56mPA/5fa6.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qF_D/k0OqwCKRDgcHsCc5H56mPa/4368.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90"],"last_seen":"2026-10-27","lat":50.1272730516537,"lift":true,"loggia":null,"lon":14.5032257833925,"offer":"rent","ownership":"personal","parking":true,"penb":"G","pets":null,"price":20500,"price_czk":20500,"price_m2":380,"private":false,"quarter":"Letňany","quarter_median_m2":424,"source":"sreality","source_id":"2129666124","street":"Bechlínská","terrace":null,"title":"Pronájem bytu 2+kk 54 m²","url":"https://www.sreality.cz/detail/pronajem/byt/2+kk/praha-letnany-bechlinska/2129666124"},"sreality-2372534348":{"address":"Mantovská, Praha 10, Horní Měcholupy","also_on":[],"area":30,"available_from":null,"bal