0","https://d18-a.sdn.cz/d_18/c_img_qG_C/kOzg0nKR97CjkgbUQIHrTcj/e2f3.png?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90"],"last_seen":"2026-10-27","lat":50.092355287456925,"lift":null,"loggia":null,"lon":14.482957103127738,"offer":"rent","ownership":null,"parking":null,"penb":null,"pets":null,"price":25000,"price_czk":25000,"price_m2":472,"private":null,"quarter":null,"quarter_median_m2":null,"source":"sreality","source_id":"2590249036","street":"Hartigova","terrace":null,"title":"Pronájem bytu 1+kk 53 m²","url":"https://www.sreality.cz/detail/pronajem/byt/1+kk/praha-hartigova/2590249036"},"sreality-302207820":{"address":"Václavské náměstí, Praha 1, Nové Město","also_on":[{"price_czk":59900,"source":"realitymix","url":"https://realitymix.cz/detail/praha/prostor-vhodny-pro-bydleni-ci-kancelar-na-vaclavskem-namesti-8526763.html"}],"area":156,"available_from":"2026-10-21","balcony":null,"cellar":null,"charges":null,"condition":"very_good","construction":"brick","currency":"CZK","deposit":null,"description":"K okamžitému pronájmu nabízíme prostor ve vyhledávané lokalitě Václavského náměstí, který je vhodný nejen pro kancelářské účely, ale i jako reprezentativní bydlení. Jedná se o vzdušné a světlé kompletně zrekonstruované prostory o celkové výměře 156 m² v reprezentativním činžovním domě s výtahem a recepcí v samotném centru města.\r\n\r\nDispozice zahrnuje vstupní chodbu, plně vybavenou kuchyň a čtyři prostorné místnosti. Součástí je i koupelna, samostatná toaleta a technická místnost. Prostory mají nové podlahy a repasovaná okna s žaluziemi.\r\n\r\nProstor je vybaven vlastním plynovým kotlem, který zajišťuje nezávislé vytápění, a klimatizaci v každé místnosti pro maximální komfort během celého roku. Možné parkování v zakladači za příplatek.\r\n\r\nZálohy činí 5 900 Kč / měsíc / osoba (vyúčtování 1x ročně). Energie a služby zajišťuje pronajímatel. Nájemce si sám zajišťuje pouze úklid pronajatých prostor a datové služby.\r\nVratná kauce je ve výši tří měsíčních nájmů. Provize realitní kanceláři je jeden měsíční nájem + DPH.","detail_done":true,"disp":"5+1","district":1,"first_seen":"2026-10-27","floor":2,"floors_total":null,"furnished":null,"garage":null,"heating":null,"history":[["2026-10-27",59900]],"id":"sreality-302207820","images":["https://d18-a.sdn.cz/d_18/c_img_qG_C/kOdFH5t9SRBBtBFUPII3MIp/078b.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_C/ncz4PZ5CZDZxGQUTII3MJQ/3f50.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_C/kOdFH5t9SRBR1TbiHII3MJu/c440.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_C/kOdFH5t9SRB13yGl7II3MKN/f6ab.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_C/ncz4PZ5CZ4EadUTII3MK4/1903.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_C/ncz4PZ5CZD0oEbUSII3MLc/2c23.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_C/ncz4PZ5CZBHbOmUSII3ML5/0037.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_C/kOdFH5t9SRCkhfutMII3MMb/c34b.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_C/ncz4PZ5CZBEoJ9hmII3MM7/3988.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90","https://d18-a.sdn.cz/d_18/c_img_qG_C/kOdFH5t9SRB13yGYoII3MNf/3c6a.jpeg?fl=res,1920,1080,1|wrm,/watermark/sreality.png,10|shr,,20|jpg,90"],"last_seen":"2026-10-27","lat":50.080391,"lift":true,"loggia":null,"lon":14.4293349,"offer":"rent","ownership":"personal","parking":true,"penb":"G","pets":null,"price":59900,"price_czk":59900,"price_m2":384,"private":false,"quarter":"Nové Město","quarter_median_m2":513,"source":"sreality","source_id":"302207820","street":"Václavsk