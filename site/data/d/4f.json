tion":null,"construction":null,"currency":"CZK","deposit":null,"description":null,"detail_done":false,"disp":"3+1","district":6,"first_seen":"2026-10-27","floor":5,"floors_total":8,"furnished":null,"garage":null,"heating":null,"history":[["2026-10-27",25000]],"id":"realitymix-8716113","images":["https://st.realitymix.cz/i/66677139/8716113/nab_501146881_detail.jpg","https://st.realitymix.cz/i/66677139/8716113/nab_501146883_detail.jpg","https://st.realitymix.cz/i/66677139/8716113/nab_501146885_detail.jpg","https://st.realitymix.cz/i/66677139/8716113/nab_501146887_detail.jpg"],"last_seen":"2026-10-27","lat":null,"lift":null,"loggia":null,"lon":null,"offer":"rent","ownership":null,"parking":null,"penb":null,"pets":null,"price":25000,"price_czk":25000,"price_m2":309,"private":null,"quarter":"Řepy","quarter_median_m2":417,"source":"realitymix","source_id":"8716113","street":"Španielova","terrace":null,"title":"Pronájem bytu, 3+1, 81 m²","url":"https://realitymix.cz/detail/praha/pronajem-prostorneho-bytu-3-1-s-lodzii-a-komorou-praha-6-repy-8716113.html"},"realitymix-8731877":{"address":"Pod lipami, Praha 3, Žižkov","also_on":[],"area":20,"available_from":null,"balcony":null,"cellar":null,"charges":null,"condition":"very_good","construction":"brick","currency":"CZK","deposit":null,"description":"Popis nemovitosti Pronájem bytu garsonka, Pod Lipami, Žižkov,15.690 Kč/měs, 20 m2 Nabízíme k dlouhodobému podnájmu účelně řešenou a světlou garsoniéru (1+kk / garsonka) o celkové výměře 20 m², situovanou v atraktivní a klidné lokalitě Praha 3 – Žižkov (ulice Pod Lipami). Byt představuje ideální bydlení pro jednotlivce, který hledá praktické a úsporné zázemí s výbornou dostupností do centra města. Hlavní obytná místnost (15,8 m²) nabízí parketovou podlahu, dostatek denního světla a výhled do klidného vnitrobloku se zelení. Byt je vybaven novou kuchyňskou linkou, vestavnou troubou,varnou deskou, digestoří a menší ledničkou. Součástí pokoje je také praktický stůl se židlemi. Koupelna je vybavena sprchovým koutem, umyvadlem a zrcadlovou skříňkou. Toaleta je umístěna samostatně. V rámci úsporu prostoru se v bytě nenachází pračka. Nahrazuje jí místnost na praní, která se nachází samostatně a je určena pouze pro tuto bytovou jednotku, lze tedy prát i sušit prádlo a ušetří se tak prostor v bytě. Lokalita Žižkova v okolí ulice Pod Lipami spojuje klidné rezidenční prostředí s kompletní občanskou vybaveností (obchody, kavárny, restaurace, lékárna). Vynikající je dopravní dostupnost – v těsné blízkosti se nachází tramvajové a autobusové zastávky se skvělým a rychlým spojením na metro A (Želivského / Flora) i přímo do centra města. Pro relaxaci, procházky a sport skvěle poslouží blízké parky Židovské pece nebo Malešický park. Nespornou výhodou je také nedaleký Kaufland. Byt je připraven k nastěhování. Energetická třída: G (průkaz nedodán).","detail_done":true,"disp":null,"district":3,"first_seen":"2026-10-27","floor":1,"floors_total":6,"furnished":null,"garage":null,"heating":null,"history":[["2026-10-27",15690]],"id":"realitymix-8731877","images":["https://st.realitymix.cz/i/1170900/7263165/nab_500648565_detail.jpg","https://st.realitymix.cz/i/1170900/7302402/nab_501501287_detail.jpg","https://st.realitymix.cz/i/1170900/7378687/nab_498653003_detail.jpg","https://st.realitymix.cz/i/1170900/7377237/nab_500648465_detail.jpg"],"last_seen":"2026-10-27","lat":50.090433333333,"lift":null,"loggia":null,"lon":14.484938888889,"offer":"rent","ownership":"personal","parking":null,"penb":null,"pets":null,"price":15690,"price_czk":15690,"price_m2":784,"private":false,"quarter":"Žižkov","quarter_median_m2":489,"source":"realitymix","source_id":"8731877","street":"Pod lipami","terrace":null,"title":"Pronájem bytu, garsoniéra, 20 m²","url":"https://realitymix.cz/detail/praha/pronajem-bytu-garsonka-pod-lipami-zizkov-15-690-kc-mes-20-m2-8731877.html"},"sreality-1075707980":{"address":"Nuselská, Praha 4, Michle","also_on":[],"area":50,"available_from":null,"balcony":null,"ce