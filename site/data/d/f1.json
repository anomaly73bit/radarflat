ní občanskou vybavenost v bezprostředním dosahu. Pár minut chůze od domu najdete obchody, vyhlášené restaurace, lékařskou péči, školy, školky i poštu, pro chvíle relaxace a sportu je pak jako stvořený oblíbený park Santoška. Výbornou dopravní dostupnost zajišťují četné autobusové a tramvajové linky i nově zmodernizované smíchovské nádraží s navazující pěší lávkou. Byt je volný k nastěhování ihned. Energetická třída: G (průkaz nedodán).","detail_done":true,"disp":"2+1","district":5,"first_seen":"2026-10-27","floor":1,"floors_total":1,"furnished":null,"garage":null,"heating":null,"history":[["2026-10-27",19990]],"id":"realitymix-8729625","images":["https://st.realitymix.cz/i/66677944/7704759/nab_502268515_detail.jpg","https://st.realitymix.cz/i/66677944/7794104/nab_501852501_detail.jpg","https://st.realitymix.cz/i/1170900/7858692/nab_495726567_detail.jpg","https://st.realitymix.cz/i/66677944/7882911/nab_500796915_detail.jpg"],"last_seen":"2026-10-27","lat":50.061972222222,"lift":null,"loggia":null,"lon":14.404622222222,"offer":"rent","ownership":"personal","parking":null,"penb":"G","pets":null,"price":19990,"price_czk":19990,"price_m2":384,"private":false,"quarter":"Smíchov","quarter_median_m2":500,"source":"realitymix","source_id":"8729625","street":"Pod Barvířkou","terrace":null,"title":"Pronájem bytu, 2+1, 52 m²","url":"https://realitymix.cz/detail/praha/pronajem-bytu-2-1-pod-barvirkou-smichov-52-m2-8729625.html"},"sreality-1117859916":{"address":"Ke Krči, Praha 4, Braník","also_on":[{"price_czk":18500,"source":"realitymix","url":"https://realitymix.cz/detail/praha/pronajem-bytu-1-kk-40-m-praha-4-branik-8716883.html"}],"area":40,"available_from":null,"balcony":null,"cellar":null,"charges":null,"condition":null,"construction":null,"currency":"CZK","deposit":null,"description":null,"detail_done":false,"disp":"2+kk","district":4,"first_seen":"2026-10-27","floor":null,"floors_total":null,"furnished":null,"garage":null,"heating":null,"history":[["2026-10-27",18500]],"id