 metra B Vysočanská a tramvajové a autobusové zastávky. Nedaleko je vlakové nádraží Praha-Vysočany a park Podviní, kterým protéká Rokytka. Volný ihned. Nájem 21.000 Kč + služby 600 Kč/os. + energie 3.250 Kč. Kauce 24.850 Kč + provize RK. Pronajímatel si vyhrazuje právo výběru nájemce.","detail_done":true,"disp":"2+kk","district":9,"first_seen":"2026-10-27","floor":4,"floors_total":6,"furnished":null,"garage":null,"heating":null,"history":[["2026-10-27",21000]],"id":"realitymix-8729543","images":["https://st.realitymix.cz/i/66677944/7678186/nab_501568533_detail.jpg","https://st.realitymix.cz/i/66692387/8590851/nab_502592899_detail.jpg","https://st.realitymix.cz/i/6178326/8626649/nab_492898971_detail.jpg","https://st.realitymix.cz/i/4733833/8148813/nab_449760869_detail.jpg"],"last_seen":"2026-10-27","lat":50.108286111111,"lift":null,"loggia":null,"lon":14.503875,"offer":"rent","ownership":"cooperative","parking":null,"penb":"G","pets":null,"price":21000,"price_czk":21000,"price_m2":389,"private":false,"quarter":"Vysočany","quarter_median_m2":464,"source":"realitymix","source_id":"8729543","street":"U vysočanského pivovaru","terrace":null,"title":"Pronájem bytu, 2+kk, 54 m²","url":"https://realitymix.cz/detail/praha/pronajem-bytu-2-kk-54m2-ul-u-vysocanskeho-pivovaru-praha-9-vysocany-bez-nabytku-8729543.html"},"sreality-1402085452":{"address":"Kamýcká, Praha 6, Suchdol","also_on":[{"price_czk":23000,"source":"realitymix","url":"https://realitymix.cz/detail/praha/pronajem-bytu-2-1-41-m-se-samostatnym-vstupem-a-zahradou-praha-suchdol-8708429.html"}],"area":41,"available_from":null,"balcony":null,"cellar":null,"charges":null,"condition":null,"construction":null,"currency":"CZK","deposit":null,"description":null,"detail_done":false,"disp":"2+1","district":6,"first_seen":"2026-10-27","floor":null,"floors_total":null,"furnished":null,"garage":null,"heating":null,"history":[["2026-10-27",23000]],"id":"sreality-1402085452","images":["https://d18-a.sdn.cz/d_18/c_img_qF_D/nOdL4Bt