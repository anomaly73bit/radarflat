ders/default_photo_main.png","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/1075k/1075529/flatiodrd5dchuevnc1ajwhqc.jpeg","https://api.bezrealitky.cz/media/cache/record_main/data/images/advert/1075k/1075529/flatior241gl4cdosjevhma6z.jpeg"],"last_seen":"2026-10-27","lat":50.0704145,"lift":null,"loggia":null,"lon":14.4507017,"offer":"rent","ownership":null,"parking":null,"penb":null,"pets":null,"price":59690,"price_czk":59690,"price_m2":433,"private":true,"quarter":"Vršovice","quarter_median_m2":491,"source":"bezrealitky","source_id":"1075529","street":"Košická","terrace":null,"title":"Pronájem bytu  138 m², Košická, Praha","url":"https://www.bezrealitky.cz/nemovitosti-byty-domy/1075529-nabidka-pronajem-bytu-kosicka-praha"},"realitymix-8725605":{"address":"Musílkova, Praha 5, Košíře","also_on":[{"price_czk":21900,"source":"sreality","url":"https://www.sreality.cz/detail/pronajem/byt/2+kk/praha-kosire-musilkova/2793869388"}],"area":41,"available_from":null,"balcony":null,"cellar":null,"charges":null,"condition":"renovated","construction":"brick","currency":"CZK","deposit":null,"description":"Popis nemovitosti Pronájem moderního bytu 2+kk v klidné části Prahy 5 K dlouhodobému pronájmu nabízím nově zrekonstruovaný byt 2+kk o ploše 40,8 m², jenž je umístěný v přízemí nově zrevitalizovaného cihlového domu s výtahem v ulici Musílkova, v oblíbené části Prahy 5 - Košíře. Dům prošel kompletní rekonstrukcí vč. moderní kotelny (2026) a nabízí moderní, komfortní a dlouhodobé bydlení. Nastěhování je možné ihned. Dispozice bytu (1.2.) zahrnuje vstupní předsíň, designovou koupelnu se sprchovým koutem, umyvadlem s koupelnovou skříňkou, WC a topným žebříkem. Obývací pokoj s kuchyňským koutem, který disponuje moderní kuchyňskou linkou se spotřebiči - lednicí s mrazákem, troubou, indukční varnou deskou, myčkou, dřezem, digestoří a pračkou. Samostatná ložnice je orientována na severní stranu. Internetové připojení je řešeno přes O2 / CETIN, v bytě jsou připravené datové zásuvky. Finanční podmínky: Nájemné = 21 900 Kč / měsíčně. Zálohy na služby = 1 osoba = 2.000,- Kč / měs., 2 osoby 3.000,- Kč / měs. Elektřina se převádí na nájemce. Jistota (kauce) ve výši 30 000,-Kč. Rezervační platba/provize = 26 499,- Kč. Bytový dům se nachází v klidné a zelené části Košíře, která je vyhledávaná pro svou příjemnou atmosféru a výbornou dopravní dostupnost. V okolí je kompletní občanská vybavenost - obchody, kavárny, restaurace i ostatní služby. Autobusová zastávka \"Pod Školou\" je do 5 min. chůzí, tramvajová zastávka \"Kavalírka\" je do 10 min. chůzí od domu a díky tomu se během několika minut pohodlně dostanete do centra města i na stanici metra =B= Anděl. Rád se s Vámi setkám na osobní prohlídce bytu. Pronajímající si vyhrazuje právo vybrat nájemce na základě jím zvolených kritérií.","detail_done":true,"disp":"2+kk","district":5,"first_seen":"2026-10-27","floor":1,"floors_total":5,"furnished":null,"garage":null,"heating":null,"history":[["2026-10-27",21900]],"id":"realitymix-8725605","images":["https://st.realitymix.cz/i/66677944/7704759/nab_502268515_detail.jpg","https://st.realitymix.cz/i/66677944/7882911/nab_500796915_detail.jpg","https://st.realitymix.cz/i/6847448/8454493/nab_487602775_detail.jpg","https://st.realitymix.cz/i/66670288/8632759/nab_498958847_detail.jpg"],"last_seen":"2026-10-27","lat":50.067488888889,"lift":null,"loggia":null,"lon":14.367494444444,"offer":"rent","ownership":"personal","parking":null,"penb":"G","pets":null,"price":21900,"price_czk":21900,"price_m2":534,"private":false,"quarter":"Košíře","quarter_median_m2":500,"source":"realitymix","source_id":"8725605","street":"Musílkova","terrace":null,"title":"Pronájem bytu, 2+kk, 41 m²","url":"https://realitymix.cz/detail/praha/pronajem-moderniho-bytu-2-kk-v-klidne-casti-prahy-5-8725605.html"},"realitymix-8731231":{"address":"Blachutova, Praha-Čakovice, Čakovice","also_on":[{"price_czk":21990,"source":"sreality","url":"https://www.sreality.cz/detail/pronajem/byt/3+kk/praha-cakovice-blachutova/4084138060"}],"area":63,"available_from":null,"balcony":null,"cellar":null,"charges":null,"condition":"very_good","construction":"panel","currency":"CZK","deposit":null,"description":"Popis nemovitosti Pronájem bytu 3+kk 63 m², Praha - Čakovice Dlouhodobý podnájem světlého bytu 3+kk s parkováním a balkonem – Praha 9, Čakovice Nabízíme k dlouhodobému podnájmu příjemný, světlý a vzdušný byt o dispozici 3+kk v ulici Blachutova, Praha 9 – Čakovice. Byt nabízí prakticky řešený prostor pro pohodlné bydlení a je částečně vybavený, takže umožňuje snadné nastěhování a zároveň dostatek prostoru pro vlastní zařízení. Hlavní obytnou část tvoří obývací pokoj s kuchyňským koutem. Kuchyňská část je vybavena jídelním stolem a židlemi, v obývacím pokoji je k dispozici pracovní stůl a televize. Prostor tak přirozeně propojuje místo pro společné stolování, odpočinek i práci z domova. Byt dále nabízí dva samostatné pokoje. V ložnici se nachází manželská postel, druhý pokoj je vybaven šatními skříněmi a lze jej využít jako dětský pokoj, pracovnu nebo pokoj pro hosty. V koupelně je k dispozici pračka. Díky dostatku denního světla působí celý byt velmi příjemně, vzdušně a útulně. Je vhodný pro pár, menší rodinu nebo zájemce, kteří hledají dlouhodobé bydlení v klidnější části Prahy s dobrou dostupností a kompletní občanskou vybaveností. K bytu je možné využívat parkovací stání za příplatek. Vybavení bytu * kuchyňský kout, * jídelní stůl a židle, * pracovní stůl, * televize, * pračka, * šatní skříně, * manželská postel, * možnost parkovacího stání za příplatek. Lokalita Čakovice jsou oblíbenou rezidenční částí Prahy, která nabízí klidnější prostředí, dostatek zeleně a zároveň dobrou dostupnost do ostatních částí města. V okolí ulice Blachutova se nacházejí obchody, restaurace, kavárny, pekárna, mateřská škola, dětská hřiště a venkovní sportoviště. Pro větší nákupy lze využít například nedaleký Globus nebo Lidl. K procházkám a odpočinku vybízí Čakovický zámecký park, který je dostupný během několika minut chůze. Okolí nabízí také cyklostezky, sportovní plochy, finskou stezku a psí louku. Dopravní spojení zajišťují autobusové linky s návazností na stanici metra C Letňany. Využít lze také vlakové nádraží Praha-Čakovice, odkud je možné pohodlně cestovat směrem do centra Prahy. Pro cestování automobilem je výhodou dobré napojení na hlavní výjezdové komunikace a dálnici D8. Bydlení v ulici Blachutova je ideální pro každého, kdo hledá kombinaci klidného prostředí, zeleně, dostupných služeb a pohodlného spojení do města. Tento byt se pronajímá v programu Garantovaný nájem, to znamená že má navíc nadstandardní služby: pojištění domácnosti i odpovědnosti za škodu s nepřetržitou asistenční linkou, prodloužená záruka spotřebičů o 2 roky, zákaznická podpora pro řešení vašich požadavků, technická podpora a servis při řešení závad, pomoc s přepisem energií, možnost si pronajat jiný byt z portfolia Garantovaný nájem a ROI Estate Pro více informací nebo sjednání osobní prohlídky nás neváhejte kontaktovat.","detail_done":true,"disp":"3+kk","district":9,"first_seen":"2026-10-27","floor":null,"floors_total":null,"furnished":null,"garage":null,"heating":null,"history":[["2026-10-27",21990]],"id":"realitymix-8731231","images":["https://st.realitymix.cz/i/807153/8504089/nab_502490947_detail.jpg","https://st.realitymix.cz/i/66683894/8717655/nab_502483071_detail.jpg","https://st.realitymix.cz/i/66685342/8727699/nab_502643265_detail.jpg","https://st.realitymix.cz/i/66668748/8692105/nab_499063789_detail.jpg"],"last_seen":"2026-10-27","lat":50.157350555556,"lift":null,"loggia":null,"lon":14.517772222222,"offer":"rent","ownership":"personal","parking":null,"penb":"B","pets":null,"price":21990,"price_czk":21990,"price_m2":349,"private":false,"quarter":"Čakovice","quarter_median_m2":415,"source":"realitymix","source_id":"8731231","street":"Blachutova","terrace":null,"title":"Pronájem bytu, 3+kk, 63 m²","url":"https://realitymix.cz/detail/praha/pronajem-