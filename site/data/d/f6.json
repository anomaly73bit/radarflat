litymix.cz/i/66680108/8700135/nab_500960093_detail.jpg","https://st.realitymix.cz/i/66680108/8700135/nab_500960095_detail.jpg","https://st.realitymix.cz/i/66680108/8700135/nab_500960099_detail.jpg"],"last_seen":"2026-10-27","lat":null,"lift":null,"loggia":null,"lon":null,"offer":"rent","ownership":null,"parking":null,"penb":null,"pets":null,"price":32000,"price_czk":32000,"price_m2":400,"private":null,"quarter":"Nusle","quarter_median_m2":500,"source":"realitymix","source_id":"8700135","street":"K sídlišti","terrace":null,"title":"Pronájem bytu, 2+kk, 80 m²","url":"https://realitymix.cz/detail/praha/pronajem-2-kk-72-m-lodzie-7-m-garaz-8700135.html"},"realitymix-8729497":{"address":"Březinova, Praha 8, Karlín","also_on":[{"price_czk":46000,"source":"bezrealitky","url":"https://www.bezrealitky.cz/nemovitosti-byty-domy/497894-nabidka-pronajem-bytu-brezinova-praha"},{"price_czk":46000,"source":"sreality","url":"https://www.sreality.cz/detail/pronajem/byt/3+kk/praha-karlin-brezinova/1067192396"}],"area":77,"available_from":null,"balcony":null,"cellar":null,"charges":null,"condition":"very_good","construction":"mixed","currency":"CZK","deposit":null,"description":"Popis nemovitosti Prostorný byt 3+kk se šatnou a vysokými stropy v atraktivní lokalitě Prahy 8 – Karlína K pronájmu nabízíme byt o dispozici 3+kk a užitné ploše 77 m², situovaný v 1. patře (2. nadzemní podlaží) udržovaného cihlového domu v ulici Březinova na Praze 8 – Karlín. Půdorys bytové jednotky disponuje vstupní chodbou, obývacím pokojem s kuchyňským koutem a jídelním prostorem, hlavní ložnicí se šatnou, druhou ložnicí, kterou lze využít jako pracovnu, koupelnou (vana, sprchový kout, umyvadlo a toaleta) a samostatnou toaletou. Vybavení bytu zahrnuje kuchyňskou linku (varná deska, vestavěná trouba, mikrovlnná trouba a digestoř) a domácí telefon. Velká okna a vysoké stropy dodávají interiéru vzdušnost. Lokalita Praha 8 – Karlín nabízí městské bydlení s obchody, gastronomií a zelení v okolí. Pro každodenní nákupy lze využít supermarket Albert v Křižíkově ulici a místní obchody podél Sokolovské. V Březinově ulici se nachází bistro Proti Proudu, na kávu či snídani lze zajít do kavárny Můj šálek kávy v Křižíkově ulici. V okolí je také základní a mateřská škola na Lyčkově náměstí. Pro procházky, odpočinek i pohyb slouží Kaizlovy sady s dětským hřištěm a venkovními fitness prvky. Dopravní dostupnost zajišťuje tramvajová zastávka Urxova a stanice metra B – Křižíkova. Na další autobusové spoje a metro C lze navázat v přestupním uzlu Florenc. Měsíční nájemné činí 46.000,- Kč/měsíc plus poplatky 5.000,- Kč/měsíc. Požadovaná jistota (kauce) ve výši dvou měsíčních nájmů. Minimální délka podnájmu 1 rok, ubytování formou Airbnb či spolubydlení nelze realizovat. Dle vyhlášky 78/2013 Sb. uvádíme třídu energetické náročnosti budovy D.","detail_done":true,"disp":"3+kk","district":8,"first_seen":"2026-10-27","floor":null,"floors_total":null,"furnished":null,"garage":null,"heating":null,"history":[["2026-10-27",46000]],"id":"realitymix-8729497","images":["https://st.realitymix.cz/i/4334281/8693515/nab_502284295_detail.jpg","https://st.realitymix.cz/i/954440/8708915/nab_500510179_detail.jpg","https://st.realitymix.cz/i/66681962/8734149/nab_502640145_detail.jpg","https://st.realitymix.cz/i/66677944/7514465/nab_501407851_detail.jpg"],"last_seen":"2026-10-27","lat":50.094705555556,"lift":null,"loggia":null,"lon":14.456130555556,"offer":"rent","ownership":"personal","parking":null,"penb":"D","pets":null,"price":46000,"price_czk":46000,"price_m2":597,"private":false,"quarter":"Karlín","quarter_median_m2":569,"source":"realitymix","source_id":"8729497","street":"Březinova","terrace":null,"title":"Pronájem bytu, 3+kk, 77 m²","url":"https://realitymix.cz/detail/praha/prostorny-byt-3-kk-se-satnou-a-vysokymi-stropy-v-atraktivni-lokalite-prahy-8-karlina-8729497.html"},"sreality-1168621644":{"address":"Praha 10, Benice","also_on":[],"area":105,"available_from":null,"balcony":null,"cellar":null,"charges