st vč. MŠ, ZŠ, SŠ, pošty, nákup. střediska Lidl, lékáren, polikliniky, restaurace. Za domem se nachází rozsáhlý Malešický park. Ve vzdálenosti tří minut chůze je zastávka 4 autobusů MHD, odkud odjíždí spoje k metru Želivského, Depo Hostivař a nebo Strašnická. Ihned volný k nastěhování.","detail_done":true,"disp":"1+kk","district":10,"first_seen":"2026-10-27","floor":2,"floors_total":2,"furnished":null,"garage":null,"heating":null,"history":[["2026-10-27",10000]],"id":"realitymix-8716891","images":["https://st.realitymix.cz/i/66670241/6835149/nab_498519225_detail.jpg","https://st.realitymix.cz/i/66674946/7196046/nab_500435173_detail.jpg","https://st.realitymix.cz/i/66670241/7550872/nab_492945897_detail.jpg","https://st.realitymix.cz/i/66677944/7835536/nab_501500263_detail.jpg"],"last_seen":"2026-10-27","lat":null,"lift":null,"loggia":null,"lon":null,"offer":"rent","ownership":"personal","parking":null,"penb":"C","pets":null,"price":10000,"price_czk":10000,"price_m2":625,"private":false,"quarter":"Malešice","quarter_median_m2":429,"source":"realitymix","source_id":"8716891","street":"Káranská","terrace":null,"title":"Pronájem bytu, 1+kk, 16 m²","url":"https://realitymix.cz/detail/praha/pronajem-zarizeneho-pokoje-v-praze-10-malesicich-ulice-karanska-8716891.html"},"sreality-1084624972":{"address":"Terezínská, Praha 9, Letňany","also_on":[],"area":71,"available_from":null,"balcony":null,"cellar":null,"charges":null,"condition":null,"construction":null,"currency":"CZK","deposit":null,"description":null,"detail_done":false,"disp":"2+kk","district":9,"first_seen":"2026-10-27","floor":null,"floors_total":null,"furnished":null,"garage":null,"heating":null,"history":[["2026-10-27",25000]],"id":"sreality-1084624972","images":["https://d18-a.sdn.cz/d_18/c_img_qG_C/kcKfrMAkFDvG5q7SlIGif1T/d552.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_C/kcKfrMAkFDbqUhBx61IGif1x/a5ef.jpeg?fl=res,1024,768,1","https://d18-a.sdn.cz/d_18/c_img_qG_C/nCR9NVflLrfprKziIGif2Q/bbe2.jpeg?f